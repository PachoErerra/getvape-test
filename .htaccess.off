# ТЕСТОВА КОПІЯ getvape — getvape.vapors.app
Options +FollowSymlinks
Options -Indexes

<FilesMatch "(?i)((\.tpl|\.twig|\.ini|\.log|(?<!robots)\.txt|\.sql|\.json))">
 Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

# Картинки, яких немає на тесті, беремо з робочого сайту (щоб не копіювати гігабайти)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^image/(.*)$ https://getvape.com.ua/image/$1 [R=302,L]

RewriteRule ^sitemap.xml$ index.php?route=extension/feed/google_sitemap [L]
RewriteRule ^googlebase.xml$ index.php?route=extension/feed/google_base [L]
RewriteRule ^system/storage/(.*) - [F,L]
RewriteRule ^system/download/(.*) index.php?route=error/not_found [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !.*\.(ico|gif|jpg|jpeg|png|webp|js|css|svg)
RewriteRule ^([^?]*) index.php?_route_=$1 [L,QSA]

Header set X-Robots-Tag "noindex, nofollow"
