{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-report').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-paper-plane"></i> {{ text_type }}</h3>
      </div>
      <div class="panel-body">
        {% if reports_custom %}
        <div style="margin-bottom:15px;">
          <label style="display:block;margin-bottom:8px;"><span class="label" style="background:#2AABEE;">GV</span> {{ text_our_reports }}</label>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            {% for report in reports_custom %}
            <a href="{{ report.href }}" class="btn" style="float:none;flex:1 1 180px;white-space:normal;border:1px solid {% if code == report.code %}#2AABEE{% else %}#ccc{% endif %};background:{% if code == report.code %}#2AABEE{% else %}#fff{% endif %};color:{% if code == report.code %}#fff{% else %}#333{% endif %};box-shadow:none;">{{ report.text }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if reports_other %}
        <div>
          <label for="input-report-other" style="display:block;margin-bottom:8px;">{{ text_other_reports }}</label>
          <select name="report" id="input-report-other" onchange="if (this.value) location = this.value;" class="form-control">
            <option value="">{{ text_choose_other }}</option>
            {% for report in reports_other %}
            <option value="{{ report.href }}"{% if code == report.code %} selected="selected"{% endif %}>{{ report.text }}</option>
            {% endfor %}
          </select>
        </div>
        {% endif %}
      </div>
    </div>
    <div>{{ report }}</div>
  </div>
</div>
{{ footer }}
