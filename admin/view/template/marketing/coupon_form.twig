				response($.map(json, function(item) {
					return {
						label: item['name'],
						value: item['category_id']
					}
				}));
			}
		});
	},
	'select': function(item) {
		$('input[name=\'category_required\']').val('');
		
		$('#coupon-category_required' + item['value']).remove();
		
		$('#coupon-category_required').append('<div id="coupon-category_required' + item['value'] + '"><i class="fa fa-minus-circle"></i> ' + item['label'] + '<input type="hidden" name="coupon_category_required[]" value="' + item['value'] + '" /></div>');
	}	
});

$('#coupon-category_required').delegate('.fa-minus-circle', 'click', function() {
	$(this).parent().remove();
});
