{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if can_modify and not active %}
        <a href="{{ run }}" data-toggle="tooltip" title="{{ button_run }}" class="btn btn-primary"><i class="fa fa-refresh"></i> {{ button_run }}</a>
        {% elseif can_modify and active %}
        <a href="{{ reset }}" data-toggle="tooltip" title="{{ button_reset }}" class="btn btn-warning" onclick="return confirm('{{ text_confirm_reset }}');"><i class="fa fa-unlock"></i> {{ button_reset }}</a>
        {% endif %}
        <a href="{{ refresh }}" data-toggle="tooltip" title="{{ button_refresh }}" class="btn btn-default"><i class="fa fa-repeat"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="row">
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-refresh"></i> {{ text_panel }}</h3>
          </div>
          <div class="panel-body">
            {% if active %}
            <div class="alert alert-info">
              <i class="fa fa-spinner fa-spin"></i>
              {{ text_running_formatted }}
              {% if active.stages_text and active.stages_text != '-' %}
              <br><small>{{ active.stages_text }}</small>
              {% endif %}
            </div>
            <p class="text-muted">{{ text_wait }}</p>
            {% if can_modify %}
            <a href="{{ reset }}" class="btn btn-warning" onclick="return confirm('{{ text_confirm_reset }}');"><i class="fa fa-unlock"></i> {{ button_reset_stuck }}</a>
            {% endif %}
            {% else %}
            <p>{{ text_idle }}</p>
            {% if can_modify %}
            <a href="{{ run }}" class="btn btn-primary"><i class="fa fa-refresh"></i> {{ button_run }}</a>
            {% endif %}
            {% endif %}
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-bar-chart-o"></i> {{ text_chart }}</h3>
          </div>
          <div class="panel-body">
            {% if has_chart %}
            <p class="text-muted">{{ chart_summary }}</p>
            <div id="chart-sync-1c" style="width: 100%; height: 220px;"></div>
            {% else %}
            <p class="text-muted">{{ text_no_jobs }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_history }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-right">{{ column_id }}</td>
                <td>{{ column_status }}</td>
                <td>{{ column_source }}</td>
                <td>{{ column_created }}</td>
                <td class="text-right">{{ column_sec }}</td>
                <td class="text-right">{{ column_upd }}</td>
                <td class="text-right">{{ column_skip }}</td>
                <td class="text-right">{{ column_new }}</td>
                <td class="text-right">{{ column_off }}</td>
                <td>{{ column_stages }}</td>
                <td>{{ column_error }}</td>
              </tr>
            </thead>
            <tbody>
              {% if jobs %}
              {% for job in jobs %}
              <tr>
                <td class="text-right">{{ job.job_id }}</td>
                <td>
                  {% if job.status == 'done' %}
                  <span class="label label-success">{{ job.status_label }}</span>
                  {% elseif job.status == 'error' %}
                  <span class="label label-danger">{{ job.status_label }}</span>
                  {% elseif job.status == 'running' %}
                  <span class="label label-warning">{{ job.status_label }}</span>
                  {% else %}
                  <span class="label label-default">{{ job.status_label }}</span>
                  {% endif %}
                </td>
                <td>{{ job.source_label }}</td>
                <td>{{ job.created_at }}</td>
                <td class="text-right">{% if job.duration_min is not null %}{{ job.duration_min }}{% else %}-{% endif %}</td>
                <td class="text-right">{{ job.updated }}</td>
                <td class="text-right">{{ job.skipped }}</td>
                <td class="text-right">{{ job.created }}</td>
                <td class="text-right">{{ job.disabled }}</td>
                <td><small>{{ job.stages_text }}</small></td>
                <td><small>{{ job.error_message }}</small></td>
              </tr>
              {% endfor %}
              {% else %}
              <tr>
                <td class="text-center" colspan="11">{{ text_no_jobs }}</td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% if has_chart %}
<script type="text/javascript" src="view/javascript/jquery/flot/jquery.flot.js"></script>
<script type="text/javascript" src="view/javascript/jquery/flot/jquery.flot.resize.min.js"></script>
<script type="text/javascript"><!--
(function () {
	var json = {{ chart_json|raw }};

	$.plot('#chart-sync-1c', [{
		label: json.series.label,
		data: json.series.data,
		color: json.series.color,
		lines: { show: true },
		points: { show: true }
	}], {
		shadowSize: 0,
		grid: {
			backgroundColor: '#FFFFFF',
			hoverable: true
		},
		xaxis: {
			show: true,
			ticks: json.xaxis
		},
		yaxis: {
			min: 0,
			tickDecimals: 1
		},
		legend: {
			show: false
		}
	});

	$('#chart-sync-1c').on('plothover', function (event, pos, item) {
		$('.tooltip').remove();

		if (item) {
			var tip = (json.tooltips && json.tooltips[item.datapoint[0]] !== undefined)
				? json.tooltips[item.datapoint[0]]
				: ((item.series.label || '') + ': ' + item.datapoint[1].toFixed(1) + ' хв');

			$('<div id="tooltip" class="tooltip top in"><div class="tooltip-arrow"></div><div class="tooltip-inner">' + tip + '</div></div>').prependTo('body');

			$('#tooltip').css({
				position: 'absolute',
				left: item.pageX - ($('#tooltip').outerWidth() / 2),
				top: item.pageY - $('#tooltip').outerHeight(),
				pointer: 'cursor'
			}).fadeIn(80);

			$('#chart-sync-1c').css('cursor', 'pointer');
		} else {
			$('#chart-sync-1c').css('cursor', 'auto');
		}
	});
})();
//--></script>
{% endif %}
{% if auto_refresh %}
<script type="text/javascript">
setTimeout(function () { location.reload(); }, 10000);
</script>
{% endif %}
{{ footer }}
