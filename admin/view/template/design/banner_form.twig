<style>
.ocf-colorbox {
	width: 256px;
	margin: -10px -15px;
}

.ocf-colorbox a {
	display: block;
	float: left;
	width: 16px;
	height: 16px;
	padding: 0;
	margin: 0;
	position: relative;
	z-index: 1;
}

.ocf-colorbox a:hover {
	z-index: 2;
}

.ocf-colorbox a:after {
	content: "";
	background-color: inherit;
	position: absolute;
	display: none;
	width: 60px;
	height: 60px;
	right: 100%;
	bottom: 100%;
	box-shadow: -2px -1px 20px rgba(0,0,0,0.4);
}

.ocf-colorbox a:hover:after {
	display: block;
}
</style>
