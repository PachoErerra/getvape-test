<style>
    .env-box { margin-bottom: 20px; }
    .env-stats { font-size: 14px; margin-bottom: 15px; padding: 10px 12px; background: #f5f5f5; border-radius: 3px; }
    .env-link-input { width: 360px; max-width: 100%; display: inline-block; vertical-align: middle; margin-right: 6px; }
    .env-qr-thumb { width: 56px; height: 56px; vertical-align: middle; border: 1px solid #ddd; }
    .env-actions { white-space: nowrap; }
    .env-actions .btn { width: 36px; height: 34px; padding: 6px 0; text-align: center; }
    .env-actions form { display: inline; }
</style>

<div class="env-box">
    <div class="env-stats">
        <b>Всього сканів:</b>
        старти {{ totals.starts_total }} (унікальних {{ totals.starts_uniq }})
        &nbsp;|&nbsp;
        відкрито {{ totals.opens_total }} (унікальних {{ totals.opens_uniq }})
        &nbsp;|&nbsp;
        конвертів: {{ envelopes|length }}
    </div>

</div>

<div class="panel panel-default env-box"> 
    <div class="panel-heading clearfix">
        <b>Список конвертів</b>
        <div class="pull-right">
            <button type="button" class="btn btn-primary btn-sm" id="btn-envelope-add">
                <i class="fa fa-plus"></i> Додати конверт
            </button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
            <tr>
                <th style="width:50px;">#</th>
                <th>Назва</th>
                <th>Подарунок</th>
                <th style="width:70px;">Статус</th>
                <th style="width:110px;">Старти</th>
                <th style="width:110px;">Відкрито</th>
                <th style="width:140px;">Додано</th>
                <th style="width:140px;">Змінено</th>
                <th>Посилання / QR</th>
                <th style="width:140px;" class="text-right">Дії</th>
            </tr>
            </thead>
            <tbody>
            {% if envelopes %}
                {% for item in envelopes %}
                    <tr{% if item.history_active %} class="info"{% endif %}>
                        <td>{{ item.envelope_id }}</td>
                        <td><b>{{ item.name }}</b></td>
                        <td>
                            {% if item.image %}
                                <img src="{{ item.thumb }}" alt="" style="width:40px;height:40px;margin-right:6px;vertical-align:middle;">
                            {% endif %}
                            {{ item.gift_name }}
                        </td>
                        <td>
                            {% if item.status %}
                                <span class="label label-success">ON</span>
                            {% else %}
                                <span class="label label-default">OFF</span>
                            {% endif %}
                        </td>
                        <td>{{ item.stats.starts_total }} <small>({{ item.stats.starts_uniq }})</small></td>
                        <td>{{ item.stats.opens_total }} <small>({{ item.stats.opens_uniq }})</small></td>
                        <td>{{ item.date_added }}</td>
                        <td>{{ item.date_modified }}</td>
                        <td>
                            <input type="text" class="form-control input-sm env-link-input" readonly
                                   value="{{ item.link }}" onclick="this.select();">
                            <img src="{{ item.qr }}" alt="QR" class="env-qr-thumb" title="QR 500x500">
                            <a href="{{ item.qr_download }}" class="btn btn-default btn-qr-download"
                               data-toggle="tooltip" title="Скачати QR 500x500">
                                <i class="fa fa-download"></i>
                            </a>
                        </td>
                        <td class="text-right env-actions">
                            <a href="{{ item.history }}" data-toggle="tooltip" title="Історія" class="btn btn-success">
                                <i class="fa fa-list"></i>
                            </a>
                            <button type="button" class="btn btn-primary btn-envelope-edit"
                                    data-toggle="tooltip" title="Змінити"
                                    data-id="{{ item.envelope_id }}">
                                <i class="fa fa-pencil"></i>
                            </button>
                            {% if item.can_delete %}
                                <form action="{{ action }}" method="post"
                                      onsubmit="return confirm('Видалити конверт?');">
                                    <input type="hidden" name="action" value="envelope_delete">
                                    <input type="hidden" name="envelope_id" value="{{ item.envelope_id }}">
                                    <button type="submit" data-toggle="tooltip" title="Видалити" class="btn btn-danger">
                                        <i class="fa fa-trash-o"></i>
                                    </button>
                                </form>
                            {% else %}
                                <button type="button" class="btn btn-danger" disabled
                                        data-toggle="tooltip" title="Є скани - видалення заборонено">
                                    <i class="fa fa-trash-o"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="10">Поки немає конвертів. Натисніть "Додати конверт".</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
</div>

{% if history_envelope %}
<div class="panel panel-primary">
    <div class="panel-heading">
        <b>Історія сканів: #{{ history_envelope.envelope_id }} — {{ history_envelope.name }}</b>
        <span class="pull-right">подарунок: {{ history_envelope.gift_name }}</span>
    </div>
    <div class="panel-body">
        <form action="index.php" method="get" class="form-inline">
            <input type="hidden" name="route" value="common/telegram">
            <input type="hidden" name="user_token" value="{{ user_token }}">
            <input type="hidden" name="active_tab" value="9">
            <input type="hidden" name="history_envelope_id" value="{{ history_envelope_id }}">

            <div class="form-group" style="margin-right:12px;">
                <label>Тип події&nbsp;</label>
                <select name="filter_event_type" class="form-control">
                    <option value="" {% if filter_event_type == '' %}selected{% endif %}>Всі</option>
                    <option value="start" {% if filter_event_type == 'start' %}selected{% endif %}>Перехід</option>
                    <option value="auth" {% if filter_event_type == 'auth' %}selected{% endif %}>Авторизація</option>
                    <option value="open" {% if filter_event_type == 'open' %}selected{% endif %}>Відкриття</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Показати</button>
            <a href="{{ action }}" class="btn btn-default" style="margin-left:8px;">Закрити історію</a>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
            <tr>
                <th>Час</th>
                <th>Тип</th>
                <th>Telegram ID</th>
                <th>Користувач</th>
                <th>Подарунок</th>
            </tr>
            </thead>
            <tbody>
            {% if events %}
                {% for ev in events %}
                    <tr>
                        <td>{{ ev.date_added }}</td>
                        <td>
                            {% if ev.event_type == 'start' %}Перехід
                            {% elseif ev.event_type == 'auth' %}Авторизація
                            {% elseif ev.event_type == 'open' %}Відкриття
                            {% else %}{{ ev.event_type }}{% endif %}
                        </td>
                        <td>{{ ev.chat_id }}</td>
                        <td>
                            {{ ev.first_name }} {{ ev.last_name }}
                            {% if ev.username %}@{{ ev.username }}{% endif %}
                        </td>
                        <td>{{ ev.gift_name ? ev.gift_name : history_envelope.gift_name }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="5">У цього конверта поки немає сканів</td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>
    {% if events_total %}
        <div class="panel-footer clearfix">
            <div class="pull-left">{{ results }}</div>
            <div class="pull-right">{{ pagination }}</div>
        </div>
    {% endif %}
</div>
{% endif %}

<div class="modal fade" id="modal-envelope" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form action="{{ action }}" method="post" class="form-horizontal" id="form-envelope">
                <input type="hidden" name="action" value="envelope_save">
                <input type="hidden" name="envelope_id" id="env-id" value="">
                <input type="hidden" name="sticker_file_id" id="env-sticker" value="">
                <input type="hidden" name="ttl_minutes" id="env-ttl" value="30">

                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title" id="modal-envelope-title">Додати конверт</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group required">
                        <label class="col-sm-3 control-label">Назва в адмінці</label>
                        <div class="col-sm-9">
                            <input type="text" name="name" id="env-name" class="form-control" required
                                   placeholder="Наприклад: Конверт VIP">
                        </div>
                    </div>
                    <div class="form-group required">
                        <label class="col-sm-3 control-label">Подарунок</label>
                        <div class="col-sm-9">
                            <input type="text" name="gift_name" id="env-gift" class="form-control" required
                                   placeholder="Що видають в магазині">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Фото подарунка</label>
                        <div class="col-sm-9">
                            <div style="margin-bottom:8px;">
                                <a href="javascript:void(0);" id="env-thumb-image" class="img-thumbnail" style="display:inline-block;">
                                    <img src="{{ placeholder }}" alt="" data-placeholder="{{ placeholder }}"
                                         style="max-width:100px;max-height:100px;"/>
                                </a>
                            </div>
                            <input type="hidden" name="image" value="" id="env-input-image"/>
                            <button type="button" class="btn btn-primary btn-sm" id="btn-env-image">
                                <i class="fa fa-pencil"></i> Обрати фото
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" id="btn-env-image-clear">
                                <i class="fa fa-trash-o"></i> Очистити
                            </button>
                            <div id="env-image-path" class="text-muted" style="margin-top:6px;font-size:12px;"></div>
                            <p class="help-block">Обрати фото → Зберегти. В боті прийде одним повідомленням: фото + текст.</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Текст до відкриття</label>
                        <div class="col-sm-9">
                            <textarea name="text_before" id="env-before" class="form-control" rows="3"
                                      placeholder="Якщо порожньо - буде стандартний текст"></textarea>
                            <p class="help-block">Стандарт: Дякуємо, що ви з нами! Натисніть кнопку нижче, щоб дізнатися, що всередині.</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Текст після відкриття</label>
                        <div class="col-sm-9">
                            <textarea name="text_after" id="env-after" class="form-control" rows="3"
                                      placeholder="Якщо порожньо - буде стандартний текст"></textarea>
                            <p class="help-block">Стандарт: Ваш подарунок готовий. Отримайте його зараз у магазині у менеджера.</p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Кнопка в боті</label>
                        <div class="col-sm-9">
                            <input type="text" name="button_text" id="env-button" class="form-control"
                                   value="Відкрити конверт">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Активний</label>
                        <div class="col-sm-9">
                            <input type="checkbox" name="status" id="env-status" value="1" checked>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Зберегти
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="application/json" id="envelopes-json">{{ envelopes_json|raw }}</script>
<script>
(function ($) {
    var envelopesMap = {};
    try {
        var list = JSON.parse($('#envelopes-json').text() || '[]');
        for (var i = 0; i < list.length; i++) {
            envelopesMap[String(list[i].envelope_id)] = list[i];
        }
    } catch (e) {}

    function openEnvelopeModal(data) {
        data = data || {};
        var isEdit = !!data.envelope_id;

        $('#modal-envelope-title').text(isEdit ? ('Змінити конверт #' + data.envelope_id) : 'Додати конверт');
        $('#env-id').val(data.envelope_id || '');
        $('#env-name').val(data.name || '');
        $('#env-gift').val(data.gift_name || '');
        $('#env-before').val(data.text_before || (isEdit ? '' : 'Дякуємо, що ви з нами! Натисніть кнопку нижче, щоб дізнатися, що всередині.'));
        $('#env-after').val(data.text_after || (isEdit ? '' : 'Ваш подарунок готовий. Отримайте його зараз у магазині у менеджера.'));
        $('#env-button').val(data.button_text || 'Відкрити конверт');
        $('#env-sticker').val(data.sticker_file_id || '');
        $('#env-ttl').val(data.ttl_minutes || 30);
        $('#env-status').prop('checked', data.status === undefined ? true : Number(data.status) === 1);

        var placeholder = $('#env-thumb-image img').attr('data-placeholder') || '{{ placeholder }}';
        $('#env-input-image').val(data.image || '');
        $('#env-thumb-image img').attr('src', data.thumb || placeholder);
        $('#env-image-path').text(data.image ? ('Файл: ' + data.image) : '');

        $('#modal-envelope').modal('show');
    }

    function openEnvFileManager() {
        $('#modal-image').remove();

        $.ajax({
            url: 'index.php?route=common/filemanager&user_token=' + getURLVar('user_token')
                + '&target=env-input-image&thumb=env-thumb-image',
            dataType: 'html',
            success: function (html) {
                $('body').append('<div id="modal-image" class="modal">' + html + '</div>');

                var $fm = $('#modal-image');
                $fm.modal('show');
                $fm.css('z-index', 2060);
                setTimeout(function () {
                    $('.modal-backdrop').last().css('z-index', 2050);
                }, 10);
            }
        });
    }

    $(document).on('click', '#modal-image a.thumbnail', function () {
        setTimeout(function () {
            var path = $('#env-input-image').val() || '';
            $('#env-image-path').text(path ? ('Файл: ' + path) : 'Файл не вибрано');
        }, 100);
    });

    $(document).on('hide.bs.modal', '#modal-image', function () {
        var path = $('#env-input-image').val() || '';
        $('#env-image-path').text(path ? ('Файл: ' + path) : '');
    });

    $('#btn-env-image').on('click', function () {
        openEnvFileManager();
    });

    $('#btn-env-image-clear').on('click', function () {
        var placeholder = $('#env-thumb-image img').attr('data-placeholder') || '{{ placeholder }}';
        $('#env-input-image').val('');
        $('#env-thumb-image img').attr('src', placeholder);
        $('#env-image-path').text('');
    });

    $('#btn-envelope-add').on('click', function () {
        openEnvelopeModal();
    });

    $(document).on('click', '.btn-envelope-edit', function () {
        var id = String($(this).data('id'));
        openEnvelopeModal(envelopesMap[id] || { envelope_id: id });
    });

    {% if edit_envelope %}
    $(function () {
        openEnvelopeModal(envelopesMap['{{ edit_envelope.envelope_id }}'] || {
            envelope_id: '{{ edit_envelope.envelope_id }}',
            name: {{ edit_envelope.name|json_encode|raw }},
            gift_name: {{ edit_envelope.gift_name|json_encode|raw }},
            image: {{ (edit_envelope.image ?? '')|json_encode|raw }},
            text_before: {{ edit_envelope.text_before|json_encode|raw }},
            text_after: {{ edit_envelope.text_after|json_encode|raw }},
            button_text: {{ edit_envelope.button_text|json_encode|raw }},
            sticker_file_id: {{ edit_envelope.sticker_file_id|json_encode|raw }},
            ttl_minutes: '{{ edit_envelope.ttl_minutes }}',
            status: '{{ edit_envelope.status }}'
        });
    });
    {% endif %}
})(jQuery);
</script>
