<script>
    jQuery(document).ready(function ($) {
        var tabById = {
            'send-msg': 1,
            'downloading-users': 2,
            'sending-messages': 3,
            'order-statuses-messages': 4,
            'logins': 5,
            'send-after-order': 7,
            'api-sends': 8,
            'envelopes': 9
        };
        var idByTab = {
            1: 'send-msg',
            2: 'downloading-users',
            3: 'sending-messages',
            4: 'order-statuses-messages',
            5: 'logins',
            7: 'send-after-order',
            8: 'api-sends',
            9: 'envelopes'
        };

        function setTabInUrl(tabId, tabNum) {
            var url = new URL(window.location.href);
            url.searchParams.set('active_tab', String(tabNum));
            url.hash = tabId;
            history.replaceState(null, '', url.toString());
        }

        function activateTab(tabId) {
            var $link = $('.nav-tabs a[href="#' + tabId + '"]');
            if ($link.length) {
                $link.tab('show');
            }
        }

        var hash = (window.location.hash || '').replace('#', '');
        if (hash && tabById[hash]) {
            activateTab(hash);
            setTabInUrl(hash, tabById[hash]);
        } else {
            var activeTab = parseInt(new URL(window.location.href).searchParams.get('active_tab') || '{{ active_tab }}', 10);
            if (idByTab[activeTab]) {
                activateTab(idByTab[activeTab]);
                setTabInUrl(idByTab[activeTab], activeTab);
            }
        }

        $('.nav-tabs a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var tabId = ($(e.target).attr('href') || '').replace('#', '');
            if (tabById[tabId]) {
                setTabInUrl(tabId, tabById[tabId]);
            }
        });

        var $select = $('.telegram_user');
        var autocompleteUrl = $select.data('autocomplete');
        var presetOptions = [
            {id: 'all', text: 'ALL (только активные)'},
            {id: 'order_for_tree_months_or_more', text: '3 и более месяцев не делал заказ'}
        ];

        $select.select2({
            placeholder: 'Оберіть користувача (ів) *',
            minimumInputLength: 0,
            ajax: {
                url: autocompleteUrl,
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    return {
                        filter_name: params.term || ''
                    };
                },
                processResults: function (data, params) {
                    var term = (params.term || '').toLowerCase();
                    var presets = presetOptions;

                    if (term) {
                        presets = presetOptions.filter(function (item) {
                            return item.text.toLowerCase().indexOf(term) !== -1;
                        });
                    }

                    return {
                        results: presets.concat(data || [])
                    };
                },
                cache: true
            }
        });
    });
</script>