                                <label class="col-sm-2 control-label">Файл</label>
                                <div class="col-sm-10 " style="padding-top: 9px">
                                    {% if telegram_users_date_created %}
                                        Дата генерації файлу : <a
                                            href="{{ action_download_file }}">{{ telegram_users_date_created }}</a>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="btn-group pull-right">
                                        <button type="submit" class="btn btn-primary">Генерувати</button>
                                    </div>
                                </div>
