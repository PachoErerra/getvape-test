{{ header }}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>

<style>
    .select2-selection.select2-selection--single {
        height: 32px;
    }

</style>
{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>Telegram</h1>
            <h3>Всего: {{ count_telegram_users }} | Активных: {{ count_active_telegram_users }}</h3>


            {% if  telegram_success %}
                <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i>
                    {{ telegram_success }}
                    <button type="button" class="close" data-dismiss="alert">×</button>
                </div>
            {% endif %}
            {% if  telegram_error %}
                <div class="alert alert-danger alert-dismissible">
                    {{ telegram_error }}
                    <button type="button" class="close" data-dismiss="alert">×</button>
                </div>
            {% endif %}
        </div>
    </div>
    <div class="container-fluid">
        <div class="panel panel-default">

            <div class="panel-body">
                <ul class="nav nav-tabs">

                    <li class="{% if active_tab == 1 %} active {% endif %}">
                        <a href="#send-msg"
                           data-toggle="tab"
                           aria-expanded="true">Надіслати повідомлення</a>
                    </li>
                    <li class="{% if active_tab == 2 %} active {% endif %}">
                        <a href="#downloading-users"
                           data-toggle="tab"
                           aria-expanded="false">Вивантаження
                            користувачів</a>
                    </li>
                    <li class="{% if active_tab == 3 %} active {% endif %}">
                        <a href="#sending-messages"
                           data-toggle="tab"
                           aria-expanded="false">Розсилка повідомлень (Старі замовлення)</a>
                    </li>
                    <li class="{% if active_tab == 4 %} active {% endif %}">
                        <a href="#order-statuses-messages"
                           data-toggle="tab"
                           aria-expanded="false">Повідомлення при зміні статуса замовлення </a>
                    </li>
                    <li class="{% if active_tab == 5 %} active {% endif %}">
                        <a href="#logins"
                           data-toggle="tab"
                           aria-expanded="true">Статистика входів</a>
                    </li>
                    <li class="{% if active_tab == 8 %} active {% endif %}">
                        <a href="#api-sends"
                           data-toggle="tab"
                           aria-expanded="false">API відправки (1С / бонуси)</a>
                    </li>

                    <li class="{% if active_tab == 7 %} active {% endif %}">
                        <a href="#send-after-order"
                           data-toggle="tab"
                           aria-expanded="false">Повідомлення при відсутності покупки 3(6) місяці.</a>
                    </li>
                    <li class="{% if active_tab == 9 %} active {% endif %}">
                        <a href="#envelopes"
                           data-toggle="tab"
                           aria-expanded="false">Конверти</a>
                    </li>
                </ul>
 
                <div class="tab-content">
                    <div class="tab-pane {% if active_tab == 1 %} active {% endif %}" id="send-msg">
                        <form action="{{ action }}"
                              method="post" enctype="multipart/form-data" id="form-recurring" class="form-horizontal">
                            <input type="hidden" name="action" value="send_msg">
                            <div class="form-group required">
                                <label class="col-sm-2 control-label">Користувач</label>
                                <div class="col-sm-10">
                                    <div class="input-group">
                                        <span class="input-group-addon"><i class="fa fa-user fa-fw"></i></span>
                                        <select name="telegram_user[]" multiple="multiple"
                                                style="width: 100%;"
                                                class="telegram_user form-control"
                                                data-autocomplete="{{ autocomplete }}">
                                        </select>
                                    </div>
                                    {% if error_telegram_user %}
                                        <div class="text-danger">Обов'язкове поле</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-price">Повідомлення</label>
                                <div class="col-sm-10">
                              <textarea class="form-control" name="text" id="text" cols="117"
                                        placeholder="Текст повідомлення*" rows="15"></textarea>
                                    {% if error_text %}
                                        <div class="text-danger">Обов'язкове поле</div>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-price">Посилання</label>
                                <div class="col-sm-5">
                                    <div class="input-group" style="width: 100%; margin-bottom: 10px">
                                        <input type="text" id="link" class="form-control" value=""
                                               placeholder="Текст посилання" name="links[0][name]">
                                    </div>
                                    <div class="input-group" style="width: 100%; margin-bottom: 10px">
                                        <input type="text" id="link" value="" class="form-control"
                                               placeholder="Посилання" name="links[0][link]">
                                    </div>

                                </div>
                                <div class="col-sm-5">
                                    <div class="input-group" style="width: 100%; margin-bottom: 10px">
                                        <input type="text" id="link" value="" class="form-control"
                                               placeholder="Текст посилання" name="links[1][name]">
                                    </div>
                                    <div class="input-group" style="width: 100%; margin-bottom: 10px">
                                        <input type="text" id="link" value="" class="form-control"
                                               placeholder="Посилання" name="links[1][link]">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-price">Файли (Фотографія має бути
                                    розміром
                                    не
                                    більше 10 МБ)</label>
                                <div class="col-sm-5">
                                    <div class="col-sm-10"><a href="" id="thumb-image" data-toggle="image"
                                                              class="img-thumbnail"><img src="{{ thumb }}" alt=""
                                                                                         title=""
                                                                                         data-placeholder="{{ placeholder }}"/>Обрати
                                            зображення</a>
                                        <input type="hidden" name="image" value="{{ image }}" id="input-image"/>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-12">
                                    <div class="btn-group pull-right">
                                        <button type="submit" class="btn btn-primary">Надіслати</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="tab-pane {% if active_tab == 2 %} active {% endif %}" id="downloading-users">
                        <form action="{{ action }}"
