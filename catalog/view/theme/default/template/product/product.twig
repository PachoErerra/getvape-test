<script type="text/javascript"><!--
  $('.js-notify-action').on('click', function () {

      {% if logged %}
    $.ajax({
      url: 'index.php?route=product/product/notify&product_id={{ product_id }}',
      type: 'post',
      dataType: 'json',
      data: $("#form-review").serialize(),
      beforeSend: function () {
        $('#button-review').button('loading');
      },
      complete: function () {
        $('#button-review').button('reset');
      },
      success: function (json) {
        $('.alert-dismissible').remove();


        if (json['success']) {
          $(".modal__close").trigger('click');

          $('.toast .p').text('Ви успішно відправили заявку. Ми повідомимо, коли товар знову буде доступний для відправки.');
          $(".js-open-toast").trigger('click');

        }
      }
    });
      {% else %}
    $('.regsms_open').trigger('click');
      {% endif %}

  });

  $('#morereviews').on('click', function () {
    var lastProduct = $('.card__tabs-reviews-items');
    var nextPage = $('.card__tabs-reviews ul.pagination li.active').next().find('a:first-child');
    $.ajax({
      url: $(nextPage).attr('href'),
      success: function (data) {
        $('.pagination').parent().remove();
        var products = data;
        lastProduct.append(products);
        $('.pagination').html($(data).find('.pagination > *'));
        nextPage = $('ul.pagination li.active').next().find('a:first-child');
        if (nextPage.length == 0) {
          $('body #morereviews').remove();
        } else {
          $('#endless .fa-refresh').removeClass('fa-spin');
        }
      }
    });
    return false;
  });
  $('#button-review').on('click', function () {
    $.ajax({
      url: 'index.php?route=product/product/write&product_id={{ product_id }}',
      type: 'post',
      dataType: 'json',
      data: $("#form-review").serialize(),
      beforeSend: function () {
        $('#button-review').button('loading');
        console.log($("#form-review").serialize());
      },
      complete: function () {
        $('#button-review').button('reset');
      },
      success: function (json) {
        $('.alert-dismissible').remove();

        if (json['error']) {
          $('#button-review').parent().before('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
        }

        if (json['success']) {
          $(".modal__close").trigger('click');
          $(".js-open-toast").trigger('click');

          $('input[name=\'name\']').val('');
          $('textarea[name=\'text\']').val('');
          $('input[name=\'rating\']:checked').prop('checked', false);
        }
      }
    });
  });


  $('body').delegate('.is-sticky-block .card__tabs-button', 'click', function () {
    let top = $('.card__tabs').offset().top;
    $('body,html').animate({scrollTop: top - 90}, 300);
  });


  // Получаем элемент, который должен стать sticky
  let stickyBlock = $('.card__tabs'),
    stickyBlockChild = $('.card__tabs-buttons-wrapper');

  if (stickyBlock.length) {

    // Получаем позицию, на которой должен начать работать sticky
    let stickyOffset = stickyBlock.offset().top - $('.header').outerHeight() + 10;

    // Функция для обработки события scroll
    $(window).scroll(function () {
      let scrollTopTab = $(window).scrollTop();

      if (scrollTopTab >= stickyOffset) {
        stickyBlockChild.addClass('is-sticky-block');
      } else {
        stickyBlockChild.removeClass('is-sticky-block');
      }
    });

  }


  //--></script>
{{ footer }} 
