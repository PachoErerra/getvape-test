{{ header }}

<style>
  .product-video-block {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    padding-top: 25px;
    height: 0;
  }

  .product-video-block .note-video-clip {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .tab-description img {
    display: block;
    margin: 0 auto;
  }
</style>
<div id="product-product" class="container">
    <div class="card__content">
        <ul class="breadcrumbs">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <li class="active">
                        <span>{{ breadcrumb.text }}</span>
                        <meta content="{{ loop.index }}">
                    </li>
                {% else %}
                    <li class="">
                        <a href="{{ breadcrumb.href }}">
                            <span>{{ breadcrumb.text }}</span>
                        </a>
                        <meta content="{{ loop.index }}">
                    </li>
                {% endif %}
            {% endfor %}
        </ul>


        <div class="card__mob">
            <h1 class="h1 color-black">{{ heading_title }}</h1>
            <div class="card__rside-string">
                <div class="p color-grey">{{ text_model }} {{ model }}</div>
                <div class="card__rside-rating js-scroll-reviews">
                    {% if review_status %}
                        <div class="card__rside-stars">
                            {% for i in 1..5 %}
                                {% if rating < i %}
                                    <img src="image/catalog/site/icon-star-white.svg" alt="rating">
                                {% else %}
                                    <img src="image/catalog/site/icon-star-blue.svg" alt="rating">
                                {% endif %}
                            {% endfor %}
                        </div>
                        <a role="button" data-href="#tabs" class="card__open-reviews"
                           data-open="tab-reviews">{{ reviews }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="card__holder">
            <div class="card__lside">
                <div class="card__lside-info">
                    {% if special %}
                        <div class="item bg-pink">{{ economy }}</div>{% endif %}

                    {% if quantity <= 0 and warehouses %}
                        <div class="item bg-light-pink">
                            {{ text_zamovlyay_u_menedzhera }}
                        </div>
                    {% endif %}
                </div>
                <div class="card__slider swiper">
                    <div class="swiper-wrapper">
                        {% if thumb %}
                            <div class="swiper-slide">
                                <div class="card__slide">
                                    <img src="{{ thumb }}" loading="lazy"
                                         title="{{ text_foto }}{{ breadcrumbs[breadcrumbs|length - 2].text }}, {{ heading_title }}"
                                         alt="{{ heading_title }} - {{ breadcrumbs[breadcrumbs|length - 2].text }}"/>
                                </div>
                            </div>
                        {% endif %}
                        {% if images %}
                            {% for image in images %}
                                <div class="swiper-slide">
                                    <div class="card__slide">
                                        <img src="{{ image.thumb }}" loading="lazy"
                                             title="{{ text_foto }}{{ breadcrumbs[breadcrumbs|length - 2].text }}, {{ heading_title }}"
                                             alt="{{ heading_title }} - {{ breadcrumbs[breadcrumbs|length - 2].text }}"/>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <div class="swiper-button-next icon-arrow-next"></div>
                    <div class="swiper-button-prev icon-arrow-prev"></div>
                    <div class="swiper-pagination"></div>
                </div>
            </div>
            <div id="product" class="card__rside">
                <div class="card__rside-desk">
                    <div class="h2 color-black">{{ heading_title }}</div>
                    <div class="card__rside-string">
                        <div class="p color-grey">{{ text_model }} {{ model }}</div>
                        <div class="card__rside-rating js-scroll-reviews">
                            {% if review_status %}
                                <div class="card__rside-stars">
                                    {% for i in 1..5 %}
                                        {% if rating < i %}
                                            <img src="image/catalog/site/icon-star-white.svg" alt="">
                                        {% else %}
                                            <img src="image/catalog/site/icon-star-blue.svg" alt="">
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <a role="button" data-href="#tabs" class="card__open-reviews"
                                   data-open="tab-reviews">{{ reviews }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <ul class="card__rside-list">
                    {% if manufacturer %}
                        <li>
                            <div class="p md font-medium">{{ text_manufacturer }} <a href="{{ manufacturers }}"
                                                                                     class="a-link">{{ manufacturer }}</a>
                            </div>
                        </li>
                    {% endif %}
                    {% if attribute_groups %}
                        {% for attribute_group in attribute_groups %}
                            {% if attribute_group.attribute_group_id != 3 %}
                                {% for key, attribute in attribute_group.attribute %}
                                    {% if key <= 3 %}
                                        {% if attribute.name != 'Виробник' %}
                                            <li>
                                                <div class="p md font-medium">{{ attribute.name }}:
                                                    <span>{{ attribute.text }}</span>
                                                </div>
                                            </li>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                        <li class="js-scroll-characteristic">
                            <a role="button" data-href="#tabs" class="card__open-characteristic"
                               data-open="tab-characteristic">
                                {{ text_kharakterystyky }}
                                <svg width="6" height="10" viewBox="0 0 6 10" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1 9L5 5L1 1" stroke="#2AA5C6"/>
                                </svg>
                            </a>
                        </li>
                    {% endif %}

                </ul>

                {% if variants %}
                    <div class="card__rside-fields">
                        {% for group in variants %}
                            <div class="card__rside-field card__rside-field--w100">
                                <label class="card__rside-field-label">{{ group.key }}:</label>
                                <div class="custom-dropdown-img">
                                    {% for product in group.items %}
                                        {% if product.selected %}
                                            <div class="dropdown-header">
                                                <img src="{{ product.thumb }}" alt="{{ product.alt }}" title="{{ product.title }}">
                                                <span>{{ product.name }}</span>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                    <ul class="dropdown-list">
                                        {% for product in group.items %}
                                            <li data-value="{{ product.href }}"
                                                onclick="location = $(this).attr('data-value');"{% if product.selected %} class="selected"{% endif %}>
                                                <img src="{{ product.thumb }}" alt="{{ product.alt }}" title="{{ product.title }}">
                                                <span>{{ product.name }}{% if not product.in_stock %} ({{ text_variant_out_of_stock }}){% endif %}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if options %}
                    {% for option in options %}
                        {% if option.type == 'select' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label"
                                       for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                                <select name="option[{{ option.product_option_id }}]"
                                        id="input-option{{ option.product_option_id }}" class="form-control">
                                    <option value="">{{ text_select }}</option>
                                    {% for option_value in option.product_option_value %}
                                        <option value="{{ option_value.product_option_value_id }}">{{ option_value.name }}
                                            {% if option_value.price %}
                                                ({{ option_value.price_prefix }}{{ option_value.price }})
                                            {% endif %} </option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                        {% if option.type == 'radio' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label">{{ option.name }}</label>
                                <div id="input-option{{ option.product_option_id }}"> {% for option_value in option.product_option_value %}
                                        <div class="radio">
                                            <label>
                                                <input type="radio" name="option[{{ option.product_option_id }}]"
                                                       value="{{ option_value.product_option_value_id }}"/>
                                                {% if option_value.image %} <img src="{{ option_value.image }}"
                                                                                 alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}"
                                                                                 class="img-thumbnail"/> {% endif %}
                                                {{ option_value.name }}
                                                {% if option_value.price %}
                                                    ({{ option_value.price_prefix }}{{ option_value.price }})
                                                {% endif %} </label>
                                        </div>
                                    {% endfor %} </div>
                            </div>
                        {% endif %}

                        {% if option.type == 'text' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label"
                                       for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                                <input type="text" name="option[{{ option.product_option_id }}]"
                                       value="{{ option.value }}" placeholder="{{ option.name }}"
                                       id="input-option{{ option.product_option_id }}" class="form-control"/>
                            </div>
                        {% endif %}
                        {% if option.type == 'textarea' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label"
                                       for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                                <textarea name="option[{{ option.product_option_id }}]" rows="5"
                                          placeholder="{{ option.name }}"
                                          id="input-option{{ option.product_option_id }}"
                                          class="form-control">{{ option.value }}</textarea>
                            </div>
                        {% endif %}
                        {% if option.type == 'file' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label">{{ option.name }}</label>
                                <button type="button" id="button-upload{{ option.product_option_id }}"
                                        data-loading-text="{{ text_loading }}" class="btn btn-default btn-block"><i
                                            class="fa fa-upload"></i> {{ button_upload }}</button>
                                <input type="hidden" name="option[{{ option.product_option_id }}]" value=""
                                       id="input-option{{ option.product_option_id }}"/>
                            </div>
                        {% endif %}
                        {% if option.type == 'date' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label"
                                       for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                                <div class="input-group date">
                                    <input type="text" name="option[{{ option.product_option_id }}]"
                                           value="{{ option.value }}" data-date-format="YYYY-MM-DD"
                                           id="input-option{{ option.product_option_id }}" class="form-control"/>
                                    <span class="input-group-btn">
                <button class="btn btn-default" type="button"><i class="fa fa-calendar"></i></button>
                </span></div>
                            </div>
                        {% endif %}
                        {% if option.type == 'datetime' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label"
                                       for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                                <div class="input-group datetime">
                                    <input type="text" name="option[{{ option.product_option_id }}]"
                                           value="{{ option.value }}" data-date-format="YYYY-MM-DD HH:mm"
                                           id="input-option{{ option.product_option_id }}" class="form-control"/>
                                    <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span></div>
                            </div>
                        {% endif %}
                        {% if option.type == 'time' %}
                            <div class="form-group{% if option.required %} required {% endif %}">
                                <label class="control-label"
                                       for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                                <div class="input-group time">
                                    <input type="text" name="option[{{ option.product_option_id }}]"
                                           value="{{ option.value }}" data-date-format="HH:mm"
                                           id="input-option{{ option.product_option_id }}" class="form-control"/>
                                    <span class="input-group-btn">
                <button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button>
                </span></div>
                            </div>
                        {% endif %}
                    {% endfor %}

                {% endif %}

                {% if options %}
                    <div class="set">
                        <div class="set__title">{{ text_bustery }}</div>

                        <div class="set__items d-grid">
                            {% for option in options %}
                                {% if option.type == 'checkbox' %}
                                    {% for option_value in option.product_option_value %}
                                        <label for="input-option-{{ option.product_option_id }}"
                                               class="set__item-inner set__item-inner--inversion">
                                            <input type="checkbox"
                                                   id="input-option-{{ option.product_option_id }}"
                                                   class="js-required-set"
                                                   name="option[{{ option.product_option_id }}][]"
                                                   value="{{ option_value.product_option_value_id }}"/>

                                            <div class="set__item d-flex align-items-center">
                                                <div class="set__item-img">
                                                    {% if option_value.image %} <img src="{{ option_value.image }}"
                                                                                     alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}"
                                                                                     class="img-thumbnail"/> {% endif %}
                                                </div>
                                                <div class="set__item-content">
                                                    <div class="set__item-name">{{ option.name }} <span>*</span></div>
                                                    <div class="set__item-bottom d-flex align-items-center justify-content-between">
                                                        {% if option_value.price %}
                                                            <div class="set__item-price">
                                                                <!--{{ option_value.price_prefix }}-->{{ option_value.price }}
                                                            </div>
                                                        {% endif %}

                                                        <div class="set__item-cb">
                                                            <div class="set__item-cb-label">
                                                                <span class="set__item-cb-toggle"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </label>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}

                            {% if buster_products %}
                                {% for option_value in buster_products %}
                                    <label for="input-option-{{ option_value.product_option_value_id }}"
                                           class="set__item-inner">
                                        <input type="checkbox"
                                               id="input-option-{{ option_value.product_option_value_id }}"
                                               class=""
                                               name="product_ids[]"
                                               value="{{ option_value.product_option_value_id }}"/>

                                        <div class="set__item d-flex align-items-center">
                                            <div class="set__item-img">
                                                {% if option_value.image %} <img src="{{ option_value.image }}"
                                                                                 alt="{{ option_value.name }} {% if option_value.price %} {{ option_value.price_prefix }} {{ option_value.price }} {% endif %}"
                                                                                 class="img-thumbnail"/> {% endif %}
                                            </div>
                                            <div class="set__item-content">
                                                <div class="set__item-name">{{ option_value.name }}</div>
                                                <div class="set__item-bottom d-flex align-items-center justify-content-between">
                                                    {% if option_value.price %}
                                                        <div class="set__item-price">
                                                            <!--{{ option_value.price_prefix }}-->{{ option_value.price }}
                                                        </div>
                                                    {% endif %}

                                                    <div class="set__item-cb">
                                                        <div class="set__item-cb-label">
                                                            <span class="set__item-cb-toggle"></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </label>
                                {% endfor %}
                            {% endif %}

                        </div>
                        <div class="set__info set__info--pink">{{ text_obov_yazkovi_komponenty_neobkhidni_dlya }}</div>
                        <div class="set__info">{{ text_pakuvannya_mozhe_vidriznyatysya_vid_toho }}</div>
                    </div>
                {% endif %}


                <div class="set">
                    <div class="set__info">{{ text_cini }}</div>
                </div>

                <!--
              {% for key,item in products_related %}
			  
				<div>{{ key }}<br>
			  {% for product in item %}
			  
              {% if product.href == breadcrumbs|last.href %}

              <a href="{{ product.href }}"><b>{{ product.name }}</b></a>

              {% else %}

               <a href="{{ product.href }}">{{ product.name }}</a>

              {% endif %}
              {% endfor %}
			  </div><br>
			  {% endfor %}			
-->
                <div class="card__rside-box">
                    <input type="hidden" name="quantity" value="{{ minimum }}" size="2" id="input-quantity"
                           class="form-control"/>
                    <input type="hidden" name="product_id" value="{{ product_id }}"/>
                    <div class="card__rside-box-top">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="card__rside-box-prices">
                                {% if not special %}
                                    <strong>{{ price }}</strong>
                                {% else %}
                                    <b>{{ price }}</b>
                                    <strong>{{ special }}</strong>
                                {% endif %}


                            </div>


                            {% if quantity > 0 %}
                                <button type="button"
                                        class="button-light-blue button-light-blue--with-icon js-add-to-cart"><span
                                            class="desk-text">{{ button_cart }}</span>
                                    <span class="mob-text">{{ button_cart_mob }}</span> <img
                                            src="image/catalog/site/icon-cart-white.svg" alt="icon-cart"></button>
                            {% elseif quantity <= 0 and warehouses %}
                                <a href="https://t.me/vapors_vape_shop" target="_blank" rel="nofollow"
                                   class="button-light-blue button-light-blue--border-radius-min center bg-pink">{{ text_zamovyty_u_menedzhera }}</a>
                            {% else %}
                                <button type="button"
                                        class="button-light-blue button-light-blue--border-radius-min center bg-blue js-notify-action">
                                    {{ text_povidomyty_koly_z_yavytsya }}
                                </button>
                            {% endif %}
                            <button type="button" aria-label="favorites" class="card__rside-box-favorites"
                                    onclick="wishlist.add('{{ product_id }}');">
                                <svg width="30" height="30" viewBox="0 0 30 30" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path
                                            d="M20.9754 4.5C17.4169 4.5 15.1594 8.43572 14.6251 8.43572C14.158 8.43572 11.9928 4.5 8.27462 4.5C4.65809 4.5 1.70512 7.45913 1.51181 11.0422C1.40281 13.0663 2.06039 14.6065 2.98734 16.0019C4.83879 18.7896 12.9346 25.5 14.637 25.5C16.3761 25.5 24.3989 18.8137 26.2626 16.002C27.1916 14.6004 27.8472 13.0664 27.7381 11.0423C27.5449 7.45913 24.5921 4.5 20.9754 4.5Z"
                                            fill="#9AC9D6"/>
                                </svg>
                            </button>

                            <button type="button" class="card__rside-box-comparison"
                                    onclick="compare.add('{{ product_id }}');">
                                <svg width="30" height="30" viewBox="0 0 20 20" fill="none"
                                     xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                                    <path
                                          d="M11.9995 3L15.9995 3C16.5527 3 16.9995 3.4469 16.9995 4C16.9995 4.5531 16.5527 5 15.9995 5L12.4497 5C12.2871 5.80627 11.7339 6.47192 10.9995 6.79065L10.9995 16L15.9995 16C16.5527 16 16.9995 16.4469 16.9995 17C16.9995 17.5531 16.5527 18 15.9995 18L9.99951 18L3.99951 18C3.44678 18 2.99951 17.5531 2.99951 17C2.99951 16.4469 3.44678 16 3.99951 16L8.99951 16L8.99951 6.79065C8.26514 6.46875 7.7124 5.8031 7.5498 5L3.99951 5C3.44678 5 2.99951 4.5531 2.99951 4C2.99951 3.4469 3.44678 3 3.99951 3L7.99951 3C8.45605 2.3938 9.18115 2 9.99951 2C10.8184 2 11.5435 2.3938 11.9995 3ZM13.7373 12L18.2622 12L15.9995 8.11877L13.7373 12ZM15.9995 15C14.0342 15 12.3999 13.9375 12.062 12.5344C11.981 12.1907 12.0933 11.8375 12.2715 11.5312L15.2466 6.43127C15.4028 6.16248 15.6904 6 15.9995 6C16.3091 6 16.5967 6.16565 16.7529 6.43127L19.728 11.5312C19.9058 11.8375 20.0186 12.1907 19.937 12.5344C19.5996 13.9375 17.9653 15 15.9995 15ZM3.9624 8.11877L1.69971 12L6.22803 12L3.9624 8.11877ZM0.027832 12.5344C-0.0532227 12.1907 0.059082 11.8375 0.237305 11.5312L3.2124 6.43127C3.36865 6.16248 3.65576 6 3.96533 6C4.2749 6 4.56201 6.16565 4.71826 6.43127L7.69336 11.5312C7.87158 11.8375 7.98389 12.1907 7.90283 12.5344C7.56201 13.9375 5.92773 15 3.9624 15C1.99658 15 0.365234 13.9375 0.027832 12.5344Z"
                                          fill="#9AC9D6"></path>
                                </svg>
                            </button>
                        </div>

                        {% if discounts %}
                            <div class="card__discount d-flex d-md-none">
                                <div class="card__discount-title">{{ text_opt }}</div>
                                <ul class="card__discount-list d-flex">
                                    {% for discount in discounts %}
                                        <li>{{ text_discount_before }} {{ discount.quantity }} {{ text_discount }}
                                            - {{ discount.price }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                    </div>

                    {% if discounts %}
                        <div class="card__rside-box-bottom align-items-start">
                            <div class="card__discount d-none d-md-flex">
                                <div class="card__discount-title">{{ text_opt }}</div>
                                <ul class="card__discount-list">
                                    {% for discount in discounts %}
                                        <li>{{ text_discount_before }} {{ discount.quantity }} {{ text_discount }}
                                            - {{ discount.price }}</li>
                                    {% endfor %}
                                </ul>
                            </div>

                            <div class="card__rside-box-bottom-right d-flex flex-md-column">
                                <div class="card__status d-flex align-items-center">
                                    <div class="card__status-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24">
                                            <use href="#icon-{{ stock_label }}"></use>
                                        </svg>
                                    </div>

                                    <div class="card__status-label">{{ stock }}</div>
                                </div>

                                {% if reward %}
                                    <div class="card__rside-box-bottom-string">
                                        <div class="card__rside-question">
                                            <div class="card__rside-question-icon"></div>
                                            <div class="card__rside-question-drop">
                                                {{ text_za_kozhnu_pokupku_v_nashomu }}
                                            </div>
                                        </div>
                                        <div class="p color-grey">{{ text_reward }} {{ reward }} ₴</div>
                                    </div>
                                {% endif %}

                            </div>
                        </div>
                    {% else %}
                        <div class="card__rside-box-bottom">
                            {% if reward %}
                                <div class="card__rside-box-bottom-string">
                                    <div class="card__rside-question">
                                        <div class="card__rside-question-icon"></div>
                                        <div class="card__rside-question-drop">
                                            {{ text_za_kozhnu_pokupku_v_nashomu }}
                                        </div>
                                    </div>
                                    <div class="p color-grey">{{ text_reward }} {{ reward }} ₴</div>
                                </div>
                            {% endif %}
                            <div class="card__status d-flex align-items-center">
                                <div class="card__status-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24">
                                        <use href="#icon-{{ stock_label }}"></use>
                                    </svg>
                                </div>

                                <div class="card__status-label">{{ stock }}</div>
                            </div>
                        </div>
                    {% endif %}
                </div>
                <div class="card__rside-inners">
                    {% if quantity > 0 %}
                        <div class="card__rside-inner">
                            <strong>{{ text_dostavka }}</strong>
                            <ul class="ul">
                                <li>
                                    <div class="p">
                                        {{ text_kur_yerom_do_2_hodyn }}
                                        <span>{{ text_po_m_lviv }}</span>
                                    </div>
                                </li>
                                <li>
                                    <div class="p">
                                        {{ text_nova_poshta }}
