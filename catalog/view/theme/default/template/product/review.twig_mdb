{% if reviews %}
{% for review in reviews %}
  <div class="card__tabs-review">
    <div class="card__tabs-review-body">
      <div class="card__tabs-review-name">{{ review.author|split(' ')|first }}</div>
      <div class="card__tabs-review-info">
        <div class="card__tabs-review-stars">
		  {% for i in 1..5 %}
		  {% if review.rating < i %}
		  <img src="/image/catalog/site/icon-star-grey.svg" alt="stars">
		  {% else %}
		  <img src="/image/catalog/site/icon-star-blue.svg" alt="stars">
		  {% endif %}
		  {% endfor %}
        </div>
        <div class="p md">{{ review.date_added }}</div>
      </div>
      <div class="p md">{{ review.text }}</div>
    </div>
	{% if review.answer %}
    <div class="card__tabs-review-answer">
      <div class="card__tabs-review-info">
        <div class="card__tabs-review-name">Vapors team</div>
        <div class="p md">{{ review.date_added }}</div>
      </div>
      <div class="p md">{{ review.answer }}</div>
    </div>
	{% endif %}
  </div>

{% endfor %}
<div hidden>{{ pagination }}</div>
{% if pagination %}
<button type="button" id="morereviews" class="button-light-blue button-light-blue--border-radius-min" >Більше відгуків</button>
{% endif %}
{% else %}
<p>{{ text_no_reviews }}</p>
{% endif %}