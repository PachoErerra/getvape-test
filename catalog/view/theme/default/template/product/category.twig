{{ header }}
<div id="product-category" class="container">
    <div class="home__content">

        <div class="breadcrumbs">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <span>{{ breadcrumb.text }}</span>
                {% else %}
                    <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                {% endif %}
            {% endfor %}
        </div>

        <h1 class="h2 color-black">{{ heading_title }}</h1>


        <div class="home__string home__string-filters">
            <div class="home__filter" data-ocf="mobile" aria-label="{{ button_ocfilter_mobile }}">{{ text_filtr }}</div>

            <div class="home__string-flex">
                <p class="p font-medium">{{ text_sort }}</p>
                <div class="custom-dropdown">
                    {% for sorts in sorts %}
                        {% if sorts.value == '%s-%s'|format(sort, order) %}
                            <div class="dropdown-header">
                                <div class="selected-option">{{ sorts.text }}</div>
                                <div class="dropdown-arrow"></div>
                            </div>
                        {% endif %}
                    {% endfor %}
                    <ul class="dropdown-options">
                        {% for sorts in sorts %}
                            {% if sorts.value == '%s-%s'|format(sort, order) %}
                                <li class="selected" data-value="{{ sorts.href }}"
                                    onclick="location = $(this).attr('data-value');">{{ sorts.text }}</li>
                            {% else %}
                                <li class="selected" data-value="{{ sorts.href }}"
                                    onclick="location = $(this).attr('data-value');">{{ sorts.text }}</li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
        {% if showpink %}
            <div class="showpink">{{ text_showpink }}</div>
        {% endif %}
        <div class="home__holder m-top">
            <div class="home__sidebar sidebar-filter">
                <!--div class="home__sidebar-close"></div-->
                {{ column_left }}
            </div>
            <div id="content" class="home__body">

                {% if products %}
                    {% if products|length > 15 %}
                        {% for productss in products|batch((products|length / 2)|round(1, 'ceil')) %}
                            <div class="home__inner {% if loop.first %}m-top-0{% endif %}">
                                <div class="home__products">
                                    <div class="products {% if loop.last %}loadmore{% endif %} four-items-in-line">
                                        {% for product in productss %}
                                            <div class="product{% if product.quantity <= 0 %} outofstock{% endif %}">
                                                <div class="product__wrapper">
                                                    <div class="product__top">
                                                        <div class="product__labels-wrapper">
                                                            {% if product.isnew %}
                                                                <div class="product__info bg-light-blue">
                                                                    {{ text_novynka }}
                                                                </div>
                                                            {% endif %}
                                                            {% if product.special %}<div class="product__info bg-pink">{{ product.economy }}</div>{% endif %}
                                                            {% if product.quantity_shop <= 0 and product.quantity >  0 %}
                                                                <!--div class="product__info bg-pink-300">
                                                                    {{ text_zamovlyay_u_menedzhera }}
                                                                </div-->
                                                            {% endif %}
                                                        </div>

                                                        <div class="product__sub-action">
                                                            <button type="button" aria-label="wishlist"
                                                                    class="product__sub-action-btn product__favorites"
                                                                    onclick="wishlist.add('{{ product.product_id }}');">
                                                                <svg width="20" height="20" viewBox="0 0 20 20">
                                                                    <use href="#icon-fav"></use>
                                                                </svg>
                                                            </button>

                                                            <button type="button"
                                                                    class="product__sub-action-btn product__comparison"
                                                                    aria-label="compare"
                                                                    onclick="compare.add('{{ product.product_id }}');">
                                                                <svg width="20" height="20" viewBox="0 0 20 20">
                                                                    <use href="#icon-compare"></use>
                                                                </svg>
                                                            </button>

                                                        </div>
                                                    </div>
                                                    <a href="{{ product.href }}" class="product__image"
                                                       aria-label="{{ product.name }}">
                                                        <img src="{{ product.thumb }}"
                                                             data-old-src="{{ product.thumb }}"
                                                             loading="lazy"
                                                             alt="{{ product.name }} - {{ heading_title }}"
                                                             title="{{ heading_title }}, {{ product.name }}">
                                                    </a>
                                                    <a href="{{ product.href }}"
                                                       class="product__name">{{ product.name }}</a>

                                                    <div class="product__rating d-flex align-items-center">
                                                        <div class="rating__stars">
                                                            <div class="rating__stars-current"
                                                                 style="width:{{ product.rating * 20 }}%;"></div>
                                                        </div>

                                                        <div class="rating__stars-count">{{ product.reviews }}</div>
                                                    </div>

                                                    {% if product.manufacturer and 0 %}
                                                        <div class="product__manufacturer">
                                                            {{ text_vyrobnyk }} {{ product.manufacturer }}</div>
                                                    {% endif %}
                                                    <div class="product__bottom d-flex align-items-center justify-content-between">
                                                        <div class="product__prices">
                                                            <div class="product__prices-cashback">
                                                                {{ text_keshbek }} {{ product.reward }}₴
                                                            </div>
                                                            {% if not product.special %}
                                                                <strong>{{ product.price|replace({' ₴': ' <small>₴</small>'}) }} </strong>
                                                            {% else %}
                                                                <span>{{ product.price }}</span>
                                                                <strong>{{ product.special|replace({' ₴': ' <small>₴</small>'}) }}</strong>
                                                            {% endif %}
                                                            {% if product.tax %}
                                                                <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
                                                            {% endif %}

                                                        </div>
                                                        <button type="button"
                                                                class="product__add-cart btn btn-primary"
                                                                aria-label="{{ text_u_koshyk }}"
                                                                onclick="cart.add('{{ product.product_id }}');">
                                                            <svg width="20" height="20" viewBox="0 0 20 20">
                                                                <use href="#icon-cart"></use>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                    {% if product.products_related %}
                                                        <div class="product__inner">
                                                            {% for key,item in product.products_related %}
                                                                <div class="product__inner-title">{{ key }}:</div>
                                                                <ul class="product__inner-items">
                                                                    {% for product1 in item %}
                                                                        <li class="product__inner-item">
                                                                            <a href="{{ product1.href }}"
                                                                               data-img-lg="{{ product1.bigthumb }}">
                                                                                <img src="{{ product1.thumb }}" alt="{{ product1.name }}" loading="lazy">
                                                                                <span class="product__inner-item-drop">{{ product1.name }}</span>
                                                                            </a>
                                                                        </li>
                                                                    {% endfor %}
                                                                </ul>
                                                            {% endfor %}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                                {% if loop.last %}
                                    <div class="pagination-wrapper">
                                        {{ pagination }}
                                        <div class="col-sm-6 text-right" hidden>{{ results }}</div>
                                    </div>


                                {% endif %}
                            </div>
                            {% if loop.first %}

                                {{ content_top }}

                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <div class="home__inner m-top-0">
                            <div class="home__products">
                                <div class="products four-items-in-line">
                                    {% for product in products %}
                                        <div class="product{% if product.quantity <= 0 %} outofstock{% endif %}">
                                            <div class="product__wrapper">
                                                <div class="product__top">
                                                    <div class="product__labels-wrapper">
                                                        {% if product.isnew %}
                                                            <div class="product__info bg-light-blue">{{ text_novynka }}
                                                            </div>{% endif %}
                                                        {% if product.special %}
                                                            <div class="product__info bg-pink">{{ product.economy }}</div>{% endif %}
                                                        {% if product.quantity_shop <= 0 and product.quantity >  0 %}
                                                            <!--div class="product__info bg-pink-300 order-manager">
                                                                {{ text_zamovlyay_u_menedzhera }}
                                                            </div-->
                                                        {% endif %}
                                                    </div>

                                                    <div class="product__sub-action">
                                                        <a role="button" aria-label="wishlist"
                                                           class="product__sub-action-btn product__favorites"
                                                           onclick="wishlist.add('{{ product.product_id }}');">
                                                            <svg width="20" height="20" viewBox="0 0 20 20">
                                                                <use href="#icon-fav"></use>
                                                            </svg>
                                                        </a>

                                                        <button type="button" aria-label="compare"
                                                                class="product__sub-action-btn product__comparison"
                                                                onclick="compare.add('{{ product.product_id }}');">
                                                            <svg width="20" height="20" viewBox="0 0 20 20">
                                                                <use href="#icon-compare"></use>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                                <a href="{{ product.href }}" class="product__image"
                                                   aria-label="{{ product.name }}">
                                                    <img src="{{ product.thumb }}" data-old-src="{{ product.thumb }}"
                                                         loading="lazy"
                                                         alt="{{ product.name }} - {{ heading_title }}"
                                                         title="{{ heading_title }}, {{ product.name }}">
                                                </a>
                                                <a href="{{ product.href }}"
                                                   class="product__name">{{ product.name }}</a>

                                                <div class="product__rating d-flex align-items-center">
                                                    <div class="rating__stars">
                                                        <div class="rating__stars-current"
                                                             style="width:{{ product.rating * 20 }}%;"></div>
                                                    </div>

                                                    <div class="rating__stars-count">{{ product.reviews }}</div>
                                                </div>

                                                <div class="product__bottom d-flex align-items-center justify-content-between">
                                                    <div class="product__prices">
                                                        <div class="product__prices-cashback">
                                                            {{ text_keshbek }} {{ product.reward }}₴
                                                        </div>
                                                        {% if not product.special %}
                                                            <strong>{{ product.price|replace({' ₴': ' <small>₴</small>'}) }}</strong>
                                                        {% else %}
                                                            <span>{{ product.price }}</span>
                                                            <strong>{{ product.special|replace({' ₴': ' <small>₴</small>'}) }}</strong>
                                                        {% endif %}
                                                        {% if product.tax %}
                                                            <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
                                                        {% endif %}

                                                    </div>
                                                    <button type="button" class="product__add-cart btn btn-primary"
                                                            aria-label="{{ text_u_koshyk }}"
                                                            onclick="cart.add('{{ product.product_id }}');">
                                                        <svg width="20" height="20" viewBox="0 0 20 20">
                                                            <use href="#icon-cart"></use>
                                                        </svg>
                                                    </button>
                                                </div>
                                                {% if product.products_related %}
                                                    <div class="product__inner">
                                                        {% for key,item in product.products_related %}
                                                            <div class="product__inner-title">{{ key }}:</div>
                                                            <ul class="product__inner-items">
                                                                {% for product1 in item %}
                                                                    <li class="product__inner-item">
                                                                        <a href="{{ product1.href }}"
                                                                           data-img-lg="{{ product1.bigthumb }}">
                                                                            <img src="{{ product1.thumb }}" loading="lazy" alt="{{ product1.name }}">
                                                                            <span class="product__inner-item-drop">{{ product1.name }}</span>
                                                                        </a>
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="pagination-wrapper">
                                {{ pagination }}
                                <div class="col-sm-6 text-right" hidden>{{ results }}</div>
                            </div>
                        </div>
                        {{ content_top }}
                    {% endif %}
                {% endif %}




                {% if not products %}
                    <div class="profile__inners" style="margin-top: 0;padding-left: 0;">
                        <div class="profile__faq">
                            <p>{{ text_empty }}</p>

                            <a href="{{ continue }}"
                               class="button-light-blue"
                               style="width: 200px;margin-top: 15px;">{{ button_continue }}</a>
                        </div>
                    </div>
                {% endif %}


                {% if modules %}
                    {% for module in modules %}
                        <div class="home__inner">
                            <div class="h3 m-bottom-40">{{ module.title }}</div>
                            <div class="home__products">
                                <div class="products four-items-in-line">
                                    {% for product in module.products %}
                                        <div class="product">
                                            <div class="product__wrapper">
                                                <div class="product__top">
                                                    <div>
                                                        {% if product.isnew %}
                                                            <div class="product__info bg-light-blue">{{ text_novynka }}
                                                            </div>{% endif %}
                                                        {% if product.special %}
                                                            <div class="product__info bg-pink">{{ product.economy }}</div>{% endif %}
                                                    </div>

                                                    <div class="product__sub-action">
                                                        <button type="button" aria-label="wishlist"
                                                                class="product__sub-action-btn product__favorites"
                                                                onclick="wishlist.add('{{ product.product_id }}');">
                                                            <svg width="20" height="20" viewBox="0 0 20 20">
                                                                <use href="#icon-fav"></use>
                                                            </svg>
                                                        </button>

                                                        <button type="button" aria-label="compare"
                                                                class="product__sub-action-btn product__comparison"
                                                                onclick="compare.add('{{ product.product_id }}');">
                                                            <svg width="20" height="20" viewBox="0 0 20 20">
                                                                <use href="#icon-compare"></use>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                                <a href="{{ product.href }}" class="product__image"
                                                   aria-label="{{ product.name }}">
                                                    <img src="{{ product.thumb }}" data-old-src="{{ product.thumb }}"
                                                         loading="lazy"
                                                         alt="{{ product.name }}" title="{{ product.name }}">
                                                </a>
                                                <a href="{{ product.href }}"
                                                   class="product__name">{{ product.name }}</a>

                                                <div class="product__rating d-flex align-items-center">
                                                    <div class="rating__stars">
                                                        <div class="rating__stars-current"
                                                             style="width:{{ product.rating * 20 }}%;"></div>
                                                    </div>

                                                    <div class="rating__stars-count">{{ product.reviews }}</div>
                                                </div>

                                                <div class="product__bottom d-flex align-items-center justify-content-between">
                                                    <div class="product__prices">
                                                        <div class="product__prices-cashback">
                                                            {{ text_keshbek }} {{ product.reward }}₴
                                                        </div>
                                                        {% if not product.special %}
                                                            <strong>{{ product.price|replace({' ₴': ' <small>₴</small>'}) }}</strong>
                                                        {% else %}
                                                            <span>{{ product.price }}</span>
                                                            <strong>{{ product.special|replace({' ₴': ' <small>₴</small>'}) }}
                                                            </strong>
                                                        {% endif %}
                                                        {% if product.tax %}
                                                            <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
                                                        {% endif %}
                                                    </div>
                                                    <button type="button" class="product__add-cart btn btn-primary"
                                                            aria-label="{{ text_u_koshyk }}"
                                                            onclick="cart.add('{{ product.product_id }}');">
                                                        <svg width="20" height="20" viewBox="0 0 20 20">
                                                            <use href="#icon-cart"></use>
                                                        </svg>
                                                    </button>
                                                </div>
                                                {% if product.products_related %}
                                                    <div class="product__inner">
                                                        {% for key,item in product.products_related %}
                                                            <div class="product__inner-title">{{ key }}:</div>
                                                            <ul class="product__inner-items">
                                                                {% for product1 in item %}
                                                                    <li class="product__inner-item">
                                                                        <a href="{{ product1.href }}"
                                                                           data-img-lg="{{ product1.bigthumb }}">
                                                                            <img src="{{ product1.thumb }}" alt="{{ product1.name }}" loading="lazy">
                                                                            <span class="product__inner-item-drop">{{ product1.name }}</span>
                                                                        </a>
                                                                    </li>
                                                                {% endfor %}
                                                            </ul>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
                {% if is_first_page and description %}
                    <div class="home__inner text-content">
                        {{ description }}
                    </div>
                {% endif %}
                {{ content_bottom }}</div>

            {{ column_right }}</div>

    </div>
</div>
{{ footer }} 
