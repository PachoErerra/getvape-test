{{ header }}
<div id="product-manufacturer" class="container brands">

    <ul class="breadcrumbs">
            {% for breadcrumb in breadcrumbs %}
                {% if loop.last %}
                    <span>{{ breadcrumb.text }}</span>
                {% else %}
                    <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                {% endif %}
            {% endfor %}
    </ul>

    <div class="brands__container">

        <h1 class="h2 color-black">{{ heading_title }}</h1>

        {{ content_top }}

        {% if categories %}
            <div class="brands__letters d-flex align-items-center flex-wrap">
                <div class="brands__letters-title">{{ text_index }}</div>
                <div class="brands__letters-items d-flex align-items-center flex-wrap">
                    {% for category in categories %}
                        <button type="button" class="brands__letters-item" onclick="scrollToLetter('{{ category.name }}')">{{ category.name }}</button>
                    {% endfor %}
                </div>
            </div>

            {% for category in categories %}
                <h2 id="{{ category.name }}" class="brands__title">{{ category.name }}</h2>
                {% if category.manufacturer %}
                    <div class="d-grid brands__items">
                        {% for manufacturers in category.manufacturer|batch(4) %}
                            {% for manufacturer in manufacturers %}
                                <a class="brands__item d-block" href="{{ manufacturer.href }}">
                                    <img src="{{ manufacturer.thumb }}" alt="{{ manufacturer.name }}"
                                         class="brands__item-img"
                                         loading="lazy">
                                    <span class="brands__item-name">{{ manufacturer.name }}</span>
                                </a>
                            {% endfor %}
                        {% endfor %}
                    </div>
                {% endif %}
            {% endfor %}
        {% else %}
            <p>{{ text_empty }}</p>
            <div class="buttons clearfix">
                <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
                </div>
            </div>
        {% endif %}
        {{ content_bottom }}
    </div>

</div>

<script>
  function scrollToLetter(id) {
    const element = document.getElementById(id);
    const header = document.querySelector('.header');
    const headerHeight = header ? header.offsetHeight : 0;

    if (element) {
      const elementPosition = element.getBoundingClientRect().top + window.scrollY;
      const offsetPosition = elementPosition - headerHeight - 30;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    } else {
      console.error(`Element with ID "${id}" not found.`);
    }
  }

</script>
{{ footer }}