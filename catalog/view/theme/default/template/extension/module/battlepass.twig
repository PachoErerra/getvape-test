<script src="https://cdn.jsdelivr.net/npm/@tsparticles/confetti@3.0.3/tsparticles.confetti.bundle.min.js" data-cfasync="false"></script>

<script>
  const duration = 2.5 * 1000,
    defaults = {startVelocity: 25, spread: 250, ticks: 50, zIndex: 100};

  function randomInRange(min, max) {
    return Math.random() * (max - min) + min;
  }

  function setConfetti() {
    const animationEnd = Date.now() + duration;
    const interval = setInterval(function () {
      const timeLeft = animationEnd - Date.now();

      if (timeLeft <= 0) {
        return clearInterval(interval);
      }

      const particleCount = 20 * (timeLeft / duration);

      confetti(
        Object.assign({}, defaults, {
          particleCount,
          origin: {x: randomInRange(0.1, 0.3), y: Math.random() - 0.2},
        })
      );
      confetti(
        Object.assign({}, defaults, {
          particleCount,
          origin: {x: randomInRange(0.7, 0.9), y: Math.random() - 0.2},
        })
      );
    }, 300);
  }

  $(document).on('click', '.js-btn-claim', function (e) {
    e.preventDefault();
      {% if customer_isLogged %}
    let $btn = $(this),
      level = $btn.data('level'),
      $card = $btn.closest('.battle-pass-card');

    $.ajax({
      url: 'index.php?route=extension/module/battlepass/claim',
      type: 'post',
      data: {level: level},
      dataType: 'json',
      beforeSend: function () {
        $btn.prop('disabled', true).css('opacity', '0');
      },
      success: function (json) {
        if (json['error']) {
          alert(json['error']);
          $btn.prop('disabled', false).css('opacity', '1');
          return;
        }

        if (json['success']) {

          $card.removeClass('battle-pass-card--available battle-pass-card--locked battle-pass-card--waiting').addClass('battle-pass-card--received');

          $card.find('.js-battle-pass-arrow').closest('.battle-pass-card').removeClass('battle-pass-card--active');

          $('.modal--battle-pass').hide();
          if (typeof window.syncBodyModalLock === 'function') {
            window.syncBodyModalLock();
          } else {
            $('body').removeClass('is-open-modal');
          }

          $('.toast .p').html(json['message']);
          $('.toast').addClass('is-show');

          setConfetti();

          setTimeout(function () {
            $('.toast').removeClass('is-show');

            if (json['redirect']) {
              location.href = json['redirect'];
            } else {
              location.reload();
            }
          }, 6000);
        }
      },
      error: function () {
        $btn.prop('disabled', false).css('opacity', '1');
      }
    });
      {% else %}
    showLoginModal();
      {% endif %}
  });

  $('.js-battle-pass__poster-hide').click(function () {
    if ($('body').attr('data-age-gate') === '1') {
      return false;
    }
    setCookie('battle_pass_hidden', '1', 1, 'days');
    $('.battle-pass__poster').fadeOut(200);
  });

  $(document).on('click', '.js-btn-claimlottery', function (e) {
    e.preventDefault();
      {% if customer_isLogged %}
    let $btn = $(this);

    if ($btn.data('claiming')) {
      return;
    }

    $btn.data('claiming', 1);

    $.ajax({
      url: 'index.php?route=extension/module/battlepass/claimlottery',
      type: 'post',
      dataType: 'json',
      beforeSend: function () {
        $btn.prop('disabled', true).css('opacity', '0');
      },
      success: function (json) {
        if (json['error']) {
          alert(json['error']);
          $btn.prop('disabled', false).css('opacity', '1').data('claiming', 0);
          return;
        }

        if (json['success']) {

          $('.modal--battle-pass').hide();
          if (typeof window.syncBodyModalLock === 'function') {
            window.syncBodyModalLock();
          } else {
            $('body').removeClass('is-open-modal');
          }

          $('.toast .p').html(json['message']);
          $('.toast').addClass('is-show');

          setConfetti();

          setTimeout(function () {
            $('.toast').removeClass('is-show');

            if (json['redirect']) {
              location.href = json['redirect'];
            } else {
              location.reload();
            }
          }, 6000);
        } else {
          $btn.prop('disabled', false).css('opacity', '1').data('claiming', 0);
        }
      },
      error: function () {
        $btn.prop('disabled', false).css('opacity', '1').data('claiming', 0);
      }
    });
      {% else %}
    showLoginModal();
      {% endif %}
  });
</script>

