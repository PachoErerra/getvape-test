                            <div class="battle-pass__cards swiper-wrapper">
                                {% for reward in rewards %}

                                    <div class="battle-pass-card swiper-slide
                                        {{ reward.status == 'claimed' ? 'battle-pass-card--received' }}
                                        {{ reward.status == 'available' ? 'battle-pass-card--available' }}
                                        {{ reward.status == 'locked' ? 'battle-pass-card--locked' }}
                                        {{ reward.status == 'waiting' ? 'battle-pass-card--waiting' }}
{% if reward.is_active_arrow %} battle-pass-card--active{% endif %}
"
                                         data-level="{{ reward.level }}">

