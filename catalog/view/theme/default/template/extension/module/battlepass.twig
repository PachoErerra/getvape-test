<div class="modal modal--battle-pass" data-current-level="{{ carousel_start_level }}"
     data-bp-auto-show="{{ bp_show ? '1' : '0' }}">
    <div class="modal__overlay"></div>
    <div class="modal-dialog modal-dialog-centered modal-dialog-bp">
        <div class="modal__container battle-pass">
            <button type="button" class="modal__hide js-modal-close d-flex align-items-center justify-content-center"
                    aria-label="{{ text_zakryty }}">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <use href="#icon-cross"></use>
                </svg>
            </button>

            <div class="battle-pass__top d-flex flex-column flex-md-row-reverse align-items-md-start">
                <div class="battle-pass__main">
                    <div class="battle-pass__head d-flex align-items-center">
                        <div class="battle-pass__head-left">
                            <div class="battle-pass__title">
                                <img src="/catalog/view/theme/default/image/battle-pass/bp-title-text.png"
                                     alt="Battle Pass">
                            </div>

                            {# Прогресс-бар #}
                            <div class="battle-pass__progress d-flex flex-column">
                                {% if 0 %}
                                    <div class="battle-pass__progress-done d-flex align-items-center">
                                        <svg class="sprite-icon">
                                            <use href="/catalog/view/theme/default/image/sprites/sprites-battle-pass.svg?v=2.1.6#icon-battle-pass-check-small"></use>
                                        </svg>

                                        {% if progression_type == 'amount' %}
                                            <div class="battle-pass__progress-num js-battle-pass-progress"
                                                 style="font-size: 16px;">
                                                {{ text_suma_zamovlen }} {{ total_amount|number_format(0, '', ' ') }} {{ text_hrn }}

                                                {% if current_level >= rewards|length %}
                                                    <div class="battle-pass__progress-num-next"
                                                         style="font-size: 14px; color: #4cae4c;">
                                                        {{ text_usi_rivni_vidkryto }}
                                                    </div>
                                                {% else %}
                                                    {% if current_level != 0 %}
                                                        <div class="battle-pass__progress-num-next"
                                                             style="font-size: 14px; opacity: 0.7;">
                                                            / {{ next_level_amount|number_format(0, '', ' ') }} {{ text_hrn_do_rivnya }} {{ current_level + 1 }}
                                                            )
                                                        </div>
                                                    {% endif %}
                                                {% endif %}
                                            </div>
                                        {% else %}

                                            <div class="battle-pass__progress-num js-battle-pass-progress">
                                                {{ current_level }}<span
                                                        class="battle-pass__progress-num-next">/{{ rewards|length }} </span>
                                            </div>
                                        {% endif %}
                                    </div>

                                    <div class="battle-pass__progress-line">

                                        {% if progression_type == 'amount' %}
                                            <div class="battle-pass__progress-fill js-battle-pass-progress-bar"
                                                 style="width: {{ percent_to_next|default(0) }}%;"></div>
                                        {% else %}
                                            <div class="battle-pass__progress-fill js-battle-pass-progress-bar"
                                                 style="width: {{ (current_level / rewards|length * 100) }}%;"></div>
                                        {% endif %}
                                    </div>
                                {% endif %}

                                {% if progression_type == 'orders' and waiting_message %}
                                    <div class="battle-pass__waiting-text">
                                        {{ waiting_message }}

                                        <a href="{{ rules_link }}" target="_blank"
                                           class="battle-pass__waiting-rules">{{ text_rules }}</a>
                                    </div>
                                {% elseif progression_type == 'amount' %}
                                    <div class="battle-pass__waiting-text">

                                        {# ПРІОРИТЕТ 1: Є що забрати (кнопка світиться) #}
                                        {% if has_unclaimed %}
                                            {{ text_nahoroda_dostupna_zaberit_sviy_pryz }}

                                        {% elseif next_level_amount > 0 %}
                                            {{ text_shchob_vidkryty_nastupnyy_podarunok }} <a
                                                href="/specials/">{{ text_zroby }}</a> {{ text_pokupku_shche_na }}
                                            <b>{{ (next_level_amount - total_amount)|number_format(0, '', ' ') }}
                                                <small>{{ text_hrn }}</small></b>

                                        {% else %}
                                            {{ text_usi_rivni_vidkryto_1 }}
                                        {% endif %}

                                        <a href="{{ rules_link }}" target="_blank"
                                           class="battle-pass__waiting-rules">{{ text_rules }}</a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="battle-pass__head-gift is-{% if can_play %}ready{% else %}timer{% endif %}"
                             data-gift-state="{% if can_play %}ready{% else %}timer{% endif %}"
                             data-gift-expires-at="{{ tomorrow }}">
                            <img class="battle-pass__head-gift-box"
                                 src="/catalog/view/theme/default/image/battle-pass/bp-gift-box-.png"
                                 alt="Подарункова скриня">

                            <div class="battle-pass__head-gift-label">
                                <div class="battle-pass__head-gift-pill battle-pass__head-gift-timer js-battle-pass-gift-tip-trigger"
                                     aria-live="polite"
                                     tabindex="0"
                                     aria-describedby="battle-pass-gift-tooltip">
                                    <img class="battle-pass__head-gift-pill-bg"
                                         src="/catalog/view/theme/default/image/battle-pass/bp-gift-label.png"
                                         alt=""
                                         aria-hidden="true">
                                    <span class="battle-pass__head-gift-timer-value battle-pass__head-gift-pill-front"></span>
                                </div>

                                <button type="button"
                                        class="battle-pass__head-gift-pill battle-pass__head-gift-action js-battle-pass-gift-tip-trigger {% if customer_isLogged and can_play %} js-open-daily-reward {% endif %}"{% if not customer_isLogged %} onclick="showLoginModal();"{% elseif not can_play %} disabled{% endif %}
                                        aria-label="Забрати щоденну нагороду"
                                        aria-describedby="battle-pass-gift-tooltip"
                                        data-daily-reward-title="Твоя щоденна нагорода"
                                        data-daily-reward-image="/catalog/view/theme/default/image/battle-pass/daily-{% if prize.type == 'ultra' %}ultra-pink{% else %}bonus{% endif %}.png"
                                        data-daily-reward-image-alt="{% if prize.type == 'ultra' %}{{ text_ultra }}{% else %}{{ text_bonuses }}{% endif %}"
                                        data-daily-reward-amount="{{ prize.amount }}"
                                        data-daily-reward-unit="{{ text_prize }}"
                                        data-daily-reward-label="{% if prize.type == 'ultra' %}{{ text_ultra }}{% else %}{{ text_bonuses }}{% endif %}"
                                        data-daily-reward-button-text="Забрати">

                                    <img class="battle-pass__head-gift-pill-bg"
                                         src="/catalog/view/theme/default/image/battle-pass/bp-gift-label.png"
                                         alt=""
                                         aria-hidden="true">

                                    <span class="battle-pass__head-gift-action-inner battle-pass__head-gift-pill-front">
                                        <span class="battle-pass__head-gift-pill-badge" aria-hidden="true">1</span>
                                        <span class="battle-pass__head-gift-pill-text">
                                            Таємна
                                            нагорода
                                        </span>
                                    </span>
                                </button>

                                <div id="battle-pass-gift-tooltip"
                                     class="battle-pass__head-gift-tooltip"
                                     role="tooltip">
                                    Забери свою щоденну нагороду
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="battle-pass__stage d-flex align-items-center">
                        <div class="battle-pass__progress-bar">
                            <div class="battle-pass__progress-line">
                                {% if progression_type == 'amount' %}
                                    <div class="battle-pass__progress-fill"
                                         style="--progress: {{ percent_to_next|default(0) }}%;"></div>
                                {% else %}
                                    <div class="battle-pass__progress-fill"
                                         style="--progress: {{ (current_level / rewards|length * 100) }}%;"></div>
                                {% endif %}
                            </div>

                            <div class="battle-pass__progress-levels">
                                {% for reward in rewards %}
                                    {% set reward_level = reward.level + 0 %}
                                    <div class="battle-pass__progress-item" data-level="{{ reward_level }}">
                                        <div class="battle-pass__progress-star">
                                            <img src="/catalog/view/theme/default/image/battle-pass/star.svg"
                                                 alt="Battle Pass">
                                            <span>{{ reward_level }}</span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

