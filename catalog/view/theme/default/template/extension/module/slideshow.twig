<style>
.vt-b13{display:grid;grid-template-columns:2fr 1fr;gap:16px;height:440px;margin:4px 0 0}
.vt-b13__main{position:relative;min-width:0;border-radius:24px;overflow:hidden;background:#1a0d1f}
.vt-b13__col{display:grid;grid-template-rows:1fr 1fr;gap:16px;min-height:0}
.vp{position:relative;display:block;overflow:hidden;border-radius:24px;isolation:isolate;background:#1a0d1f}
/* фон — та сама картинка, збільшена й розмита: заповнює боки */
.vp::before{content:"";position:absolute;inset:-30px;z-index:-1;background:var(--img) center/cover no-repeat;filter:blur(28px) saturate(1.3) brightness(.75);transform:scale(1.1)}
.vp img{position:relative;display:block;height:100%;width:auto;margin:0 auto;object-fit:contain;transition:transform .6s cubic-bezier(.2,.8,.2,1);box-shadow:0 0 50px rgba(0,0,0,.35)}
.vp:hover img{transform:scale(1.03)}
.vt-b13 .vp-big{position:absolute;inset:0;border-radius:0;opacity:0;visibility:hidden;transition:opacity .7s,visibility .7s}
.vt-b13 .vp-big.on{opacity:1;visibility:visible}
.vt-b13 .vp-sm{min-height:0}
.vt-b13__nav{position:absolute;left:16px;bottom:16px;display:flex;align-items:center;gap:8px;z-index:5;padding:6px 8px;border-radius:999px;background:rgba(0,0,0,.35);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.vt-b13__dots{display:flex;gap:6px;margin:0 6px}.vt-b13__dots i{width:8px;height:8px;border-radius:8px;background:rgba(255,255,255,.45);transition:width .3s,background .3s;cursor:pointer}.vt-b13__dots i.on{width:24px;background:#fff}
.vt-b13__nav button{width:30px;height:30px;border-radius:50%;border:0;background:rgba(255,255,255,.15);color:#fff;font-size:16px;line-height:1;cursor:pointer;transition:background .2s}
.vt-b13__nav button:hover{background:#ff3ea5}
.vt-b13__nav .p{order:-1}
@media (max-width:900px){.vt-b13{grid-template-columns:1fr;height:auto}.vt-b13__main{height:420px}.vt-b13__col{grid-template-rows:none;grid-template-columns:1fr 1fr}.vt-b13 .vp-sm{height:240px}}
@media (max-width:640px){.vt-b13__nav{left:50%;bottom:auto;top:12px;transform:translateX(-50%)}.vt-b13__main{height:min(150vw,560px)}.vt-b13 .vp-sm{height:200px}.vt-b13__nav button{display:none}}
</style>
<script>
(function(){
  var w=document.querySelector('.vt-b13');if(!w)return;
  var sl=[].slice.call(w.querySelectorAll('.vp-big')),d=w.querySelector('.vt-b13__dots'),k=0,hov=false;
  sl.forEach(function(_,q){var i=document.createElement('i');i.onclick=function(){go(q)};d.appendChild(i)});
  function go(q){k=(q+sl.length)%sl.length;sl.forEach(function(s,j){s.classList.toggle('on',j===k)});[].forEach.call(d.children,function(x,j){x.classList.toggle('on',j===k)})}
  w.querySelector('.n').onclick=function(){go(k+1)};w.querySelector('.p').onclick=function(){go(k-1)};
  var m=w.querySelector('.vt-b13__main');m.onmouseenter=function(){hov=true};m.onmouseleave=function(){hov=false};
  var sx=null;m.addEventListener('touchstart',function(e){sx=e.touches[0].clientX},{passive:true});
  m.addEventListener('touchend',function(e){if(sx===null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)go(k+(dx<0?1:-1));sx=null});
  go(0);
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)setInterval(function(){if(!hov&&document.visibilityState==='visible')go(k+1)},5000);
})();
</script>
