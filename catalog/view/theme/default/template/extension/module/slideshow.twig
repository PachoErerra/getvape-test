<style>
/* 10–13 — складені банери (текст кодом + картинка) */
.vb{position:relative;display:flex;overflow:hidden;isolation:isolate;border-radius:26px;text-decoration:none;color:#fff;background:var(--g)}
.vb::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(60% 90% at 85% 60%,rgba(255,90,190,.45),transparent 65%)}
.vb::after{content:"";position:absolute;inset:0;z-index:-1;opacity:.18;background-image:radial-gradient(rgba(255,255,255,.6) 1px,transparent 1.3px);background-size:20px 20px;-webkit-mask-image:linear-gradient(90deg,#000,transparent 60%);mask-image:linear-gradient(90deg,#000,transparent 60%)}
.vb-txt{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:34px 36px;flex:1;justify-content:center}
.vb-chip{padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase}
.vb-t{font-size:40px;font-weight:800;line-height:1.02;letter-spacing:-.5px}
.vb-price{font-size:30px;font-weight:800;color:#ffd1ec;text-shadow:0 0 22px rgba(255,62,165,.8)}
.vb-s{max-width:400px;font-size:15px;line-height:1.5;color:rgba(255,255,255,.78)}
.vb-cta{margin-top:6px;display:inline-flex;gap:8px;align-items:center;padding:12px 22px;border-radius:999px;background:#fff;color:#17151c;font-weight:700;font-size:14px;transition:background .25s,color .25s}
.vb-cta em{font-style:normal;transition:transform .25s}
.vb:hover .vb-cta{background:#ff3ea5;color:#fff}.vb:hover .vb-cta em{transform:translateX(4px)}
.vb-pic{position:relative;flex:0 0 auto;align-self:center;height:88%;aspect-ratio:5/9;margin-right:42px;border-radius:20px;overflow:hidden;transform:rotate(5deg);box-shadow:0 30px 50px -18px rgba(0,0,0,.75),0 0 0 1px rgba(255,255,255,.18);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.vb:hover .vb-pic{transform:rotate(0) scale(1.04)}
.vs{position:relative}.vs-track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}.vs-track::-webkit-scrollbar{display:none}
.vs-track>*{scroll-snap-align:start;flex-shrink:0}
.vs-nav{display:flex;align-items:center;justify-content:space-between;margin-top:14px}
.vs-dots{display:flex;gap:6px}.vs-dots i{width:8px;height:8px;border-radius:8px;background:#d8d3de;transition:width .3s,background .3s;cursor:pointer}.vs-dots i.on{width:26px;background:#ff3ea5}
.vs-btns{display:flex;gap:8px}.vs-btns button{width:42px;height:42px;border-radius:50%;border:0;background:#e9e6ee;cursor:pointer;font-size:18px;transition:background .2s,color .2s}.vs-btns button:hover{background:#ff3ea5;color:#fff}

.vt-b13{display:grid;grid-template-columns:2fr 1fr;gap:18px;height:440px;margin:4px 0 0}
.vt-b13__main{position:relative;min-width:0;border-radius:26px;overflow:hidden}
.vt-b13__slides{position:relative;height:100%}
.vt-b13 .v13-big{position:absolute;inset:0;height:100%;opacity:0;visibility:hidden;transition:opacity .7s,visibility .7s}
.vt-b13 .v13-big.on{opacity:1;visibility:visible}
.vt-b13 .v13-big .vb-txt{padding-bottom:70px}
.vt-b13 .v13-big .vb-pic{transform:rotate(5deg) translateY(16px);transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.vt-b13 .v13-big.on .vb-pic{transform:rotate(5deg)}
.vt-b13 .v13-big:hover .vb-pic{transform:rotate(0) scale(1.04)}
.vt-b13__nav{position:absolute;left:36px;bottom:24px;display:flex;align-items:center;gap:8px;z-index:5}
.vt-b13__dots{display:flex;gap:6px;margin-right:10px}.vt-b13__dots i{width:8px;height:8px;border-radius:8px;background:rgba(255,255,255,.35);transition:width .3s,background .3s;cursor:pointer}.vt-b13__dots i.on{width:26px;background:#fff}
.vt-b13__nav button{width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;font-size:18px;line-height:1;cursor:pointer;transition:background .2s,border-color .2s}
.vt-b13__nav button:hover{background:#ff3ea5;border-color:#ff3ea5}
.vt-b13__col{display:grid;grid-template-rows:1fr 1fr;gap:18px;min-height:0}
.vt-b13 .v13-sm{min-height:0}.vt-b13 .v13-sm .vb-txt{padding:20px 22px;gap:8px}.vt-b13 .v13-sm .vb-t{font-size:21px}.vt-b13 .v13-sm .vb-price{font-size:19px}
.vt-b13 .v13-sm .vb-cta{padding:9px 15px;font-size:12.5px;margin:0}.vt-b13 .v13-sm .vb-chip{font-size:10.5px;padding:4px 9px}
.vt-b13 .v13-sm .vb-pic{margin-right:16px;height:84%;transform:rotate(6deg)}
@media (max-width:1100px){.vt-b13 .v13-big .vb-t{font-size:32px}.vt-b13 .v13-big .vb-s{display:none}}
@media (max-width:900px){.vt-b13{grid-template-columns:1fr;height:auto}.vt-b13__main{height:380px}.vt-b13__col{grid-template-rows:none;grid-template-columns:1fr 1fr}.vt-b13 .v13-sm{height:210px}}
@media (max-width:640px){.vt-b13__main{height:440px}.vt-b13 .v13-big{flex-direction:column}.vt-b13 .v13-big .vb-txt{position:static;padding:22px 22px 0;flex:0}.vt-b13 .v13-big .vb-t{font-size:26px}.vt-b13 .v13-big .vb-pic{position:absolute;right:16px;bottom:-30px;height:250px;margin:0}
 .vt-b13 .v13-big .vb-cta{position:absolute;left:22px;bottom:70px}.vt-b13__nav{left:22px;bottom:20px}.vt-b13__col{grid-template-columns:1fr}.vt-b13 .v13-sm{height:150px}}
</style>
<script>
(function(){
  var w=document.querySelector('.vt-b13');if(!w)return;
  var sl=[].slice.call(w.querySelectorAll('.v13-big')),d=w.querySelector('.vt-b13__dots'),k=0,hov=false;
  sl.forEach(function(_,q){var i=document.createElement('i');i.onclick=function(){go(q)};d.appendChild(i)});
  function go(q){k=(q+sl.length)%sl.length;sl.forEach(function(s,j){s.classList.toggle('on',j===k)});[].forEach.call(d.children,function(x,j){x.classList.toggle('on',j===k)})}
  w.querySelector('.n').onclick=function(){go(k+1)};w.querySelector('.p').onclick=function(){go(k-1)};
  var m=w.querySelector('.vt-b13__main');m.onmouseenter=function(){hov=true};m.onmouseleave=function(){hov=false};
  var sx=null;m.addEventListener('touchstart',function(e){sx=e.touches[0].clientX},{passive:true});
  m.addEventListener('touchend',function(e){if(sx===null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40)go(k+(dx<0?1:-1));sx=null});
  go(0);
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)setInterval(function(){if(!hov&&document.visibilityState==='visible')go(k+1)},5500);
})();
</script>
