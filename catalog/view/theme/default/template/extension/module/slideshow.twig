<style>
/* 10–13 — складені банери (текст кодом + картинка) */
.vb{position:relative;display:flex;overflow:hidden;isolation:isolate;border-radius:26px;text-decoration:none;color:#fff;background:var(--g)}
.vb::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(60% 90% at 85% 60%,rgba(255,90,190,.45),transparent 65%)}
.vb::after{content:"";position:absolute;inset:0;z-index:-1;opacity:.18;background-image:radial-gradient(rgba(255,255,255,.6) 1px,transparent 1.3px);background-size:20px 20px;-webkit-mask-image:linear-gradient(90deg,#000,transparent 60%);mask-image:linear-gradient(90deg,#000,transparent 60%)}
.vb-txt{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:34px 36px;flex:1;justify-content:center}
.vb-chip{padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase}
.vb-t{font-size:40px;font-weight:800;line-height:1.02;letter-spacing:-.5px}
.vb-price{font-size:30px;font-weight:800;color:#ffd1ec;text-shadow:0 0 22px rgba(255,62,165,.8)}
.vb-s{max-width:400px;font-size:15px;line-height:1.5;color:rgba(255,255,255,.78)}
.vb-cta{margin-top:6px;display:inline-flex;gap:8px;align-items:center;padding:12px 22px;border-radius:999px;background:#fff;color:#17151c;font-weight:700;font-size:14px;transition:background .25s,color .25s}
.vb-cta em{font-style:normal;transition:transform .25s}
.vb:hover .vb-cta{background:#ff3ea5;color:#fff}.vb:hover .vb-cta em{transform:translateX(4px)}
.vb-pic{position:relative;flex:0 0 auto;align-self:center;height:88%;aspect-ratio:5/9;margin-right:42px;border-radius:20px;overflow:hidden;transform:rotate(5deg);box-shadow:0 30px 50px -18px rgba(0,0,0,.75),0 0 0 1px rgba(255,255,255,.18);transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.vb:hover .vb-pic{transform:rotate(0) scale(1.04)}
.vs{position:relative}.vs-track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}.vs-track::-webkit-scrollbar{display:none}
.vs-track>*{scroll-snap-align:start;flex-shrink:0}
.vs-nav{display:flex;align-items:center;justify-content:space-between;margin-top:14px}
.vs-dots{display:flex;gap:6px}.vs-dots i{width:8px;height:8px;border-radius:8px;background:#d8d3de;transition:width .3s,background .3s;cursor:pointer}.vs-dots i.on{width:26px;background:#ff3ea5}
.vs-btns{display:flex;gap:8px}.vs-btns button{width:42px;height:42px;border-radius:50%;border:0;background:#e9e6ee;cursor:pointer;font-size:18px;transition:background .2s,color .2s}.vs-btns button:hover{background:#ff3ea5;color:#fff}

.vt-b3{margin:4px 0 0;font-family:inherit}
.vt-b3__track{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:4px 0 6px}
.vt-b3__track::-webkit-scrollbar{display:none}
.vt-b3 .v12-s{flex:0 0 calc((100% - 36px)/3);width:auto;height:470px;flex-direction:column;scroll-snap-align:start}
.vt-b3 .v12-s .vb-txt{position:static;justify-content:flex-start;padding:26px 26px 0;gap:10px;flex:0}
.vt-b3 .v12-s .vb-t{font-size:26px}.vt-b3 .v12-s .vb-price{font-size:23px}
.vt-b3 .v12-s .vb-s{font-size:13.5px;max-width:92%;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.vt-b3 .v12-s .vb-cta{position:absolute;left:26px;bottom:24px;padding:11px 18px;font-size:13.5px;margin:0;z-index:3}
.vt-b3 .v12-s .vb-pic{position:absolute;right:18px;bottom:-34px;height:290px;margin:0;transform:rotate(9deg)}
.vt-b3 .v12-s:hover .vb-pic{transform:rotate(2deg) translateY(-24px)}
.vt-b3 .vs-nav{display:flex;align-items:center;justify-content:space-between;margin-top:14px}
.vt-b3 .vs-dots{display:flex;gap:6px}.vt-b3 .vs-dots i{width:8px;height:8px;border-radius:8px;background:#d8d3de;transition:width .3s,background .3s;cursor:pointer}.vt-b3 .vs-dots i.on{width:26px;background:#ff3ea5}
.vt-b3 .vs-btns{display:flex;gap:8px}.vt-b3 .vs-btns button{width:42px;height:42px;border-radius:50%;border:0;background:#e9e6ee;cursor:pointer;font-size:18px;line-height:1;color:#17151c;transition:background .2s,color .2s}.vt-b3 .vs-btns button:hover{background:#ff3ea5;color:#fff}
@media (max-width:1100px){.vt-b3 .v12-s{flex-basis:calc((100% - 18px)/2)}}
@media (max-width:640px){.vt-b3 .v12-s{flex-basis:78%;height:430px}.vt-b3 .v12-s .vb-t{font-size:23px}.vt-b3 .vs-btns{display:none}}
</style>
<script>
(function(){
  var w=document.querySelector('.vt-b3');if(!w)return;var t=w.querySelector('.vt-b3__track'),its=[].slice.call(t.children),d=w.querySelector('.vs-dots'),hov=false;
  function per(){return Math.max(1,Math.round(t.clientWidth/its[0].offsetWidth))}
  function pages(){return Math.ceil(its.length/per())}
  function cur(){if(t.scrollLeft+t.clientWidth>=t.scrollWidth-4)return pages()-1;return Math.round(t.scrollLeft/((its[0].offsetWidth+18)*per()))}
  function dots(){d.innerHTML='';for(var q=0;q<pages();q++){(function(q){var i=document.createElement('i');i.onclick=function(){go(q)};d.appendChild(i)})(q)}upd()}
  function upd(){var c=cur();[].forEach.call(d.children,function(x,j){x.classList.toggle('on',j===c)})}
  function go(q){var n=pages();if(q>=n)q=0;if(q<0)q=n-1;t.scrollTo({left:its[Math.min(q*per(),its.length-1)].offsetLeft-its[0].offsetLeft})}
  t.addEventListener('scroll',upd);window.addEventListener('resize',dots);dots();
  w.querySelector('.n').onclick=function(){go(cur()+1)};w.querySelector('.p').onclick=function(){go(cur()-1)};
  w.onmouseenter=function(){hov=true};w.onmouseleave=function(){hov=false};
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches)setInterval(function(){if(!hov&&document.visibilityState==='visible')go(cur()+1)},5500);
})();
</script>
