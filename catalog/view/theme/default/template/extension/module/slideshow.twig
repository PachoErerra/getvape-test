<div class="home__slider swiper">
    <div class="swiper-wrapper">
        {% for banner in banners %}
            <div class="swiper-slide">
                <a {% if banner.link %}href="{{ banner.link }}" {% if banner.newtab %} target="blank" rel="nofollow"
                   {% endif %}{% else %}role="button"{% endif %} class="home__slide">
                    <img src="{{ banner.image }}" alt="{{ banner.title }}">
                </a>
            </div>
        {% endfor %}
    </div>
    <div class="swiper-nts swiper-button-next icon-arrow-next"></div>
    <div class="swiper-nts swiper-button-prev icon-arrow-prev"></div>
</div>


