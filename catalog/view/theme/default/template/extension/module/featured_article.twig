{% if articles %}
            <div class="home__inner">
              <div class="home__inner-top m-bottom-40">
                <div class="h3">{{ heading_title }}</div>
                <a href="{{ blog }}" class="link-with-arrow">
                  {{ text_dyvytysya_vsi }}
                  <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 9L5 5L1 1" stroke="currentColor"/>
                  </svg>
                </a>
              </div>
              <div class="home__news">
			   {% for article in articles %}
                <div class="home__news-item">
                  <div class="h4 font-medium"><a href="{{ article.href }}">{{ article.name }}</a></div>
                  <div class="home__news-item-info">
                    <a href="{{ article.href }}" class="link-with-arrow">
                      {{ text_chytaty_zapys }}
                      <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 9L5 5L1 1" stroke="currentColor"/>
                      </svg>
                    </a>
                    <div class="home__news-item-date">{{ article.date_added }}</div>
                  </div>
                </div>
				{% endfor %}
              </div>
            </div>
  {% endif %}