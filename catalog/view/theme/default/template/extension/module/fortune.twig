                    </svg>
                </div>

                <div class="modal--wheel-pattern modal--wheel-pattern_spider">
                    <img src="catalog/view/theme/default/image/wheel/halloween-bat.png"
                         class="modal--wheel-pattern_spider-bat" alt="{{ text_khellouyin_kazhan }}" loading="lazy">
                    <img src="catalog/view/theme/default/image/wheel/spider-web.png"
                         class="modal--wheel-pattern_spider-web" alt="web" loading="lazy">
                    <img src="catalog/view/theme/default/image/wheel/halloween-spider.png"
                         class="modal--wheel-pattern_spider-spider" alt="{{ text_khellouyin_pavuk }}" loading="lazy">
                </div>
            {% endif %}

            <div class="modal__hide js-modal-close">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <use href="#icon-cross"></use>
                </svg>
            </div>

            <div class="fortune d-flex flex-lg-row flex-column">
                <div class="fortune__info">
                    <div class="fortune__info-logo">
