                        {% if fortune_style == 'halloween' %}
                            <div class="fortune__info-logo-halloween">
                                <img src="catalog/view/theme/default/image/wheel/halloween-pumpkin-small.png"
                                     alt="{{ text_khellouyin_harbuz }}" loading="lazy">
                            </div>
                        {% endif %}
                    </div>

                    {% if customer_twisted %}
                        {% if type == 'regular' %}
                            {% set days = 15 %}
                        {% else %}
                            {% set days = 0 %}
                        {% endif %}
                        {% set winTimestampMs = (date().timestamp + days * 24 * 60 * 60) * 1000 %}
                        {% set winTimestampMs = (customer_twisted + days * 24 * 60 * 60) * 1000 %}

                        <div class="countdown">
                            <div class="countdown__title d-flex align-items-center">
                                <svg class="sprite-icon">
                                    <use href="catalog/view/theme/default/image/sprites/sprites.svg?v=#icon-alert-cart"></use>
                                </svg>
                                {{ text_nastupna_sproba_dostupna_cherez }}
                            </div>

                            <div class="countdown__items d-flex" data-deadline="{{ winTimestampMs }}">
                                <div class="countdown__item">
                                    <span class="countdown__item-value days" style="width: auto;"></span>
                                    <span class="countdown__item-text js-text-day">{{ text_dniv }}</span>
                                </div>
                                <div class="countdown__item">
                                    <span class="countdown__item-value hours"></span>
                                    <span class="countdown__item-text">{{ text_hod }}</span>
                                </div>

                                <div class="countdown__item">
                                    <span class="countdown__item-value minutes"></span>
                                    <span class="countdown__item-text">{{ text_khv }}</span>
                                </div>

                                <div class="countdown__item">
                                    <span class="countdown__item-value seconds"></span>
                                    <span class="countdown__item-text">{{ text_sek }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="fortune__info-content">
                            <!--div class="fortune__info-title fortune__info-title_small">{{ text_vy_vzhe_krutyly_koleso_sohodni }}
                                <br>
                                <b>{{ text_prykhodte_zavtra }}</b>
                            </div-->
                            <div class="fortune__info-title modal__title">
                                <span>{{ text_kruty }} <br> {{ text_koleso }} <br> {{ text_ta_vyhravay }}</span>
                                <b>{{ text_pryzy }}</b>
                            </div>
                        </div>
                    {% else %}
                        <div class="fortune__info-content" id="fortune__info-content">
                            <div class="fortune__info-title modal__title">

                                {% if fortune_style == 'halloween' %}
                                    <img class="fortune__info-title-hat"
                                         src="catalog/view/theme/default/image/wheel/halloween-hat.png"
                                         alt="{{ text_kruty_koleso_ta_vyhravay_pryzy }}" loading="lazy">
                                {% endif %}
                                <span>{{ text_kruty }} <br> {{ text_koleso }} <br> {{ text_ta_vyhravay }}</span>
                                <b>{{ text_pryzy }}</b>
                            </div>

                            <div class="fortune__info-action">
                                <button type="button" id="spinWheel"
                                        class="fortune__info-action-btn button-light-blue"
                                        {% if customer_isLogged %}
                                            onClick="spin();"
                                        {% else %}
                                            onClick="showLoginModal();"
                                        {% endif %}
                                >
                                    {{ text_krutyty_koleso }}
                                </button>
                            </div>

                            {% if fortune_style == 'halloween' %}
                                <div class="fortune__info-pumpkin">
                                    <img src="catalog/view/theme/default/image/wheel/halloween-pumpkin.png"
                                         alt="{{ text_khellouyin_harbuz }}" loading="lazy">
                                </div>
                            {% endif %}
                        </div>

                        <div class="fortune__info-loader" id="fortune__info-loader">
                            <svg class="dots-spinner" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em"
                                 viewBox="0 0 24 24">
                                <circle cx="4" cy="12" r="3" fill="currentColor">
                                    <animate id="svgSpinners3DotsBounce0" attributeName="cy"
                                             begin="0;svgSpinners3DotsBounce1.end+0.25s" calcMode="spline"
                                             dur="0.6s"
                                             keySplines=".33,.66,.66,1;.33,0,.66,.33" values="12;6;12"></animate>
                                </circle>
                                <circle cx="12" cy="12" r="3" fill="currentColor">
                                    <animate attributeName="cy" begin="svgSpinners3DotsBounce0.begin+0.1s"
                                             calcMode="spline"
                                             dur="0.6s" keySplines=".33,.66,.66,1;.33,0,.66,.33"
                                             values="12;6;12"></animate>
                                </circle>
                                <circle cx="20" cy="12" r="3" fill="currentColor">
                                    <animate id="svgSpinners3DotsBounce1" attributeName="cy"
                                             begin="svgSpinners3DotsBounce0.begin+0.2s" calcMode="spline" dur="0.6s"
                                             keySplines=".33,.66,.66,1;.33,0,.66,.33" values="12;6;12"></animate>
                                </circle>
                            </svg>
                        </div>

                        <div class="fortune__prize" id="fortune__prize">
                            <div class="fortune__info-text fortune__info-text_top">{{ text_vy_vyhraly }}</div>
                            <div class="fortune__info-title fortune__info-title_small modal__title js-fortune__prize-title"></div>
                            <div class="fortune__info-text js-fortune__prize-text"></div>


                            <div class="fortune__prize-block" style="display: none;">
                                <span class="fortune__prize-text js-fortune__prize-code"
                                      id="fortune__prize-code"></span>

                                <button type="button" class="fortune__prize-copy" onclick="copyContent()">
                                    <svg width="22" height="22" viewBox="0 0 16 16">
                                        <use id="fortune__prize-copy-icon" href="#icon-clipboard"></use>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    {% endif %}


                </div>

                <div class="fortune__inner">
                    <div class="fortune__canvas">
                        <div class="fortune__canvas-angle">
                            <svg width="72" height="62" viewBox="0 0 72 62" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M70.8514 0.710938L35.9797 61.1712L1.0957 0.710938H70.8514Z"
                                      fill="url(#paint0_linear_3535_6611)" stroke="#DFBA20" stroke-width="0.354204"
                                      stroke-miterlimit="10"/>
                                <defs>
                                    <linearGradient id="paint0_linear_3535_6611" x1="51.067" y1="30.9472"
                                                    x2="-18.6887"
                                                    y2="30.9472" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#F8C447"/>
                                        <stop offset="0.07" stop-color="#F8C549"/>
                                        <stop offset="0.12" stop-color="#F8CA51"/>
                                        <stop offset="0.15" stop-color="#F8D260"/>
                                        <stop offset="0.18" stop-color="#F8DE74"/>
                                        <stop offset="0.21" stop-color="#F8ED8E"/>
                                        <stop offset="0.22" stop-color="#F9F092"/>
                                        <stop offset="0.37" stop-color="#F8C447"/>
                                        <stop offset="0.49" stop-color="#DE9F39"/>
                                        <stop offset="0.65" stop-color="#C17529"/>
                                        <stop offset="0.79" stop-color="#AB561E"/>
                                        <stop offset="0.91" stop-color="#9E4317"/>
                                        <stop offset="1" stop-color="#9A3D15"/>
                                    </linearGradient>
                                </defs>
                            </svg>

                        </div>

                        <div class="fortune__container">
                            <div id="wheel" style="position: relative;z-index: 3;"></div>

                            <div class="fortune__canvas-dots">
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                                <div class="fortune__canvas-dot"></div>
                            </div>
                        </div>


                    </div>


                    <!--button class="btn btn-primary checkwin">{{ text_proveryt_vozmozhnost_yhr }}</button-->

                </div>
            </div>
        </div>

    </div>
</div>

{% if current_route not in ['checkout/simplecheckout', 'product/product'] and not fortune_hidden %}
    <div class="btn-wheel-action-wrap d-flex align-items-start">
        
        <button class="btn-wheel-action" type="button" aria-label="{{ text_koleso_fortuny }}">
            {% if fortune_style == 'basic' %}
                <img src="catalog/view/theme/default/image/wheel/btn-wheel-action.png" loading="lazy"
                     alt="{{ text_koleso_fortuny }}">
            {% elseif fortune_style == 'halloween' %}
                <img src="catalog/view/theme/default/image/wheel/btn-wheel-action-halloween.png" loading="lazy"
                     alt="{{ text_koleso_fortuny }}">
            {% endif %}
        </button>

        <button type="button"
                class="js-btn-wheel-action-hide btn-wheel-action-hide d-flex align-items-center justify-content-center"
                aria-label="Закрити">
            <svg width="24" height="24" viewBox="0 0 24 24">
                <use href="#icon-cross"></use>
            </svg>
        </button>
    </div>

{% endif %}

<script src="catalog/view/javascript/nts-wheel/nts-wheel.min.js?v={{ date().timestamp }}" data-cfasync="false"></script>
<!-- END WHEEL -->


<script type="text/javascript">
  $(".checkwin").click(function () {
    let win = $(this).attr('data-id');

    // console.log(win);

    $.ajax({
      type: 'POST',
      url: 'index.php?route=extension/module/fortune/checkwin',
      dataType: 'json',
      data: '',
      success: function (json) {
        console.log(json)
        if (json['success']) {
          console.log(json['success'])
        }
        if (json['error']) {
          console.log(json['error'])
        }
      },
      error: function (xhr, ajaxOptions, thrownError) {
        console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
    });
    return false;

  });
</script>


