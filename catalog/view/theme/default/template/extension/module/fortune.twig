                                  fill="currentColor"/>
                            <g opacity="0.800003">
                                <path d="M13.4501 30.6055H4.13526L0 5.31939e-05H8.09615L10.055 21.5113L19.5003 5.31939e-05H28.2928L13.4501 30.6055Z"
                                      fill="currentColor"/>
                            </g>
                            <path d="M19.4998 5.31939e-05L5.99707 30.5781L13.4495 30.6055L28.2922 5.31939e-05H19.4998Z"
                                  fill="currentColor"/>
