		$('.row-shipping_address_receiver_phone').hide();
		$('.row-shipping_address_pib').hide();
	} else {
	// console.log(0);
	}
*/	
	</script>
	{% endif %}
	<script>

	$('.row-shipping_address_ya>div>label').hide();

	$('.row-customer_callme>div>label').hide();

	if ($("#shipping_address_ya").prop('checked')) {
		// console.log(1);
		$('.row-shipping_address_receiver_phone').hide();
		$('.row-shipping_address_pib').hide();
	}
	
	</script>
  </div>
</div>