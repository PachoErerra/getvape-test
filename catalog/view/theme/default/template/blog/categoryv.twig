    <script>
        $('button[id^=\'button-upload\']').on('click', function () {
            var node = this;

            $('#form-upload').remove();

            $('body').prepend('<form enctype="multipart/form-data" id="form-upload" style="display: none;"><input type="file" name="file" accept=".pdf, application/msword, application/vnd.openxmlformats-officedocument.wordprocessingml.document" /></form>');

            $('#form-upload input[name=\'file\']').trigger('click');

            if (typeof timer != 'undefined') {
                clearInterval(timer);
            }

            timer = setInterval(function () {
                if ($('#form-upload input[name=\'file\']').val() != '') {
                    clearInterval(timer);

                    $.ajax({
                        url: 'index.php?route=tool/upload',
                        type: 'post',
                        dataType: 'json',
                        data: new FormData($('#form-upload')[0]),
                        cache: false,
                        contentType: false,
                        processData: false,
                        beforeSend: function () {
                            //	$(node).button('loading');
                            $(node).find('.js-fileName').text('Зачекайте..');
                        },
                        complete: function () {
                            //	$(node).button('reset');
                        },
                        success: function (json) {
                            $('.text-danger').remove();

                            if (json['error']) {
                                $(node).parent().find('input').after('<div class="text-danger">' + json['error'] + '</div>');

                            }

                            if (json['success']) {

                                //	$(node).parent().find('#filename').val(json['file']);
                                $(node).parent().find('#file').val(json['file']);
                                $(node).find('.js-fileName').text(json['file']);
                            }
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        }
                    });
                }
            }, 500);
        });
        $('#send-resume-empty').on('click', function () {
            $.ajax({
                url: 'index.php?route=blog/article/sendmail2',
                type: 'post',
                dataType: 'json',
                data: $("#form-resume-empty").serialize(),
                beforeSend: function () {
                    $('#send-resume').button('loading');
                },
                complete: function () {
                    $('#send-resume').button('reset');
                },
                success: function (json) {
                    $('.alert-dismissible').remove();
                    $('.field').removeClass('has-error');
                    if (json['error']) {
                        $('#send-resume').before('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
                        if (json['errormain']) {
                            for (i in json['errormain']) {
                                $('#' + json['errormain'][i]).parent().addClass('has-error');
                            }
                        }
                        if (json['errormain']) {
                            for (i in json['errormain']) {
                                $('#' + json['errormain'][i]).parent().addClass('has-error');
                            }
                        }
                        if (json['error_question']) {
                            for (i in json['error_question']) {
                                $('#question' + json['error_question'][i]).parent().addClass('has-error');
                            }
                        }
                    }

                    if (json['success']) {

							$(".modal__close").trigger('click');

							$('.toast .p').text('Ви успішно відправили заявку.');
							$(".js-open-toast").trigger('click');

							$('input[name=\'name\']').val('');
							$('input[name=\'last_name\']').val('');
							$('input[name=\'phone\']').val('');
							$('input[name=\'date\']').val('');
							// $('input[name=\'file\']').val('');

							{% for key, question in questions %}
								$('input[name=\'question[{{ key }}][answer]\']').val('');
							{% endfor %}
                    }
                }
            });
        });
    </script>
