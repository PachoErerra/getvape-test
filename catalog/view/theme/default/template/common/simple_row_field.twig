                        <path d="M14.6356 8.91914C14.4809 8.91914 14.3325 8.98059 14.2231 9.08999C14.1137 9.19938 14.0522 9.34775 14.0522 9.50246C14.0522 9.65716 14.1137 9.80553 14.2231 9.91493C14.3325 10.0243 14.4809 10.0858 14.6356 10.0858H14.6554C15.7194 10.1616 16.494 10.5163 17.0365 11.0984C17.593 11.6981 17.8812 12.4436 17.859 13.3652C17.8554 13.5199 17.9135 13.6697 18.0204 13.7816C18.1272 13.8935 18.2742 13.9584 18.4289 13.962C18.5836 13.9655 18.7334 13.9075 18.8453 13.8006C18.9572 13.6937 19.0221 13.5468 19.0257 13.392C19.0537 12.1822 18.664 11.1381 17.8917 10.3051V10.3028C17.1019 9.45579 16.018 9.0078 14.7137 8.9203L14.6939 8.91797L14.6356 8.91914Z" fill="white"/>
