                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M14 0C21.7314 0 28 6.2685 28 14C28 21.7316 21.7315 28 14 28C6.26859 28 0 21.7315 0 14C0 6.26859 6.26763 0 14 0Z" fill="currentColor"/>
