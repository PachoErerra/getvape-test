<div class="form-group {% if required %}required{% endif %} row-{{id}} checkout__tabs-field {% if id in ['shipping_address_ya', 'shipping_address_city', 'shipping_address_address_1', 'shipping_address_poshtomat_address_1', 'shipping_address_address_2', 'shipping_address_address_3'] %}w100{% else %}w33{% endif %}" {% if id == 'customer_fax' and value and value != '1970-01-01' %} style="display:none" {% endif %}>
<div class="field">
    <label class="control-label {{page == 'checkout' ? 'col-sm-4' : 'col-sm-2' }}" for="{{id}}">
        {{label}}{% if required %}<span style="color: red;">*</span> {% endif %}
    </label>
    <div class="{{page == 'checkout' ? 'col-sm-8' : 'col-sm-10'}} field-rel">
      {% if type == 'select' or type == 'select2' %}
        <select class="form-control" name="{{ name }}" id="{{ id }}" {{ bootstrap ? 'data-theme="bootstrap"' : '' }} {{ type == 'select2' ? 'data-type="select2"' : '' }} {{ reload ? 'data-onchange="reloadAll"' : ''}}>
          {% for info in values %}
            <option value="{{ info['id'] | escape }}" {{ value == info['id'] ? 'selected="selected"' : '' }}>{{ info['text'] }}</option>
          {% endfor %}
        </select>
		<div class="dropdown-arrow"></div>
      {% elseif type == 'radio' %}
        <div>
        {% for info in values %}
          <div class="radio">
              <input type="radio" name="{{ name }}" id="{{ id }}_{{ info['id'] }}" value="{{ info['id'] | escape }}" {{ value == info['id'] ? 'checked="checked"' : '' }} {{ reload ? 'data-onchange="reloadAll"' : '' }}>
            <label {{ value == info['id'] ? 'class="is-checked"' : '' }} for="{{ id }}_{{ info['id'] }}">
