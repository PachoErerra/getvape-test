<div class="header__search-wrapper">
    <div class="header__search">
        <input type="search" name="search" id="input_search" placeholder="{{ text_search }}" value="{{ search }}"{% if search_placeholders %} data-placeholder-phrases="{{ search_placeholders_json|e('html_attr') }}"{% endif %}>
        {% if search_placeholders and not search %}
        <span class="header__search-typed" aria-hidden="true"></span>
        {% endif %}
        <button class="js-search-btn">{{ text_button_search }}</button>

        <div class="header__search-close">{{ text_zakryty }}</div>
    </div>
</div>
{% if search_placeholders and not search %}
<style>
.header__search-typed {
  position: absolute;
  left: 0;
  right: 120px;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding-left: 60px;
  font-style: normal;
  font-weight: 500;
  font-size: 14px;
  line-height: 1;
  color: #000;
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  z-index: 1;
}
.header__search-typed.is-hidden {
  display: none;
}
@media only screen and (max-width: 599px) {
  .header__search-typed {
    padding-left: 40px;
    right: 5px;
  }
}
.header__search.is-typing input::-webkit-input-placeholder { color: transparent; }
.header__search.is-typing input::-moz-placeholder { color: transparent; }
.header__search.is-typing input:-ms-input-placeholder { color: transparent; }
.header__search.is-typing input:-moz-placeholder { color: transparent; }
.header__search.is-typing input::placeholder { color: transparent; }
</style>
<script>
(function () {
	var input = document.getElementById('input_search');
	var typed = document.querySelector('.header__search-typed');
	var searchBox = input && input.closest ? input.closest('.header__search') : null;
	if (!input || !typed || !searchBox) return;

	var phrases;
	try {
		phrases = JSON.parse(input.getAttribute('data-placeholder-phrases') || '[]');
	} catch (e) {
		return;
	}
	if (!phrases || !phrases.length) return;

	var phraseIndex = 0;
	var charIndex = 0;
	var deleting = false;
	var paused = false;
	var timer = null;
	var typeDelay = 90;
	var deleteDelay = 50;
	var holdDelay = 1400;
	var emptyDelay = 400;

	function clearTimer() {
		if (timer) {
			clearTimeout(timer);
			timer = null;
		}
	}

	function schedule(fn, delay) {
		clearTimer();
		timer = setTimeout(fn, delay);
	}

	function showTyped() {
		typed.classList.remove('is-hidden');
		searchBox.classList.add('is-typing');
	}

	function hideTyped() {
		typed.classList.add('is-hidden');
		typed.textContent = '';
		searchBox.classList.remove('is-typing');
	}

	function tick() {
		if (paused || document.activeElement === input || input.value) {
			return;
		}

		showTyped();
		var phrase = phrases[phraseIndex];

		if (!deleting) {
			charIndex++;
			typed.textContent = phrase.slice(0, charIndex);
			if (charIndex >= phrase.length) {
				deleting = true;
				schedule(tick, holdDelay);
				return;
			}
			schedule(tick, typeDelay);
			return;
		}

		charIndex--;
		typed.textContent = phrase.slice(0, Math.max(charIndex, 0));
		if (charIndex <= 0) {
			deleting = false;
			phraseIndex = (phraseIndex + 1) % phrases.length;
			schedule(tick, emptyDelay);
			return;
		}
		schedule(tick, deleteDelay);
	}

	function pause() {
		paused = true;
		clearTimer();
		hideTyped();
	}

	function resume() {
		if (input.value) {
			hideTyped();
			return;
		}
		paused = false;
		charIndex = 0;
		deleting = false;
		showTyped();
		typed.textContent = '';
		schedule(tick, emptyDelay);
	}

	input.addEventListener('focus', pause);
	input.addEventListener('blur', resume);
	input.addEventListener('input', function () {
		if (input.value) {
			pause();
		} else if (document.activeElement !== input) {
			resume();
		}
	});

	showTyped();
	schedule(tick, 600);
})();
</script>
{% endif %}

<div class="search--overlay"></div>

