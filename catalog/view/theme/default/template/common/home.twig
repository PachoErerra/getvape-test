                </section>
                <style>
                .elb{position:relative;margin:18px 0 22px;border-radius:24px;overflow:hidden;aspect-ratio:1200/520;background:#0b1026;box-shadow:0 24px 50px -28px rgba(20,16,60,.7)}
                .elb-svg{position:absolute;inset:0;width:100%;height:100%;display:block}
                .elb-fx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
                .elb-build{cursor:pointer;outline:none;transition:filter .3s}
                .elb-build:hover,.elb-build:focus-visible{filter:brightness(1.12) drop-shadow(0 0 14px rgba(255,210,122,.45))}
                .elb-glow.on{animation:elbGlow 1.2s ease-out}
                @keyframes elbGlow{0%{opacity:.35}100%{opacity:0}}
                .elb-stars circle{animation:elbTw 3s ease-in-out infinite}.elb-stars circle:nth-child(3n){animation-delay:1s}.elb-stars circle:nth-child(3n+1){animation-delay:2s}
                @keyframes elbTw{50%{opacity:.2}}
                .elb-boat{animation:elbBoat 40s linear infinite}@keyframes elbBoat{from{transform:translateX(-200px)}to{transform:translateX(1300px)}}
                .elb-cap{position:absolute;left:22px;top:18px;color:#fff;pointer-events:none;text-shadow:0 2px 10px rgba(0,0,0,.5)}
                .elb-cap b{display:block;font-size:clamp(20px,2.6vw,34px);letter-spacing:.5px}.elb-cap span{font-size:clamp(12px,1.3vw,15px);opacity:.85}
                @media (max-width:600px){.elb{border-radius:16px}.elb-cap{left:12px;top:8px}.elb-cap b{font-size:15px}.elb-cap span{font-size:10.5px}}
                @media (prefers-reduced-motion:reduce){.elb *{animation:none!important}}
                </style>
                <script>
                (function(){
                  var s=document.querySelector('.elb');if(!s)return;
                  var c=s.querySelector('.elb-fx'),x=c.getContext('2d'),b=s.querySelector('.elb-build'),g=s.querySelector('.elb-glow');
                  var P=[],R=[],run=false,dpr=Math.min(window.devicePixelRatio||1,2);
                  var COL=['#ff3ea5','#ffd27a','#7cf3ff','#b18cff','#ffffff','#7dff9a','#ff7a45'];
                  function fit(){c.width=s.clientWidth*dpr;c.height=s.clientHeight*dpr}fit();addEventListener('resize',fit);
                  function rocket(fx,fy){var W=c.width,H=c.height;R.push({x:fx,y:fy,tx:W*(.12+Math.random()*.76),ty:H*(.06+Math.random()*.22),c:COL[Math.random()*COL.length|0],t:0});if(!run){run=true;requestAnimationFrame(step)}}
                  function boom(r){var n=70+Math.random()*50|0,sp=(2+Math.random()*2.5)*dpr,two=Math.random()<.35?COL[Math.random()*COL.length|0]:null;
                    for(var i=0;i<n;i++){var a=Math.PI*2*i/n,v=sp*(.5+Math.random()*.6);P.push({x:r.x,y:r.y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,l:1,c:two&&i%2?two:r.c})}}
                  function step(){x.globalCompositeOperation='destination-out';x.fillStyle='rgba(0,0,0,.22)';x.fillRect(0,0,c.width,c.height);x.globalCompositeOperation='lighter';
                    for(var i=R.length-1;i>=0;i--){var r=R[i];r.t+=.022;var px=r.x,py=r.y;r.x+=(r.tx-r.x)*.06;r.y+=(r.ty-r.y)*.06;
                      x.strokeStyle=r.c;x.lineWidth=2.4*dpr;x.beginPath();x.moveTo(px,py);x.lineTo(r.x,r.y);x.stroke();
                      if(Math.abs(r.y-r.ty)<4*dpr||r.t>1){boom(r);R.splice(i,1)}}
                    for(i=P.length-1;i>=0;i--){var p=P[i];p.x+=p.vx;p.y+=p.vy;p.vy+=.045*dpr;p.vx*=.985;p.vy*=.985;p.l-=.012;
                      if(p.l<=0){P.splice(i,1);continue}x.globalAlpha=p.l;x.fillStyle=p.c;x.beginPath();x.arc(p.x,p.y,1.9*dpr,0,7);x.fill()}
                    x.globalAlpha=1;
                    if(R.length||P.length)requestAnimationFrame(step);else{run=false;x.clearRect(0,0,c.width,c.height)}}
