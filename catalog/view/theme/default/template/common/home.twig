                <style>
                .vt-tiles{margin:22px 0 34px}
                .vt-list{display:grid;align-items:start;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;list-style:none;margin:0;padding:0}
                .vt-tile{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-height:150px;padding:18px 10px 16px;border-radius:22px;background:#fff;border:1px solid #eef0f5;box-shadow:0 2px 10px rgba(20,24,40,.04);text-decoration:none;color:#1b1d26;overflow:hidden;isolation:isolate;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
                .vt-tile::before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(120% 90% at 50% 0%,color-mix(in srgb,var(--c) 14%,#fff) 0%,#fff 62%);opacity:.9;transition:opacity .25s}
                .vt-ic{position:relative;display:grid;place-items:center;width:80px;height:80px;border-radius:50%;background:color-mix(in srgb,var(--c) 10%,#fff)}
                .vt-ic::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:1.5px dashed color-mix(in srgb,var(--c) 35%,transparent);opacity:0;transform:scale(.85);transition:opacity .3s,transform .3s}
                .vt-ic svg{filter:drop-shadow(0 6px 8px rgba(226,63,176,.28));transition:transform .3s cubic-bezier(.34,1.56,.64,1)}
                .vt-name{font-size:15px;font-weight:600;line-height:1.25;text-align:center}
                .vt-go{position:absolute;top:12px;right:14px;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-size:18px;line-height:1;color:#fff;background:var(--c);opacity:0;transform:translateX(-6px);transition:opacity .25s,transform .25s}
                .vt-tile:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--c) 40%,#fff);box-shadow:0 14px 30px -12px color-mix(in srgb,var(--c) 55%,transparent)}
                .vt-tile:hover .vt-ic svg{transform:scale(1.12) rotate(-4deg)}
                .vt-tile:hover .vt-ic::after{opacity:1;transform:scale(1)}
                .vt-tile:hover .vt-go{opacity:1;transform:none}
                .vt-tile:hover .vt-name{color:var(--c)}
                @media (max-width:1200px){.vt-list{grid-template-columns:repeat(3,minmax(0,1fr))}}
                @media (max-width:640px){.vt-list{display:flex;overflow-x:auto;gap:10px;padding:2px 2px 8px;scroll-snap-type:x mandatory;scrollbar-width:none}.vt-list::-webkit-scrollbar{display:none}.vt-list li{flex:0 0 132px;scroll-snap-align:start}.vt-tile{min-height:138px;padding:16px 8px 14px;border-radius:18px}.vt-ic{width:64px;height:64px}.vt-ic svg{width:42px;height:42px}.vt-name{font-size:13px}.vt-go{display:none}}
                @media (prefers-reduced-motion:reduce){.vt-tile,.vt-tile *{transition:none!important}}
                </style>
