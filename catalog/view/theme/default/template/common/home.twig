{{ header }}
<div id="common-home" class="container">
    <div class="home__content">
        <div class="home__holder align-items-stretch">
            <div>
                {{ column_left }}
            </div>
            <div class="home__body">
                {{ content_top }}

                {# Швидкі переходи — мозаїка (варіант 6, тест) #}
                <section class="vt-mz" aria-label="Швидкі переходи">
                    <div class="t6w"><a class="t6 t6-big" href="/specials/" style="--c:#ff3ea5;--p:#fce7f3"><b>Знижки</b><small>Дивитися всі →</small><img src="/catalog/view/theme/default/image/vt/znyzhky-gradient.png" alt=""></a><a class="t6 t6-big" href="/latest/" style="--c:#8b5cf6;--p:#ede9fe"><b>Новинки</b><small>Дивитися всі →</small><img src="/catalog/view/theme/default/image/vt/novynky-gradient.png" alt=""></a><a class="t6 " href="/nabori-solov-3013/" style="--c:#22c55e;--p:#dcfce7"><b>Ароматизатори сольові</b><img src="/catalog/view/theme/default/image/vt/aromatyzatory-solovi.png" alt=""></a><a class="t6 " href="/podsistemi-1122/" style="--c:#3b82f6;--p:#dbeafe"><b>Подсистеми</b><img src="/catalog/view/theme/default/image/vt/podsystemy.png" alt=""></a><a class="t6 " href="/kartridj-1271/" style="--c:#64748b;--p:#e2e8f0"><b>Картриджі</b><img src="/catalog/view/theme/default/image/vt/kartridzhi.png" alt=""></a><a class="t6 " href="/populyarni-tovary/" style="--c:#f59e0b;--p:#fef3c7"><b>Популярні товари</b><img src="/catalog/view/theme/default/image/vt/populyarni-gradient.png" alt=""></a></div>
                </section>
                <style>
                .vt-mz{margin:22px 0 34px}
                .vt-mz a{text-decoration:none;color:#17151c}
                .vt-mz img{display:block}
                
.t6w{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:150px 150px;gap:14px}
.t6{position:relative;padding:18px;border-radius:22px;background:var(--p);overflow:hidden;transition:transform .3s}
.t6 b{position:relative;z-index:2;font-size:16px}.t6 small{position:absolute;left:18px;bottom:16px;font-weight:700;font-size:13px;color:var(--c)}
.t6 img{position:absolute;right:10px;bottom:6px;width:90px;height:90px;object-fit:contain;transition:transform .4s}
.t6-big{grid-row:span 2}.t6-big b{font-size:24px}.t6-big img{width:170px;height:170px;right:14px;bottom:44px}
.t6:hover{transform:translateY(-3px)}.t6:hover img{transform:scale(1.08) rotate(-5deg)}

                .t6 b{display:block;line-height:1.2}
                .t6:hover{box-shadow:0 16px 30px -16px color-mix(in srgb,var(--c) 60%,transparent)}
                .t6:hover small{text-decoration:underline}
                @media (max-width:900px){.t6w{grid-template-columns:1fr 1fr;grid-template-rows:none}.t6-big{grid-row:auto;height:200px}.t6{height:130px}.t6-big img{width:110px;height:110px;bottom:40px}}
                @media (max-width:420px){.t6{height:118px;padding:14px}.t6 b{font-size:14px}.t6 img{width:72px;height:72px}.t6-big{height:170px}.t6-big b{font-size:20px}.t6-big img{width:90px;height:90px;bottom:38px}}
                @media (prefers-reduced-motion:reduce){.t6,.t6 img{transition:none}}
                                .vt-mz{margin:16px 0 26px}
                .vt-mz .t6w{grid-template-rows:96px 96px;gap:12px}
                .vt-mz .t6{padding:14px 16px;border-radius:18px}
                .vt-mz .t6 b{font-size:15px}
                .vt-mz .t6 img{width:72px;height:72px;right:10px;bottom:6px}
                .vt-mz .t6-big b{font-size:21px}
                .vt-mz .t6 small{left:16px;bottom:13px}
                .vt-mz .t6-big img{width:120px;height:120px;right:14px;bottom:12px}
                @media (max-width:900px){.vt-mz .t6w{grid-template-rows:none}.vt-mz .t6{height:96px}.vt-mz .t6-big{height:130px}.vt-mz .t6-big img{width:86px;height:86px;bottom:30px}}
                @media (max-width:420px){.vt-mz .t6{height:88px}.vt-mz .t6 b{font-size:13.5px}.vt-mz .t6 img{width:56px;height:56px}.vt-mz .t6-big{height:120px}.vt-mz .t6-big b{font-size:18px}.vt-mz .t6-big img{width:72px;height:72px;bottom:28px}}
                </style>
                <ul class="home__categories home__categories--mob"></ul>
                {{ content_bottom }}
            </div>
            {{ column_right }}

        </div>
    </div>
</div>



{{ footer }}