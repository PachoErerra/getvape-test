{% if age_gate_required and not disable_age_modal %}
<div class="modal modal--sm modal--old modal-age" {{ modal_age_visible }}>
    <div class="modal__overlay modal__overlay--disabled"></div>
    <div class="modal-dialog modal-dialog-centered modal-dialog-xs">
        <div class="modal__container">
            <div class="h3 font-semibold">{{ text_vam_vypovnylosya_18_rokiv }}</div>
            <div class="text-content m-top-20">
                <div class="font-medium">{{ text_perekhodyachy_na_sayt_getvape_com }} <span class="showpink">{{ text_18_rokiv }}</span> {{ text_ta_vy_oznayomleni_z_vidpovidalnistyu }} <span class="showpink">{{ text_chynnoho_zakonodavstva_ukrayiny }}</span>{{ text_zokrema }}
                </div>

                <ul class=" font-medium">
                    <li>{{ text_statti_156_kodeksu_ukrayiny_pro }}</li>
                    <li>{{ text_zakonu_ukrayiny_3628_ix_vid }}
                    </li>
                </ul>
            </div>

            <ul class="modal-age__menu d-flex flex-column flex-md-row">
                <li>
                    <a href="/age-restrictions/">{{ text_detalnishe_pro_vikovi_obmezhennya }}</a>
                </li>
                <li>
                    <a href="/responsible-vaping/">{{ text_vidpovidalne_spozhyvannya }}</a>
                </li>
            </ul>

            <div class="modal__fields flex">
                <div class="modal__field w50">
                    <a href="https://www.youtube.com/watch?v=TqxeyzfiZtU" rel="noreferrer nofollow noopener"
                       class="btn btn-gray btn-full">{{ text_ni_meni_nemaye_18 }}</a>
                </div>
                <div class="modal__field w50">
                    <button type="button" class="btn btn-primary btn-full allow-18">
                        {{ text_tak_meni_vzhe_ye_18 }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% elseif age_gate_required and disable_age_modal %}
{# Info pages: content readable, but shop UI stays locked until age confirm #}
<div class="age-gate-bar">
    <div class="age-gate-bar__inner d-flex flex-column flex-md-row align-items-md-center justify-content-md-between">
        <div class="age-gate-bar__text font-medium">{{ text_vam_vypovnylosya_18_rokiv }}</div>
        <div class="age-gate-bar__actions d-flex">
            <a href="https://www.youtube.com/watch?v=TqxeyzfiZtU" rel="noreferrer nofollow noopener"
               class="btn btn-gray">{{ text_ni_meni_nemaye_18 }}</a>
            <button type="button" class="btn btn-primary allow-18">{{ text_tak_meni_vzhe_ye_18 }}</button>
        </div>
    </div>
</div>
{% endif %}

