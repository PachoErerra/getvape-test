<style>
.vt-ultra{position:relative;display:grid!important;place-items:center;background:#0d0818!important;border-color:transparent!important;box-shadow:0 0 0 1px rgba(139,92,246,.6),0 0 16px rgba(255,47,160,.35);transition:transform .25s,box-shadow .25s}
.vt-ultra::after{content:"";position:absolute;inset:-1px;border-radius:inherit;background:conic-gradient(from 0deg,#22e6ff,#8b5cf6,#ff2fa0,#22e6ff);z-index:-1;opacity:0;transition:opacity .3s;animation:vtUltraSpin 3s linear infinite}
.vt-ultra:hover{transform:translateY(-2px);box-shadow:0 0 0 1px #ff2fa0,0 0 26px rgba(255,47,160,.6)}
.vt-ultra svg{animation:vtUltraPulse 2.6s ease-in-out infinite}
@keyframes vtUltraPulse{50%{filter:drop-shadow(0 0 6px #ff2fa0)}}
@keyframes vtUltraSpin{to{transform:rotate(360deg)}}
.vt-ultra-m{display:grid;place-items:center;background:#0d0818!important}
@media (prefers-reduced-motion:reduce){.vt-ultra svg{animation:none}}
</style>


