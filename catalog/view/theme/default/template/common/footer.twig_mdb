    <div class="anchor-actions">
        <a role="button" aria-label="categories" class="anchor-actions__item anchor-actions__categories"></a>
        <a href="{{ special }}" class="anchor-actions__item anchor-actions__discounts" aria-label="Знижки">
            <span>{{ total_special }}</span>
        </a>
        {% if logged %}
            <a href="{{ account }}" class="anchor-actions__item anchor-actions__profile anchor-actions__profile-logged"
               aria-label="Аккаунт"></a>
        {% else %}
            <a href="javascript:void(0);"
               class="anchor-actions__item regsms_open anchor-actions__profile anchor-actions__profile-login"
               aria-label="Аккаунт"></a>
        {% endif %}

        <!--
					{% if reward_total %}
					{{ reward_total }}
					{% endif %}
-->

        <a role="button" aria-label="basket" class="anchor-actions__item anchor-actions__cart icon-cart js-open-basket">
            <span>{{ cart_total }}</span>
        </a>
    </div>
    <div class="drop-categories">
        <div class="drop-categories__close"></div>
        <div class="drop-categories__title">Категорії товарів</div>
        <ul class="drop-categories__items">
            {% for category in categories %}
                <li class="drop-categories__item"><a href="{{ category.href }}">{% if category.image %}<img
                            src="{{ category.image }}" width="24" height="24" loading="lazy"
                            alt="{{ category.name | nl2br }}">{% endif %}{{ category.name }}</a></li>
            {% endfor %}
        </ul>

        {% if super_button_link %}
            <a href="{{ super_button_link }}" target="_blank" class="somebutton">
                <svg width="800px" height="800px" viewBox="-4.5 0 21 21" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#fff" fill-rule="evenodd"
