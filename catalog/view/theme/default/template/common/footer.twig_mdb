</div>

<style>
  .sprite-icon {
    fill: none
  }
</style>


<div class="toast">
    <div class="toast__close"></div>
    <div class="p md font-medium">Ваш відгук успішно відправлено. Після перевірки відгук буде опубліковано. Дякуємо!
    </div>
</div>

{% if active_sock %}
    <!--  TODO: модалка и скрипт нужен только при условии логики когда выиграл носок -->
    <!-- modal--gift -->
    <div class="modal modal modal--gift">
        <div class="modal__overlay"></div>
        <div class="modal-dialog modal-dialog-centered modal-dialog-md modal__gift">
            <div class="modal__container">
                <div class="modal__close"></div>
                <div class="h3 font-semibold modal__gift-title">Подарунок буде <br> втрачено :(</div>

                <div class="modal__gift-content">
                    <p style="margin-top: 16px;margin-bottom: 24px;font-size: 16px;">
                        Ви не отримаєте шкарпетки, якщо не оформите замовлення. Але завтра зможете повернутись
                        та заново прокрутити колесо
                    </p>

                    <a href="/specials/" class="button-light-blue center modal__gift-action">До покупок</a>
                </div>


                <div class="modal__gift-pattern modal__gift-pattern--cross">
                    <img src="/catalog/view/theme/default/image/wheel/socks/modal-gift-cross.png" alt="Шкарпетки">
                </div>

                <div class="modal__gift-pattern modal__gift-pattern--smile">
                    <img src="/catalog/view/theme/default/image/wheel/socks/modal-gift-smile.png" alt="Смайл">
                </div>

                <div class="modal__gift-pattern modal__gift-pattern--socks">
                    <img src="/catalog/view/theme/default/image/wheel/socks/modal-gift-socks.png" alt="Шкарпетки">
                </div>
            </div>
        </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        document.addEventListener("mouseleave", function (e) {
          if (e.clientY < 10 && !getCookie("modal-gift")) {
            setCookie("modal-gift", "true", 1, "hours");

            $('.modal--gift').fadeIn(400);
            $('body').addClass('is-open-modal');
          }
        });
      });

    </script>
    <!--/modal--gift -->
{% endif %}

<!-- popup-notify -->
{% if popup_show and popup_image %}
    <div class="popup-notify">
        {% if popup_url %}
            <a href="{{ popup_url }}" onclick="popup_notify_cookie()" class="popup-notify__all-link"
               aria-label="popup notify"></a>
        {% endif %}
        <div class="popup-notify-content">
            <img src="{{ popup_image }}" alt="img" class="popup-notify__img">

            <div class="popup-notify__btn">
                <div class="popup-notify__link">Перейти</div>
            </div>
            <span class="popup-notify__close" onclick="popup_notify_cookie()"><span class="popup-notify__cross"></span></span>
        </div>
    </div>



    <script>
      jQuery(document).ready(function ($) {
        $('.popup-notify').fadeIn('slow').addClass('popup-notify_is-show');
        popup_notify_cookie = function () {
          document.cookie = "popup_show=1; max-age=86400; path=/";
          $('.popup-notify').fadeOut('slow').removeClass('popup-notify_is-show');
        }
      });
    </script>

    <style>
      .popup-notify {
        border-radius: 4px;
        bottom: 120px;
        box-sizing: border-box;
        box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.4);
        cursor: pointer;
        display: block;
        line-height: normal;
        padding: 0;
        position: fixed;
        right: -400px;
        text-align: left;
        text-decoration: inherit;
        transition: right 1.2s, box-shadow ease .3s;
        width: 400px;
        z-index: 5;
        overflow: hidden;
        display: none;
      }

      @media (hover: hover) {
        .popup-notify:hover {
          box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.8);
        }
      }

      .popup-notify__all-link {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        left: 0;
        z-index: 1;
      }


      @media (max-width: 1023px) {
        .popup-notify {
          bottom: 80px;
        }
      }

      .popup-notify:hover, .popup-notify:active {
        text-decoration: inherit;
      }


      .popup-notify span {
        display: block;
      }

      .popup-notify .popup-notify__close {
        position: absolute;
        right: 0;
        top: 0;
        width: 40px;
        height: 40px;
        z-index: 2;
      }

      .popup-notify .popup-notify__close .popup-notify__cross {
        background: rgba(255, 255, 255, 0.8);
        border-radius: 50%;
        overflow: hidden;
        position: absolute;
        bottom: 50%;
        left: 50%;
        transform: translate(-50%, 50%);
        width: 32px;
        height: 32px;
        border: 8px solid transparent;
        box-sizing: border-box;
      }

      .popup-notify .popup-notify__close .popup-notify__cross:hover:before, .popup-notify .popup-notify__close .popup-notify__cross:hover:after {
        background: var(--pink);
      }

      .popup-notify .popup-notify__close .popup-notify__cross:before, .popup-notify .popup-notify__close .popup-notify__cross:after {
        background: #221F1F;
        content: '';
        height: 2px;
        left: 0;
        margin-top: -1px;
        position: absolute;
        top: 50%;
        width: 100%;
      }

      .popup-notify .popup-notify__close .popup-notify__cross:before {
        transform: rotate(45deg);
      }

      .popup-notify .popup-notify__close .popup-notify__cross:after {
        transform: rotate(-45deg);
      }

      .popup-notify__img {
        box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.4);
        display: block;
      }

      .popup-notify.popup-notify_is-show {
        right: 24px;
      }

      @media (max-width: 400px) {
        .popup-notify {
          width: 100%;
          box-shadow: none;
        }

        .popup-notify.popup-notify_is-show {
          right: 15px;
          width: calc(100% - 30px);
        }
      }

      .popup-notify__btn {
        margin-top: 16px;
        position: absolute;
        bottom: 24px;
        right: 24px;
      }

      .popup-notify__link {
        background-color: #FF6B98;
        color: #ffffff;
        -webkit-border-radius: 10px;
        -moz-border-radius: 10px;
        border-radius: 10px;
        font-size: 16px;
        text-transform: uppercase;
        padding: 13px 22px;
        display: block;
        line-height: 1;
        font-weight: bold;
      }

    </style>
{% endif %}
<!-- end: popup-notify -->

{% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
{% endfor %}
{% for script in scripts %}
    <script src="{{ script }}" type="text/javascript"></script>
{% endfor %}

