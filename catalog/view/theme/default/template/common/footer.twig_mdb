</section>
</main>

{% if current_route != 'checkout/simplecheckout' %}
    <footer class="footer">
        <div class="footer__top">
            <div class="container">
                <div class="footer__content">
                    <div class="footer__inners">
                        <div class="footer__inner">

                            {% if home == og_url %}
                                <img src="image/catalog/site/logo-white.svg" title="{{ name }}" alt="{{ name }}"
                                     class="footer__logo"/>
                            {% else %}
                                <a href="{{ home }}" class="footer__logo"><img src="image/catalog/site/logo-white.svg"
                                                                               title="{{ name }}" alt="{{ name }}"
                                                                               class="img-responsive"/></a>
                            {% endif %}

                            <a href="tel:{{ telephone|replace({'(': "", ")" : "", " " : "", "-" : ""}) }}"
                               class="footer__phone binct-phone-number-1">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <g clip-path="url(#clip0_1509_604)">
                                        <path
                                                d="M13.8501 10.6173C13.3289 9.63213 11.5192 8.56387 11.4395 8.51715C11.207 8.38479 10.9643 8.31471 10.7372 8.31471C10.3995 8.31471 10.1231 8.4694 9.95572 8.75074C9.69099 9.06737 9.36268 9.43747 9.283 9.49483C8.66634 9.91321 8.1836 9.86571 7.64947 9.33158L4.66841 6.35027C4.13766 5.81951 4.08886 5.3308 4.50438 4.71752C4.56252 4.63732 4.93262 4.30874 5.24926 4.04375C5.45118 3.92359 5.58977 3.74503 5.6505 3.52598C5.73122 3.23451 5.67179 2.89167 5.48129 2.55764C5.43639 2.48082 4.36761 0.670798 3.38292 0.149905C3.19917 0.0525787 2.99206 0.00119019 2.78443 0.00119019C2.44236 0.00119019 2.12053 0.134593 1.87864 0.376223L1.21993 1.03467C0.178146 2.0762 -0.198963 3.25684 0.0984675 4.54362C0.346586 5.61604 1.06966 6.75722 2.24796 7.93527L6.06447 11.7518C7.55577 13.2431 8.97752 13.9994 10.2903 13.9994C10.2903 13.9994 10.2903 13.9994 10.2905 13.9994C11.256 13.9994 12.1561 13.589 12.9651 12.7801L13.6235 12.1216C14.0237 11.7217 14.1146 11.1169 13.8501 10.6173Z"
