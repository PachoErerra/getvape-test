    <div id="nts_fixed_contact_substrate"></div>
    <div id="nts_fixed_contact_button" class="d-flex align-items-center justify-content-center">
        <div class="nts-fixed-contact-pulsation"></div>

        <div class="nts-fixed-contact-icon text-center d-flex align-items-center justify-content-center">
            <svg class="nts-envelope" width="24" height="24" viewBox="0 0 24 24">
                <use href="#icon-envelope"></use>
            </svg>
            <span class="nts-fixed-contact-text d-none">Зворотній <br> зв'язок</span>
