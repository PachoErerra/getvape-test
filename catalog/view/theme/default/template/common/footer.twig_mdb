        <div class="nts-fixed-contact-dropdown d-flex flex-column align-items-start">
            <a rel="noopener noreferrer" href="https://t.me/vapors_vape_shop" target="_blank"
               class="nts-fixed-contact-item d-flex align-items-center">
            <span class="nts-fixed-contact-item-icon nts-fixed-contact-telegram d-flex align-items-center justify-content-center">
                <svg width="24" height="24" viewBox="0 0 18 18"><use href="#icon-telegram"></use></svg>
            </span>
                <span>Написати в Telegram</span>
            </a>

            <a rel="noopener noreferrer" href="https://api.whatsapp.com/send?phone=380637812233" target="_blank"
               class="nts-fixed-contact-item d-flex align-items-center">
            <span class="nts-fixed-contact-item-icon nts-fixed-contact-telegram d-flex align-items-center justify-content-center">
                <svg width="24" height="24">
                    <use href="catalog/view/theme/default/image/sprites/sprites.svg?v={{ sprite_version }}#icon-whatsapp"></use>
                </svg>
            </span>
                <span>Написати у WhatsApp</span>
            </a>

            <a rel="noopener noreferrer" href="https://t.me/Vapors_GetVape_bot" target="_blank"
               class="nts-fixed-contact-item d-flex align-items-center">
            <span class="nts-fixed-contact-item-icon nts-fixed-contact-telegram d-flex align-items-center justify-content-center">
                <svg width="24" height="24" viewBox="0 0 18 18"><use href="#icon-telegram"></use></svg>
            </span>
                <span>Чат бот</span>
            </a>


            <div class="nts-fixed-contact-item d-flex align-items-center">
            <span class="nts-fixed-contact-item-icon nts-fixed-contact-call d-flex align-items-center justify-content-center">
                  <svg class="icon-phone" width="24" height="24" viewBox="0 0 14 14"><use
                              href="#icon-phone"></use></svg>
            </span>
                <a
                        href="tel:{{ telephone|replace({'(': "", ")" : "", " " : "", "-" : ""}) }}"
                        class="binct-phone-number-1">{{ telephone }}</a>
            </div>

            <div class="nts-fixed-contact-item d-flex align-items-center"
                 onclick="jQuery('#bingc-phone-button-tooltip').trigger('click')">
            <span class="nts-fixed-contact-item-icon nts-fixed-contact-call d-flex align-items-center justify-content-center">
                  <svg width="24" height="24" viewBox="0 0 24 24"><use href="#icon-headset"></use></svg>
            </span>
                <span>Замовити дзвінок</span>
            </div>

            {% if instagram %}
                <a rel="noopener noreferrer" href="{{ instagram }}" target="_blank"
                   class="nts-fixed-contact-item d-flex align-items-center">
            <span class="nts-fixed-contact-item-icon nts-fixed-contact-instagram d-flex align-items-center justify-content-center">
                <svg width="24" height="24" viewBox="0 0 24 24"><use href="#icon-instagram"></use></svg>
            </span>
                    <span>Instagram</span>
                </a>
            {% endif %}
        </div>

    </div>

    <!--TODO: scroll to TOP-->
