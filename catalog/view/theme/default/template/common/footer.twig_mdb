                                {{ telephone }}</a>
                            <ul class="footer__social">
                                {% if tiktok %}
                                    <li>
                                        <a href="{{ tiktok }}" target="_blank" rel="nofollow" aria-label="tiktok"
                                           class="icon-tiktok"></a>
                                    </li>
                                {% endif %}
                                {% if instagram %}
                                    <li>
                                        <a href="{{ instagram }}" target="_blank" rel="nofollow" aria-label="instagram"
                                           class="icon-instagram"></a>
                                    </li>
                                {% endif %}
                                {% if youtube %}
                                    <li>
                                        <a href="{{ youtube }}" target="_blank" rel="nofollow" aria-label="youtube"
                                           class="icon-youtube"></a>
                                    </li>
                                {% endif %}
                                {% if telegram %}
                                    <li>
                                        <a href="{{ telegram }}" target="_blank" rel="nofollow" aria-label="telegram"
                                           class="icon-telegram"></a>
                                    </li>
                                {% endif %}
                            </ul>

