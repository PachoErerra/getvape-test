            if (device.mobile() || device.tablet() || $('html').hasClass('no-csstransitions')) {
            } else if (device.desktop()) {
              activateAnim();
              snowInterval = setInterval(function () {
                activateAnim();
              }, +elemDelay + +elemSpeed);
            }
            if (s.timeout != 0) {
              setTimeout(function () {
                clearInterval(snowInterval);
                $('.sf-snow-flake').fadeOut(1500, function () {
                  $(this).remove();
                })
              }, s.timeout * 1000);
            }
          });
        };
