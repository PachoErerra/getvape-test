                <svg width="800px" height="800px" viewBox="-4.5 0 21 21" xmlns="http://www.w3.org/2000/svg">
                    <path fill="#fff" fill-rule="evenodd"
                          d="M250.766275,121 L257.307151,112.675249 C257.597723,112.30543 257.45796,112 256.989522,112 L252.837704,112 L257.385168,104.724056 C257.635505,104.323518 257.453413,104 256.979366,104 L251.265048,104 C251.024937,104 250.778118,104.178755 250.704616,104.399261 L247.106366,115.194013 C246.957416,115.640864 247.217499,116 247.686001,116 L250.837704,116 L248.837704,121 L246.310817,121 C246.033476,121 245.921271,121.192928 246.058538,121.42807 L247.89381,124.57193 C248.031821,124.808347 248.345798,124.884602 248.581906,124.749782 L254.275822,121.498515 C254.757992,121.223193 254.698369,121 254.1493,121 L250.766275,121 Z"
