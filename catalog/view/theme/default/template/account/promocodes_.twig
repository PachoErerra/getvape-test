            {{ column_right }}
        </div>

    </div>

</div>

<script>
  document.addEventListener('click', function(e) {
    if (e.target.closest('.codes-tab')) {
      const btn = e.target.closest('.codes-tab');
      const tab = btn.getAttribute('data-tab');


      document.querySelectorAll('.codes-tab').forEach(b => b.classList.remove('codes-tab--active'));
      btn.classList.add('codes-tab--active');


      document.querySelectorAll('.codes-content').forEach(content => {
        if (content.getAttribute('data-tab-content') === tab) {
          content.style.display = '';
        } else {
          content.style.display = 'none';
        }
      });
    }
  });
</script>

{{ footer }}

{% if error_warning %}
    <input type="hidden" class="js-open-toast">


    <script>
      $(document).ready(function () {
        $('.toast').addClass('toast-danger');
        $('.toast .p').text('{{ error_warning }}');
        $(".js-open-toast").trigger('click');
      });
    </script>
{% endif %}