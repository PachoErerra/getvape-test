                                        <b>{{ text_minimalna_suma_zamovlennya_vid_500 }}</b>
                                    </div>

                                    <div class="code-info">
                                        <span>{{ text_diysnyy_do }}</span>
                                        <b>25.09.25</b>
                                    </div>
                                </div>
                            </div>
                            <!--/code-item-->
                        </div>
                    </div>

                    <div class="profile__inner codes-content" style="display: none;" data-tab-content="2">
                        <div class="profile__inner-title">{{ text_neaktyvni_promokody }}</div>

                        <div class="codes-list">
                            <!--code-item-->
