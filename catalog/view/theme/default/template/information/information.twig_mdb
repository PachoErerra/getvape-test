{{ header }}
<div id="information-information" class="container">
<div class="profile__content">
  <div class="profile__holder">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="profile__lside text-content">{{ content_top }}
	  
	    <h1 class="h1 color-black" style="display: block !important;">{{ heading_title }}</h1>
		<div class="profile__inners">
          <div class="profile__faq">
             {{ description }}
          </div>
        </div>

      {{ content_bottom }}</div>{{ column_right }}
    </div>
</div>
</div>
{{ footer }}


