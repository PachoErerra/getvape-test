{{ header }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Exo+2:wght@500;600;700&display=swap" rel="stylesheet">
{% set art = {
 'hoodie':'<path d="M38 22c4 8 14 12 22 12s18-4 22-12l18 8 14 30-14 6v42H20V66L6 60l14-30z"/><path d="M38 22c-2 10 6 22 22 22s24-12 22-22"/><path d="M44 80h32v14H44z"/><path d="M52 40v10M68 40v10"/>',
 'tee':'<path d="M40 18c4 7 11 10 20 10s16-3 20-10l20 10 12 22-16 8v50H24V58L8 50l12-22z"/><path d="M40 18c2 6 10 10 20 10s18-4 20-10"/><path d="M50 60c0-6 5-10 10-10s10 4 10 10c4 0 7 3 7 7s-3 7-7 7H50c-4 0-7-3-7-7s3-7 7-7z"/>',
 'cap':'<path d="M18 74c0-26 18-44 42-44s42 18 42 44"/><path d="M18 74h84"/><path d="M18 74c-6 0-12 6-10 12 12 4 34 4 52 0"/><path d="M60 30v-4"/><path d="M60 30c-8 10-10 28-8 44M60 30c8 10 10 28 8 44"/><path d="M48 56c0-4 3-7 7-7 2-4 9-4 11 0 4 0 6 3 6 6s-3 6-6 6H54c-3 0-6-2-6-5z"/>',
 'socks':'<path d="M34 14h24v46l18 22c6 8 2 20-8 22-6 2-12 0-16-4L28 74c-4-4-6-8-6-14V14z" transform="translate(4 0)"/><path d="M38 26h24"/><path d="M38 34h24"/><path d="M66 14h22v40l14 16c5 7 2 16-6 18" opacity=".6"/>',
 'tote':'<path d="M24 44h72l-6 62H30z"/><path d="M42 44c0-16 6-26 18-26s18 10 18 26"/><path d="M46 74c0-6 5-10 10-10 3-5 12-5 14 0 5 0 8 3 8 8s-3 8-8 8H54c-5 0-8-3-8-6z"/>',
 'mug':'<path d="M24 34h56v56c0 10-8 16-16 16H40c-8 0-16-6-16-16z"/><path d="M80 46h10c8 0 12 6 12 14s-4 14-12 14H80"/><path d="M40 24c0-6 6-6 6-12M52 24c0-6 6-6 6-12M64 24c0-6 6-6 6-12"/><path d="M38 66c0-5 4-8 8-8 2-4 9-4 11 0 4 0 7 3 7 7s-3 7-7 7H44c-4 0-6-3-6-6z"/>',
 'keychain':'<circle cx="60" cy="22" r="10"/><path d="M60 32v10"/><path d="M34 74c0-10 8-18 18-18 4-8 18-10 24-2 10 0 18 8 18 18s-8 18-18 18H48c-8 0-14-7-14-16z"/><path d="M50 74h20" opacity=".6"/>',
 'stickers':'<rect x="18" y="26" width="52" height="52" rx="10" transform="rotate(-10 44 52)"/><rect x="48" y="44" width="54" height="54" rx="27"/><path d="M60 72c0-5 4-8 8-8 2-4 9-4 11 0 4 0 7 3 7 7s-3 7-7 7H66c-4 0-6-3-6-6z"/><path d="M28 40l20 30" opacity=".6"/>'
} %}
{% set rar = {'common':'Звичайний','rare':'Рідкісний','epic':'Епічний','legendary':'Легендарний'} %}
<main class="us">
  <div class="us-bg" aria-hidden="true"><i class="us-grid"></i><i class="us-sun"></i><i class="us-scan"></i></div>
  <div class="us-in">
    <header class="us-hud">
      <div class="us-title">
        <span class="us-kicker">// VAPORS · SEASON 01</span>
        <h1 data-text="УЛЬТРА-МАГАЗИН">УЛЬТРА-МАГАЗИН</h1>
        <p>Обмінюй ультравалюту з Battle Pass на мерч Vapors. Вітрина оновлюється щосезону.</p>
      </div>
      <div class="us-wallet">
        <div class="us-wallet-l">Твій баланс</div>
        {% if logged %}
          <div class="us-wallet-v"><svg viewBox="0 0 24 24" class="us-uc"><path d="M12 2 21 7v10l-9 5-9-5V7z"/><path d="M12 6l5 3v6l-5 3-5-3V9z"/></svg><b id="usBal">{{ balance }}</b><span>UC</span></div>
          <div class="us-wallet-s">Гравець: {{ name }}</div>
        {% else %}
          <div class="us-wallet-v"><svg viewBox="0 0 24 24" class="us-uc"><path d="M12 2 21 7v10l-9 5-9-5V7z"/><path d="M12 6l5 3v6l-5 3-5-3V9z"/></svg><b>—</b><span>UC</span></div>
          <a class="us-btn us-btn-sm" href="{{ login }}">Увійти, щоб бачити баланс</a>
        {% endif %}
      </div>
    </header>

    <nav class="us-tabs" role="tablist">
      <button class="on" data-f="all">Усе</button><button data-f="wear">Одяг</button><button data-f="acc">Аксесуари</button><button data-f="legendary">Легендарне</button>
      <span class="us-timer">Оновлення вітрини через <b id="usTimer">--:--:--</b></span>
    </nav>

    <section class="us-grid-items">
      {% for it in items %}
      <article class="us-card r-{{ it.rarity }}{% if loop.first %} us-feat{% endif %}" data-cat="{{ it.cat }}" data-r="{{ it.rarity }}" data-id="{{ it.id }}" data-price="{{ it.price }}" data-name="{{ it.name }}">
        <div class="us-card-in">
          <span class="us-rar">{{ rar[it.rarity] }}</span>
          <span class="us-stock">Залишилось: {{ it.stock }}</span>
          <div class="us-art"><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">{{ art[it.id]|raw }}</svg><i class="us-plat"></i></div>
          <h3>{{ it.name }}</h3>
          <p>{{ it.desc }}</p>
          <div class="us-buy">
            <span class="us-price"><svg viewBox="0 0 24 24" class="us-uc"><path d="M12 2 21 7v10l-9 5-9-5V7z"/><path d="M12 6l5 3v6l-5 3-5-3V9z"/></svg>{{ it.price }}</span>
            <button class="us-btn js-us-buy">Обміняти</button>
          </div>
        </div>
      </article>
      {% endfor %}
      <article class="us-card us-mystery" data-cat="none" data-r="none">
        <div class="us-card-in">
          <span class="us-rar">???</span>
          <div class="us-art"><span class="us-q">?</span><i class="us-plat"></i></div>
          <h3>Секретний дроп</h3>
          <p>Новий предмет з'явиться в наступному сезоні. Збирай UC заздалегідь.</p>
          <div class="us-buy"><span class="us-price">??</span><button class="us-btn" disabled>Скоро</button></div>
        </div>
      </article>
    </section>

    <section class="us-how">
      <h2>Як отримати ультравалюту</h2>
      <div class="us-steps">
        <div><b>01</b><span>Купуй у Vapors і проходь рівні Battle Pass</span></div>
        <div><b>02</b><span>Забирай нагороди сезону та виграші в лотереї</span></div>
        <div><b>03</b><span>Обмінюй UC тут на мерч — заберіть у магазині або отримайте з наступним замовленням</span></div>
      </div>
    </section>
  </div>

  <div class="us-modal" id="usModal" hidden>
    <div class="us-modal-box">
      <div class="us-modal-t" id="usMT"></div>
      <div class="us-modal-p" id="usMP"></div>
      <div class="us-modal-a" id="usMA"></div>
    </div>
  </div>
</main>

<style>
.us{--bg:#07050d;--pink:#ff2fa0;--cyan:#22e6ff;--violet:#8b5cf6;--gold:#ffc23d;--txt:#efeaff;position:relative;overflow:hidden;background:var(--bg);color:var(--txt);font-family:"Exo 2",Montserrat,Arial,sans-serif;isolation:isolate;margin-top:-1px}
.us *{box-sizing:border-box}
.us-bg{position:absolute;inset:0;z-index:-1;pointer-events:none}
.us-grid{position:absolute;left:-50%;right:-50%;bottom:-10%;height:70%;background-image:linear-gradient(rgba(255,47,160,.35) 1px,transparent 1px),linear-gradient(90deg,rgba(34,230,255,.28) 1px,transparent 1px);background-size:56px 56px;transform:perspective(500px) rotateX(62deg);transform-origin:top;animation:usGrid 6s linear infinite;-webkit-mask-image:linear-gradient(transparent,#000 40%);mask-image:linear-gradient(transparent,#000 40%)}
@keyframes usGrid{to{background-position:0 56px,0 0}}
.us-sun{position:absolute;left:50%;top:6%;width:620px;height:620px;margin-left:-310px;border-radius:50%;background:radial-gradient(circle,rgba(255,47,160,.35),rgba(139,92,246,.15) 45%,transparent 70%);filter:blur(10px)}
.us-scan{position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 3px)}
.us-in{max-width:1200px;margin:0 auto;padding:46px 16px 70px}
.us-hud{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:28px}
.us-kicker{font:700 13px Unbounded,sans-serif;letter-spacing:3px;color:var(--cyan)}
.us h1{position:relative;margin:8px 0 10px;font:900 clamp(34px,6vw,64px)/1 Unbounded,sans-serif;letter-spacing:2px;background:linear-gradient(90deg,#fff,#ffc4e6 40%,var(--pink));-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 30px rgba(255,47,160,.35)}
.us h1::before,.us h1::after{content:attr(data-text);position:absolute;inset:0;background:inherit;-webkit-background-clip:text;background-clip:text;opacity:0}
.us h1::before{color:var(--cyan);-webkit-text-fill-color:var(--cyan);animation:usGlitch 5s infinite steps(1)}
@keyframes usGlitch{0%,92%,100%{opacity:0;transform:none}93%{opacity:.7;transform:translate(-3px,1px);clip-path:inset(20% 0 55% 0)}95%{opacity:.7;transform:translate(3px,-1px);clip-path:inset(60% 0 10% 0)}}
.us-title p{margin:0;max-width:520px;font-size:18px;color:rgba(239,234,255,.72)}
.us-wallet{min-width:260px;padding:16px 20px;border:1px solid rgba(34,230,255,.4);background:linear-gradient(135deg,rgba(34,230,255,.08),rgba(255,47,160,.08));clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);box-shadow:inset 0 0 30px rgba(34,230,255,.12)}
.us-wallet-l{font:700 12px Unbounded,sans-serif;letter-spacing:2px;color:var(--cyan);text-transform:uppercase}
.us-wallet-v{display:flex;align-items:center;gap:10px;margin:6px 0 4px}
.us-wallet-v b{font:900 40px/1 Unbounded,sans-serif;color:#fff;text-shadow:0 0 18px rgba(34,230,255,.7)}
.us-wallet-v span{font:700 16px Unbounded,sans-serif;color:var(--cyan)}
.us-wallet-s{font-size:15px;color:rgba(239,234,255,.6)}
.us-uc{width:26px;height:26px;fill:none;stroke:var(--cyan);stroke-width:1.8;filter:drop-shadow(0 0 6px var(--cyan))}
.us-tabs{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:24px}
.us-tabs button{padding:10px 18px;border:1px solid rgba(239,234,255,.18);background:rgba(255,255,255,.03);color:var(--txt);font:700 14px Unbounded,sans-serif;letter-spacing:1px;cursor:pointer;clip-path:polygon(10px 0,100% 0,calc(100% - 10px) 100%,0 100%);transition:background .2s,color .2s,border-color .2s}
.us-tabs button:hover{border-color:var(--pink)}
.us-tabs button.on{background:var(--pink);border-color:var(--pink);color:#fff;box-shadow:0 0 20px rgba(255,47,160,.5)}
.us-timer{margin-left:auto;font-size:15px;color:rgba(239,234,255,.6)}.us-timer b{font:700 16px Unbounded,sans-serif;color:var(--gold)}
.us-grid-items{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.us-card{--rc:#9aa3b5;position:relative;padding:1px;background:linear-gradient(160deg,var(--rc),transparent 40%,transparent 60%,var(--rc));clip-path:polygon(18px 0,100% 0,100% calc(100% - 18px),calc(100% - 18px) 100%,0 100%,0 18px);transition:transform .35s cubic-bezier(.2,.8,.2,1),filter .35s}
.us-card.r-rare{--rc:var(--cyan)}.us-card.r-epic{--rc:var(--violet)}.us-card.r-legendary{--rc:var(--gold)}
.us-card-in{position:relative;height:100%;display:flex;flex-direction:column;padding:16px;background:linear-gradient(180deg,#130d22,#0b0714);clip-path:inherit;overflow:hidden}
.us-card-in::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.12) 48%,transparent 60%);transform:translateX(-120%);transition:transform .9s;pointer-events:none}
.us-card:hover{transform:translateY(-6px);filter:drop-shadow(0 0 16px color-mix(in srgb,var(--rc) 55%,transparent))}
.us-card:hover .us-card-in::after{transform:translateX(120%)}
.us-rar{align-self:flex-start;padding:4px 10px;font:700 11px Unbounded,sans-serif;letter-spacing:1.5px;text-transform:uppercase;color:#0b0714;background:var(--rc)}
.us-stock{position:absolute;top:18px;right:16px;font-size:13px;color:rgba(239,234,255,.5)}
.us-art{position:relative;display:grid;place-items:center;height:170px;margin:8px 0 6px;color:var(--rc)}
.us-art svg{width:130px;height:130px;filter:drop-shadow(0 0 8px var(--rc)) drop-shadow(0 0 22px color-mix(in srgb,var(--rc) 50%,transparent));animation:usFloat 4s ease-in-out infinite}
.us-card:nth-child(2n) .us-art svg{animation-delay:-2s}
@keyframes usFloat{50%{transform:translateY(-8px) rotate(-2deg)}}
.us-plat{position:absolute;bottom:4px;width:130px;height:18px;border-radius:50%;border:1px solid var(--rc);box-shadow:0 0 20px var(--rc),inset 0 0 12px var(--rc);opacity:.55}
.us-card h3{margin:4px 0 4px;font:800 17px/1.2 Unbounded,sans-serif;color:#fff;letter-spacing:.5px}
.us-card p{margin:0 0 14px;font-size:15px;line-height:1.35;color:rgba(239,234,255,.62);flex:1}
.us-buy{display:flex;align-items:center;justify-content:space-between;gap:10px}
.us-price{display:flex;align-items:center;gap:6px;font:900 24px Unbounded,sans-serif;color:#fff}
.us-price .us-uc{width:22px;height:22px}
.us-btn{display:inline-block;padding:11px 18px;border:0;background:linear-gradient(90deg,var(--pink),#c026d3);color:#fff;font:800 13px Unbounded,sans-serif;letter-spacing:1px;text-transform:uppercase;text-decoration:none;cursor:pointer;clip-path:polygon(10px 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%,0 10px);box-shadow:0 0 18px rgba(255,47,160,.45);transition:filter .2s,transform .2s}
.us-btn:hover{filter:brightness(1.15);transform:translateY(-1px);color:#fff}
.us-btn-sm{padding:8px 12px;font-size:11px;margin-top:6px}
.us-btn.ghost{background:transparent;border:1px solid rgba(239,234,255,.3);box-shadow:none}
.us-card.locked .us-btn{background:#2a2238;box-shadow:none;color:rgba(239,234,255,.55)}
.us-feat{grid-column:span 2;grid-row:span 2}
.us-feat .us-art{height:auto;flex:1;min-height:300px}.us-feat .us-art svg{width:260px;height:260px}.us-feat .us-plat{width:240px;height:30px}
.us-feat h3{font-size:26px}.us-feat .us-price{font-size:34px}.us-feat p{flex:0;font-size:17px}
.us-feat .us-card-in{background:radial-gradient(80% 60% at 50% 40%,rgba(255,194,61,.12),transparent 70%),linear-gradient(180deg,#1a1222,#0b0714)}
.us-card.hide{display:none}
.us-mystery{--rc:#ff2fa0}.us-mystery .us-card-in{background:repeating-linear-gradient(135deg,rgba(255,47,160,.06) 0 10px,transparent 10px 20px),linear-gradient(180deg,#130d22,#0b0714)}
.us-q{font:900 96px/1 Unbounded,sans-serif;color:transparent;-webkit-text-stroke:2px var(--pink);filter:drop-shadow(0 0 12px var(--pink));animation:usFloat 3s ease-in-out infinite}
.us-mystery .us-btn{background:#2a2238;box-shadow:none;color:rgba(239,234,255,.5);cursor:default}
.us-how{margin-top:46px;padding:24px;border:1px solid rgba(239,234,255,.12);background:rgba(255,255,255,.02)}
.us-how h2{margin:0 0 16px;font:800 20px Unbounded,sans-serif;color:#fff}
.us-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.us-steps div{display:flex;gap:12px;align-items:flex-start;font-size:16px;color:rgba(239,234,255,.75)}
.us-steps b{font:900 26px/1 Unbounded,sans-serif;color:var(--pink);text-shadow:0 0 12px rgba(255,47,160,.6)}
.us-modal{position:fixed;inset:0;z-index:2000;display:grid;place-items:center;background:rgba(5,3,10,.8);backdrop-filter:blur(6px)}
.us-modal[hidden]{display:none}
.us-modal-box{width:min(420px,92vw);padding:26px;text-align:center;background:linear-gradient(180deg,#160f26,#0b0714);border:1px solid var(--pink);color:var(--txt);font-family:"Exo 2",sans-serif;clip-path:polygon(16px 0,100% 0,100% calc(100% - 16px),calc(100% - 16px) 100%,0 100%,0 16px);box-shadow:0 0 40px rgba(255,47,160,.35);animation:usPop .3s cubic-bezier(.34,1.56,.64,1)}
@keyframes usPop{from{transform:scale(.85);opacity:0}}
.us-modal-t{font:900 22px Unbounded,sans-serif;color:#fff;margin-bottom:8px}
.us-modal-p{font-size:17px;color:rgba(239,234,255,.75);margin-bottom:18px}
.us-modal-a{display:flex;gap:10px;justify-content:center}
@media (max-width:1100px){.us-grid-items{grid-template-columns:repeat(3,1fr)}}
@media (max-width:820px){.us-grid-items{grid-template-columns:repeat(2,1fr)}.us-steps{grid-template-columns:1fr}.us-timer{margin-left:0;width:100%}}
@media (max-width:520px){.us-grid-items{grid-template-columns:1fr 1fr;gap:10px}.us-feat{grid-column:span 2;grid-row:auto}.us-feat .us-art{min-height:200px}.us-feat .us-art svg{width:170px;height:170px}
 .us-card-in{padding:12px}.us-art{height:120px}.us-art svg{width:90px;height:90px}.us-plat{width:90px}.us-card h3{font-size:14px}.us-card p{display:none}.us-buy{flex-direction:column;align-items:stretch}.us-price{font-size:20px}.us-btn{text-align:center;padding:10px}.us-wallet{width:100%}}
@media (prefers-reduced-motion:reduce){.us *{animation:none!important}}
</style>
<script>
(function(){
  var root=document.querySelector('.us');if(!root)return;
  var cards=[].slice.call(root.querySelectorAll('.us-card')),bal={{ logged ? balance : 'null' }};
  function lock(){cards.forEach(function(c){c.classList.toggle('locked',bal!==null&&bal<+c.dataset.price)})}
  lock();
  root.querySelectorAll('.us-tabs button').forEach(function(b){b.onclick=function(){
    root.querySelectorAll('.us-tabs button').forEach(function(x){x.classList.toggle('on',x===b)});
    var f=b.dataset.f;cards.forEach(function(c){c.classList.toggle('hide',!(f==='all'||c.dataset.cat===f||c.dataset.r===f))});
  }});
  // відлік до кінця місяця
  var tm=document.getElementById('usTimer');
  function tick(){var n=new Date(),e=new Date(n.getFullYear(),n.getMonth()+1,1),s=Math.max(0,(e-n)/1000|0),d=s/86400|0,h=(s%86400)/3600|0,m=(s%3600)/60|0,ss=s%60;
    tm.textContent=(d?d+'д ':'')+String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(ss).padStart(2,'0')}
  tick();setInterval(tick,1000);
  var mod=document.getElementById('usModal');
  function show(t,p,a){document.getElementById('usMT').textContent=t;document.getElementById('usMP').textContent=p;var A=document.getElementById('usMA');A.innerHTML='';a.forEach(function(x){A.appendChild(x)});mod.hidden=false}
  function btn(t,cls,fn){var b=document.createElement(fn?'button':'a');b.className='us-btn '+(cls||'');b.textContent=t;if(fn)b.onclick=fn;else b.href=cls==='login'?'{{ login }}':'#';return b}
  mod.onclick=function(e){if(e.target===mod)mod.hidden=true};
  document.addEventListener('keydown',function(e){if(e.key==='Escape')mod.hidden=true});
  root.querySelectorAll('.js-us-buy').forEach(function(b){b.onclick=function(){
    var c=b.closest('.us-card'),price=+c.dataset.price,name=c.dataset.name;
    if(bal===null){var l=document.createElement('a');l.className='us-btn';l.href='{{ login }}';l.textContent='Увійти';show('Потрібен вхід','Увійди в акаунт, щоб обміняти ультравалюту.',[l,btn('Закрити','ghost',function(){mod.hidden=true})]);return}
    if(bal<price){show('Не вистачає UC','Потрібно '+price+' UC, у тебе '+bal+'. Проходь Battle Pass, щоб заробити більше.',[btn('Зрозуміло','',function(){mod.hidden=true})]);return}
    show('Обміняти?',name+' за '+price+' UC. Після обміну баланс: '+(bal-price)+' UC.',[btn('Так, обміняти','',function(){
      var x=new XMLHttpRequest();x.open('POST','{{ buy_url|replace({'&amp;':'&'}) }}');x.setRequestHeader('Content-Type','application/x-www-form-urlencoded');
      x.onload=function(){var r={};try{r=JSON.parse(x.responseText)}catch(e){}
        if(r.success){bal=r.balance;var e=document.getElementById('usBal');if(e)e.textContent=bal;lock();show('Предмет твій!','Замовлення №'+r.order+'. Ми зв\'яжемося з тобою, щоб передати мерч.',[btn('Супер','',function(){mod.hidden=true})])}
        else show('Не вдалося',r.error==='login'?'Увійди в акаунт.':(r.error||'Спробуй ще раз.'),[btn('Закрити','ghost',function(){mod.hidden=true})])};
      x.send('item='+encodeURIComponent(c.dataset.id))}),btn('Ні','ghost',function(){mod.hidden=true})]);
  }});
})();
</script>
{{ footer }}
