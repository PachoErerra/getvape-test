.us-tabs{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:24px}
.us-tabs button{padding:10px 18px;border:1px solid rgba(239,234,255,.18);background:rgba(255,255,255,.03);color:var(--txt);font:700 14px Unbounded,sans-serif;letter-spacing:1px;cursor:pointer;clip-path:polygon(10px 0,100% 0,calc(100% - 10px) 100%,0 100%);transition:background .2s,color .2s,border-color .2s}
