{{ header }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Exo+2:wght@500;600;700&display=swap" rel="stylesheet">
{% set art = {
 'bomber':'<path d="M38 20c6 6 14 8 22 8s16-2 22-8l20 8 12 30-14 6v44c0 4-3 6-6 6H26c-3 0-6-2-6-6V64L6 58l12-30z"/><path d="M38 20c4 8 12 12 22 12s18-4 22-12"/><path d="M60 32v74"/><path d="M20 100h80"/><path d="M44 54l-8 14h10l-6 14" stroke-width="2"/><path d="M76 54l-8 14h10l-6 14" stroke-width="2"/>',
 'sign':'<rect x="10" y="26" width="100" height="64" rx="10"/><path d="M30 66c0-7 5-11 11-11 3-6 13-7 17-1 6 0 11 4 11 11s-5 10-11 10H40c-6 0-10-4-10-9z"/><path d="M76 50h20M76 60h16M76 70h20"/><path d="M30 26 46 8M90 26 74 8"/><circle cx="60" cy="8" r="3"/>',
 'hoodie':'<path d="M38 22c4 8 14 12 22 12s18-4 22-12l18 8 14 30-14 6v42H20V66L6 60l14-30z"/><path d="M38 22c-2 10 6 22 22 22s24-12 22-22"/><path d="M44 80h32v14H44z"/><path d="M52 40v10M68 40v10"/>',
 'tee':'<path d="M40 18c4 7 11 10 20 10s16-3 20-10l20 10 12 22-16 8v50H24V58L8 50l12-22z"/><path d="M40 18c2 6 10 10 20 10s18-4 20-10"/><path d="M50 60c0-6 5-10 10-10s10 4 10 10c4 0 7 3 7 7s-3 7-7 7H50c-4 0-7-3-7-7s3-7 7-7z"/>',
 'cap':'<path d="M18 74c0-26 18-44 42-44s42 18 42 44"/><path d="M18 74h84"/><path d="M18 74c-6 0-12 6-10 12 12 4 34 4 52 0"/><path d="M60 30v-4"/><path d="M60 30c-8 10-10 28-8 44M60 30c8 10 10 28 8 44"/><path d="M48 56c0-4 3-7 7-7 2-4 9-4 11 0 4 0 6 3 6 6s-3 6-6 6H54c-3 0-6-2-6-5z"/>',
 'socks':'<path d="M34 14h24v46l18 22c6 8 2 20-8 22-6 2-12 0-16-4L28 74c-4-4-6-8-6-14V14z" transform="translate(4 0)"/><path d="M38 26h24"/><path d="M38 34h24"/><path d="M66 14h22v40l14 16c5 7 2 16-6 18" opacity=".6"/>',
 'tote':'<path d="M24 44h72l-6 62H30z"/><path d="M42 44c0-16 6-26 18-26s18 10 18 26"/><path d="M46 74c0-6 5-10 10-10 3-5 12-5 14 0 5 0 8 3 8 8s-3 8-8 8H54c-5 0-8-3-8-6z"/>',
 'mug':'<path d="M24 34h56v56c0 10-8 16-16 16H40c-8 0-16-6-16-16z"/><path d="M80 46h10c8 0 12 6 12 14s-4 14-12 14H80"/><path d="M40 24c0-6 6-6 6-12M52 24c0-6 6-6 6-12M64 24c0-6 6-6 6-12"/><path d="M38 66c0-5 4-8 8-8 2-4 9-4 11 0 4 0 7 3 7 7s-3 7-7 7H44c-4 0-6-3-6-6z"/>',
 'keychain':'<circle cx="60" cy="22" r="10"/><path d="M60 32v10"/><path d="M34 74c0-10 8-18 18-18 4-8 18-10 24-2 10 0 18 8 18 18s-8 18-18 18H48c-8 0-14-7-14-16z"/><path d="M50 74h20" opacity=".6"/>',
 'stickers':'<rect x="18" y="26" width="52" height="52" rx="10" transform="rotate(-10 44 52)"/><rect x="48" y="44" width="54" height="54" rx="27"/><path d="M60 72c0-5 4-8 8-8 2-4 9-4 11 0 4 0 7 3 7 7s-3 7-7 7H66c-4 0-6-3-6-6z"/><path d="M28 40l20 30" opacity=".6"/>'
} %}
{% set rar = {'rare':'Рідкісний','epic':'Епічний','mythic':'Міфічний','legendary':'Легендарний'} %}
<main class="us">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <linearGradient id="ucG" x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse"><stop stop-color="#7df9ff"/><stop offset=".5" stop-color="#b56bff"/><stop offset="1" stop-color="#ff2fa0"/></linearGradient>
  <radialGradient id="ucIn" cx=".35" cy=".3" r=".8"><stop stop-color="#3a1d63"/><stop offset="1" stop-color="#0d0618"/></radialGradient>
  <symbol id="ucIcon" viewBox="0 0 32 32"><circle cx="16" cy="16" r="14" fill="url(#ucIn)" stroke="url(#ucG)" stroke-width="2.4"/><circle cx="16" cy="16" r="10.2" fill="none" stroke="url(#ucG)" stroke-opacity=".5" stroke-width="1" stroke-dasharray="1.6 1.6"/><path d="M11.2 9.5v7a4.8 4.8 0 0 0 9.6 0v-7" fill="none" stroke="url(#ucG)" stroke-width="3" stroke-linecap="round"/><path d="M25 4.5l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9z" fill="#fff"/></symbol>
</defs></svg>

  <div class="us-bg" aria-hidden="true">
    <i class="us-glow g1"></i><i class="us-glow g2"></i><i class="us-glow g3"></i>
    <i class="us-frame"></i>
    <canvas class="us-dust"></canvas>
    <i class="us-noise"></i>
  </div>
  <div class="us-bgsw" role="group" aria-label="Варіант фону"><span>Фон</span><button data-bg="1">1</button><button data-bg="2">2</button><button data-bg="3">3</button></div>
  <div class="us-in">
    <header class="us-hud">
      <div class="us-title">
        <span class="us-kicker us-kicker-pink">// VAPORS · SEASON 01</span>
        <h1 data-text="УЛЬТРА ШОП">УЛЬТРА ШОП</h1>
        <p>Тут не купують — тут <b>вибивають</b>. Збирай ультравалюту в Battle Pass, обмінюй на мерч, якого немає в жодному магазині, або крути кейс і лови легендарний дроп.</p>
      </div>
      <div class="us-side">
        {% if logged %}
        <div class="us-prof">
          <div class="us-ava">{{ name|slice(0,1)|upper }}<b>{{ profile.level }}</b></div>
          <div class="us-prof-i">
            <div class="us-prof-n">{{ name }} <span>Рівень {{ profile.level }}</span></div>
            <div class="us-xp"><i style="width:{{ (profile.xp * 100 / profile.need)|round }}%"></i></div>
            <div class="us-prof-s">{{ profile.xp }} / {{ profile.need }} UC до наступного рівня</div>
          </div>
          <button class="us-btn us-btn-sm ghost js-us-inv">Мої предмети ({{ profile.history|length }})</button>
        </div>
        {% endif %}
        <div class="us-wallet">
          <div class="us-wallet-l">Твій баланс</div>
          <div class="us-wallet-v"><svg class="us-uc" viewBox="0 0 32 32"><use href="#ucIcon"/></svg><b id="usBal">{{ logged ? balance : '—' }}</b><span>UC</span></div>
          {% if not logged %}<a class="us-btn us-btn-sm" href="{{ login }}">Увійти, щоб бачити баланс</a>{% endif %}
        </div>
      </div>
      <button class="us-snd" id="usSnd" aria-label="Звук" title="Звук">🔊</button>
    </header>

    <section class="us-case">
      <div class="us-case-art" aria-hidden="true">
        <svg viewBox="0 0 300 300" class="us-crate">
          <defs>
            <linearGradient id="crL" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#3a2552"/><stop offset="1" stop-color="#140a22"/></linearGradient>
            <linearGradient id="crR" x1="1" y1="0" x2="0" y2="1"><stop stop-color="#241536"/><stop offset="1" stop-color="#0a0512"/></linearGradient>
            <linearGradient id="crT" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#5b3a82"/><stop offset=".5" stop-color="#3a2257"/><stop offset="1" stop-color="#241436"/></linearGradient>
            <linearGradient id="crN" x1="0" x2="1"><stop stop-color="#ff2fa0"/><stop offset="1" stop-color="#b56bff"/></linearGradient>
            <linearGradient id="crBeam" x1="0" y1="1" x2="0" y2="0"><stop stop-color="#ffd1ec" stop-opacity=".9"/><stop offset="1" stop-color="#ff2fa0" stop-opacity="0"/></linearGradient>
            <radialGradient id="crHalo"><stop stop-color="#ff2fa0" stop-opacity=".55"/><stop offset="1" stop-color="#ff2fa0" stop-opacity="0"/></radialGradient>
            <pattern id="crHaz" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="14" fill="#ffc23d"/><rect x="7" width="7" height="14" fill="#1a1022"/></pattern>
          </defs>
          <ellipse cx="150" cy="268" rx="120" ry="22" fill="url(#crHalo)" class="cr-halo"/>
          <!-- промені світла (видно при відкритті) -->
          <g class="cr-beams"><path d="M150 140 90 -20h120z" fill="url(#crBeam)"/><path d="M150 140 40 10 70 -10z" fill="url(#crBeam)" opacity=".6"/><path d="M150 140 260 10 230 -10z" fill="url(#crBeam)" opacity=".6"/></g>
          <!-- корпус -->
          <path d="M40 120 150 175v95L40 215z" fill="url(#crL)"/>
          <path d="M150 175 260 120v95l-110 55z" fill="url(#crR)"/>
          <!-- смуги-попередження -->
          <path d="M40 200 150 255v15L40 215z" fill="url(#crHaz)" opacity=".9"/>
          <path d="M150 255 260 200v15l-110 55z" fill="url(#crHaz)" opacity=".7"/>
          <!-- панелі -->
          <path d="M58 140 132 177v60L58 200z" fill="none" stroke="#ffffff" stroke-opacity=".08" stroke-width="2"/>
          <path d="M168 177 242 140v60l-74 37z" fill="none" stroke="#ffffff" stroke-opacity=".08" stroke-width="2"/>
          <!-- емблема-хмаринка на лівій грані -->
          <g transform="matrix(1 .5 0 1 66 150)"><path class="cr-logo" d="M10 34c0-8 6-13 13-13 3-8 16-10 21-2 8 0 14 5 14 13s-6 13-14 13H23C15 45 10 40 10 34z" fill="none" stroke="#ff2fa0" stroke-width="3.2" stroke-linejoin="round"/></g>
          <!-- напис на правій грані -->
          <g transform="matrix(1 -.5 0 1 166 212)"><text x="0" y="0" font-family="Unbounded,Arial Black,sans-serif" font-weight="900" font-size="15" fill="#22e6ff" class="cr-text">VAPORS</text></g>
          <!-- ребра -->
          <path d="M40 120 150 175 260 120M150 175v95" fill="none" stroke="url(#crN)" stroke-width="2.5"/>
          <path d="M40 120v95l110 55 110-55v-95" fill="none" stroke="url(#crN)" stroke-width="2.5" class="cr-edge"/>
          <!-- замок -->
          <g class="cr-lock"><rect x="138" y="182" width="24" height="26" rx="4" fill="#0d0718" stroke="#22e6ff" stroke-width="2"/><circle cx="150" cy="193" r="3.5" fill="#22e6ff"/><path d="M150 196v6" stroke="#22e6ff" stroke-width="2.5"/></g>
          <!-- кришка -->
          <g class="cr-lid">
            <path d="M150 62 270 118 150 176 30 118z" fill="url(#crT)"/>
            <path d="M30 118 150 176v14L30 132z" fill="#2a1840"/><path d="M150 176 270 118v14l-120 58z" fill="#1a0f29"/>
            <path d="M150 62 270 118 150 176 30 118z" fill="none" stroke="url(#crN)" stroke-width="2.5"/>
            <path d="M30 132 150 190 270 132" fill="none" stroke="url(#crN)" stroke-width="2"/>
            <path d="M90 90 150 118 210 90" fill="none" stroke="#ffffff" stroke-opacity=".12" stroke-width="2"/>
            <path d="M150 74 238 117 150 160 62 117z" fill="none" stroke="#ff2fa0" stroke-opacity=".35" stroke-dasharray="4 6"/>
          </g>
          <!-- іскри -->
          <g class="cr-sparks"><circle cx="60" cy="70" r="2.5" fill="#22e6ff"/><circle cx="245" cy="60" r="2" fill="#ff2fa0"/><circle cx="270" cy="170" r="2.5" fill="#ffc23d"/><circle cx="30" cy="180" r="2" fill="#b56bff"/><path d="M220 30l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" fill="#ffc23d"/></g>
        </svg>
      </div>
      <div class="us-case-i">
        <span class="us-kicker">// LOOTBOX</span>
        <h2>Кейс Vapors</h2>
        <p>Випадковий предмет з вітрини. Крутиш рулетку — і доля вирішує. Пощастить — забереш легендарний бомбер, якого всього 3 штуки на сезон.</p>
        <ul class="us-odds">
          <li class="r-rare"><i></i>Рідкісний <b>70%</b></li><li class="r-epic"><i></i>Епічний <b>22%</b></li>
          <li class="r-mythic"><i></i>Міфічний <b>6,5%</b></li><li class="r-legendary"><i></i>Легендарний <b>1,5%</b></li>
        </ul>
        <div class="us-buy"><span class="us-price"><svg class="us-uc" viewBox="0 0 32 32"><use href="#ucIcon"/></svg>{{ case_price }}</span><button class="us-btn us-btn-lg js-us-case">Відкрити кейс</button></div>
      </div>
    </section>

    <nav class="us-tabs" role="tablist">
      <button class="on" data-f="all">Усе</button><button data-f="wear">Одяг</button><button data-f="acc">Аксесуари</button><button data-f="mythic">Міфічне</button><button data-f="legendary">Легендарне</button>
      <span class="us-timer">Оновлення вітрини через <b id="usTimer">--:--:--</b></span>
    </nav>

    <section class="us-grid-items">
      {% for it in items %}
      <article class="us-card r-{{ it.rarity }}{% if loop.first %} us-feat{% endif %}" data-cat="{{ it.cat }}" data-r="{{ it.rarity }}" data-id="{{ it.id }}" data-price="{{ it.price }}" data-name="{{ it.name }}" tabindex="0">
        <div class="us-card-in">
          <span class="us-rar">{{ rar[it.rarity] }}</span>
          <span class="us-stock">Залишилось: {{ it.stock }}</span>
          <div class="us-art"><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">{{ art[it.id]|raw }}</svg><i class="us-plat"></i></div>
          <h3>{{ it.name }}</h3>
          <p>{{ it.desc }}</p>
          <div class="us-buy">
            <span class="us-price"><svg class="us-uc" viewBox="0 0 32 32"><use href="#ucIcon"/></svg>{{ it.price }}</span>
            <button class="us-btn js-us-buy">Обміняти</button>
          </div>
        </div>
      </article>
      {% endfor %}
      <article class="us-card us-mystery" data-cat="none" data-r="none">
        <div class="us-card-in">
          <span class="us-rar">???</span>
          <div class="us-art"><span class="us-q">?</span><i class="us-plat"></i></div>
          <h3>Секретний дроп</h3>
          <p>Що це — знає лише команда Vapors. З'явиться в наступному сезоні. Збирай UC заздалегідь.</p>
          <div class="us-buy"><span class="us-price">??</span><button class="us-btn" disabled>Скоро</button></div>
        </div>
      </article>
    </section>

    <section class="us-how">
      <h2>Де фармити UC</h2>
      <div class="us-steps">
        <div><b>01</b><span>Купуй у Vapors — кожне замовлення качає твій Battle Pass</span></div>
        <div><b>02</b><span>Забирай нагороди рівнів і крути щоденну лотерею</span></div>
        <div><b>03</b><span>Обмінюй UC на мерч — забереш у магазині або отримаєш з наступним замовленням</span></div>
      </div>
    </section>
  </div>

  {# 3D-перегляд предмета #}
  <div class="us-det" id="usDet" hidden>
    <div class="us-det-box">
      <button class="us-x js-us-close" aria-label="Закрити">✕</button>
      <div class="us-det-stage" id="usStage"><div class="us-det-rot" id="usRot"><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" id="usDetArt"></svg><svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.2" class="us-det-ghost" id="usDetGhost"></svg></div><i class="us-plat"></i><span class="us-det-hint">Поводь мишкою або пальцем — покрути</span></div>
      <div class="us-det-i">
        <span class="us-rar" id="usDetRar"></span>
        <h2 id="usDetName"></h2>
        <p id="usDetDesc"></p>
        <div class="us-sizes" id="usDetSizes"></div>
        <div class="us-det-meta" id="usDetMeta"></div>
        <div class="us-buy"><span class="us-price"><svg class="us-uc" viewBox="0 0 32 32"><use href="#ucIcon"/></svg><span id="usDetPrice"></span></span><button class="us-btn us-btn-lg" id="usDetBuy">Обміняти</button></div>
      </div>
    </div>
  </div>

  {# Рулетка кейса #}
  <div class="us-roll" id="usRoll" hidden>
    <div class="us-roll-t">Відкриваємо кейс…</div>
    <div class="us-roll-win"><div class="us-roll-strip" id="usStrip"></div><i class="us-roll-line"></i></div>
  </div>

  {# Предмет отримано #}
  <div class="us-got" id="usGot" hidden>
    <canvas id="usConf"></canvas>
    <div class="us-got-box">
      <div class="us-got-t">ПРЕДМЕТ ОТРИМАНО</div>
      <div class="us-got-art" id="usGotArt"></div>
      <span class="us-rar" id="usGotRar"></span>
      <h2 id="usGotName"></h2>
      <p id="usGotTxt"></p>
      <button class="us-btn us-btn-lg js-us-close">Забрати</button>
    </div>
  </div>

  {# Мої предмети #}
  <aside class="us-inv" id="usInv" hidden>
    <div class="us-inv-box">
      <button class="us-x js-us-close" aria-label="Закрити">✕</button>
      <h2>Мої предмети</h2>
      <div id="usInvList">
      {% if profile and profile.history %}
        {% for h in profile.history %}
        <div class="us-inv-row" data-id="{{ h.item }}"><i class="us-inv-ic"></i><div><b>{{ h.name }}</b><span>№{{ h.order_id }} · {{ h.date_added|slice(0,16) }} · {{ h.status == 'new' ? 'Готуємо до видачі' : h.status }}</span></div><em>−{{ h.price }} UC</em></div>
        {% endfor %}
      {% else %}<p class="us-inv-empty">Поки порожньо. Обміняй перший предмет або відкрий кейс!</p>{% endif %}
      </div>
    </div>
  </aside>

  <div class="us-modal" id="usModal" hidden>
    <div class="us-modal-box"><div class="us-modal-t" id="usMT"></div><div class="us-modal-p" id="usMP"></div><div class="us-modal-a" id="usMA"></div></div>
  </div>
  <template id="usArts">{% for it in items %}<svg data-id="{{ it.id }}">{{ art[it.id]|raw }}</svg>{% endfor %}</template>
</main>

<style>

.us{--bg:#07050d;--pink:#ff2fa0;--cyan:#22e6ff;--violet:#8b5cf6;--gold:#ffc23d;--txt:#efeaff;position:relative;overflow:hidden;background:var(--bg);color:var(--txt);font-family:"Exo 2",Montserrat,Arial,sans-serif;isolation:isolate;margin-top:-1px}
.us *{box-sizing:border-box}
.us-bg{position:absolute;inset:0;z-index:-1;pointer-events:none}
.us-grid{position:absolute;left:-50%;right:-50%;bottom:-10%;height:70%;background-image:linear-gradient(rgba(255,47,160,.35) 1px,transparent 1px),linear-gradient(90deg,rgba(34,230,255,.28) 1px,transparent 1px);background-size:56px 56px;transform:perspective(500px) rotateX(62deg);transform-origin:top;animation:usGrid 6s linear infinite;-webkit-mask-image:linear-gradient(transparent,#000 40%);mask-image:linear-gradient(transparent,#000 40%)}
@keyframes usGrid{to{background-position:0 56px,0 0}}
.us-sun{position:absolute;left:50%;top:6%;width:620px;height:620px;margin-left:-310px;border-radius:50%;background:radial-gradient(circle,rgba(255,47,160,.35),rgba(139,92,246,.15) 45%,transparent 70%);filter:blur(10px)}
.us-scan{position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 3px)}
.us-in{max-width:1200px;margin:0 auto;padding:46px 16px 70px}
.us-hud{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:28px}
.us-kicker{font:700 13px Unbounded,sans-serif;letter-spacing:3px;color:var(--cyan)}
.us h1{position:relative;margin:8px 0 10px;font:900 clamp(34px,6vw,64px)/1 Unbounded,sans-serif;letter-spacing:2px;background:linear-gradient(90deg,#fff,#ffc4e6 40%,var(--pink));-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 30px rgba(255,47,160,.35)}
.us h1::before,.us h1::after{content:attr(data-text);position:absolute;inset:0;background:inherit;-webkit-background-clip:text;background-clip:text;opacity:0}
.us h1::before{color:var(--cyan);-webkit-text-fill-color:var(--cyan);animation:usGlitch 5s infinite steps(1)}
@keyframes usGlitch{0%,92%,100%{opacity:0;transform:none}93%{opacity:.7;transform:translate(-3px,1px);clip-path:inset(20% 0 55% 0)}95%{opacity:.7;transform:translate(3px,-1px);clip-path:inset(60% 0 10% 0)}}
.us-title p{margin:0;max-width:520px;font-size:18px;color:rgba(239,234,255,.72)}
.us-wallet{min-width:260px;padding:16px 20px;border:1px solid rgba(34,230,255,.4);background:linear-gradient(135deg,rgba(34,230,255,.08),rgba(255,47,160,.08));clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);box-shadow:inset 0 0 30px rgba(34,230,255,.12)}
.us-wallet-l{font:700 12px Unbounded,sans-serif;letter-spacing:2px;color:var(--cyan);text-transform:uppercase}
.us-wallet-v{display:flex;align-items:center;gap:10px;margin:6px 0 4px}
.us-wallet-v b{font:900 40px/1 Unbounded,sans-serif;color:#fff;text-shadow:0 0 18px rgba(34,230,255,.7)}
.us-wallet-v span{font:700 16px Unbounded,sans-serif;color:var(--cyan)}
