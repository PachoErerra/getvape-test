<?php

class ControllerCommonFooter extends Controller
{
    public function index()
    {


        $sessionId = $this->session->getId();

        $checkTelegram = false;

        if (!$this->customer->getId()) {
            $checkTelegram = $this->cache->get('sms_link' . $sessionId);
        } elseif ($this->customer->getId() && $this->cache->get('sms_link' . $sessionId)) {
            $this->cache->delete('sms_link' . $sessionId);
        }

        $this->load->language('common/footer');

        $this->load->model('catalog/information');

        $data['informations'] = array();

        foreach ($this->model_catalog_information->getInformations() as $result) {
            if ($result['bottom']) {
                $data['informations'][] = array(
                    'title' => $result['title'],
                    'href' => $this->url->link('information/information', 'information_id=' . $result['information_id'])
                );
            }
        }
        if (isset($this->request->get['login'])) {
            $data['popup'] = true;
        } else {
            $data['popup'] = false;
        }
        $data['contact'] = $this->url->link('information/contact');
        $data['reviews'] = $this->url->link('information/reviews');
        $data['return'] = $this->url->link('account/return/add', '', true);
        $data['sitemap'] = $this->url->link('information/sitemap');
        $data['tracking'] = $this->url->link('information/tracking');
        $data['manufacturer'] = $this->url->link('product/manufacturer');
        $data['voucher'] = $this->url->link('account/voucher', '', true);
        $data['affiliate'] = $this->url->link('affiliate/login', '', true);
        $data['account'] = $this->url->link('account/edit', '', true);
        $data['order'] = $this->url->link('account/order', '', true);
        $data['wishlist'] = $this->url->link('account/wishlist', '', true);
        $data['reward'] = $this->url->link('account/reward', '', true);
        $data['newsletter'] = $this->url->link('account/newsletter', '', true);
        $data['blog'] = $this->url->link('blog/latest', '', true);
        $data['special'] = $this->url->link('product/special', '', true);

        $data['tiktok'] = $this->config->get('config_tiktok');
        $data['instagram'] = $this->config->get('config_instagram');
        $data['youtube'] = $this->config->get('config_youtube');
        $data['telegram'] = $this->config->get('config_telegram');

        $host = isset($this->request->server['HTTPS']) && (($this->request->server['HTTPS'] == 'on') || ($this->request->server['HTTPS'] == '1')) ? HTTPS_SERVER : HTTP_SERVER;
        if ($this->request->server['REQUEST_URI'] == '/') {
            $data['og_url'] = $this->url->link('common/home');
        } else {
            $data['og_url'] = $host . substr($this->request->server['REQUEST_URI'], 1, (strlen($this->request->server['REQUEST_URI']) - 1));
        }

        $data['home'] = $this->url->link('common/home');
        $data['name'] = $this->config->get('config_name');

        $data['logged'] = $this->customer->isLogged();

        if ($this->customer->isLogged()) {
            $this->load->model('account/customer');
            $data['reward_total'] = (int)$this->customer->getRewardPoints();
        } else {
            $data['reward_total'] = 0;
        }

        $this->load->model('catalog/product');
        $data['total_special'] = $this->model_catalog_product->getTotalProductSpecials();

        $data['telephone'] = $this->config->get('config_telephone');

        $data['powered'] = sprintf($this->language->get('text_powered'), $this->config->get('config_name'), date('Y', time()));

        // Whos Online
        if ($this->config->get('config_customer_online')) {
            $this->load->model('tool/online');

            if (isset($this->request->server['REMOTE_ADDR'])) {
                $ip = $this->request->server['REMOTE_ADDR'];
            } else {
                $ip = '';
            }

            if (isset($this->request->server['HTTP_HOST']) && isset($this->request->server['REQUEST_URI'])) {
                $url = ($this->request->server['HTTPS'] ? 'https://' : 'http://') . $this->request->server['HTTP_HOST'] . $this->request->server['REQUEST_URI'];
            } else {
                $url = '';
            }

            if (isset($this->request->server['HTTP_REFERER'])) {
                $referer = $this->request->server['HTTP_REFERER'];
            } else {
                $referer = '';
            }

            $this->model_tool_online->addOnline($ip, $this->customer->getId(), $url, $referer);
        }

        $file = DIR_LOGS . 'cache.header.categories' . (int)$this->config->get('config_language_id');
        $cache_categories = json_decode(file_get_contents($file), true);
//		$cache_categories = $this->cache->get('header.categories' . (int)$this->config->get('config_language_id'));

        if ($cache_categories) {

            $data['categories'] = $cache_categories;
//			$this->cache->set('header.categories' . (int)$this->config->get('config_language_id'), $data['categories']);

        } else {
            $this->load->model('catalog/category');

            $data['categories'] = array();

            $categories = $this->model_catalog_category->getCategories(0);

            foreach ($categories as $key => $category) {
                if ($category['top']) {
                    $filter_data = array(
                        'filter_category_id' => $category['category_id'],
                        'filter_sub_category' => true
                    );

                    //проверка что б не выводить пустые категории
                    $total_products = $this->model_catalog_product->getTotalProducts($filter_data);
                    if ($key == 1) {
                        $data['categories'][] = array(
                            'category_id' => $category['category_id'],
                            'name' => 'Знижки' . ($this->config->get('config_product_count') ? ' <span>(' . $this->model_catalog_product->getTotalProductSpecials() . ')</span>' : ''),
                            //	'children'    => $children_data,
                            //    'image' => $category['image'] ? file_get_contents($this->model_tool_image->resize($category['image'], 16, 17)) : false,
                            'image' => $category['image'] ? $this->model_tool_image->resize($category['image'], 48, 48) : false,
                            'href' => $this->url->link('product/special')
                        );
                    }

                    if ($total_products > 0) {
                        $data['categories'][] = array(
                            'name' => $category['name'] . ($this->config->get('config_product_count') ? ' <span>(' . $this->model_catalog_product->getTotalProducts($filter_data) . ')</span>' : ''),
                            'column' => $category['column'] ? $category['column'] : 1,
                            //	'image' => $category['image'] ? file_get_contents($this->model_tool_image->resize($category['image'], 16, 17)) : false,
                            'image' => $category['image'] ? $this->model_tool_image->resize($category['image'], 48, 48) : false,
                            'href' => $this->url->link('product/category', 'path=' . $category['category_id'])
                        );
                    }
                }
            }
            //           $this->cache->set('footer.categories' . (int)$this->config->get('config_language_id'), $data['categories']);

        }
		$data['popup_show'] = false;
	//	if ($_SERVER["REMOTE_ADDR"] == '212.15.146.47'){
			if ($this->request->server['HTTPS']) {
				$server = $this->config->get('config_ssl');
			} else {
				$server = $this->config->get('config_url');
			}
			
			if (is_file(DIR_IMAGE . $this->config->get('config_popup_image'))) {
				$data['popup_image'] = $server . 'image/' . $this->config->get('config_popup_image');
			} else {
				$data['popup_image'] = false;
			}
			
			$data['popup_url'] = $this->config->get('config_popup_url');
			
			if (!isset($this->request->cookie['popup_show'])) {
				$data['popup_show'] = true;
			}
			
			if (isset($this->request->get['route']) && $this->request->get['route'] == 'checkout/simplecheckout') {
				$data['popup_show'] = false;
			}
	//	}
	
		if (isset($this->session->data['coupon']) && (isset($this->session->data['coupon_gift']) || isset($this->session->data['coupon_gift_addmore'])) && isset($this->session->data['noski'])) {
			$data['active_sock'] = true;
		} else {
			$data['active_sock'] = false;
		}
		
		$data['regsms'] = $this->load->controller('extension/module/regsms');
		$data['battlepass'] = $this->load->controller('extension/module/battlepass');

        $data['scripts'] = $this->document->getScripts('footer');
        $data['styles'] = $this->document->getStyles('footer');
        $data['super_button_link'] = $this->config->get('config_super_button_link');
        $data['super_button_text'] = $this->config->get('config_super_button_text');
        $data['check_telegram'] = $checkTelegram;
        $data['session_id'] = $this->session->getId();
        $data['sprite_version'] = $this->registry->get('sprite_version');
        $data['cart_total'] = $this->cart->countProducts();
        $data['current_route'] = $_GET['route'] ?? '';

        return $this->load->view('common/footer', $data);
    }
}
